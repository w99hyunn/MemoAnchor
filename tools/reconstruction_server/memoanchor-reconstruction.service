[Unit]
Description=MemoAnchor Open3D Reconstruction Worker
After=network.target memoanchor.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/MemoAnchorReconstruction
ExecStart=/home/ubuntu/MemoAnchorReconstruction/tools/reconstruction/.venv/bin/python /home/ubuntu/MemoAnchorReconstruction/tools/reconstruction_server/server.py --host 127.0.0.1 --port 8765
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
