using UnityEngine;
using System;
using System.IO;

/// <summary>
/// Android 녹음 기능을 구현하는 클래스
/// Unity Microphone API를 사용하여 녹음하고 WAV 파일로 저장
/// </summary>
public class VoiceRecorder : MonoBehaviour
{
    [Header("Recording Settings")]
    [Tooltip("녹음 샘플링 레이트 (Hz)")]
    [SerializeField] private int sampleRate = 44100;
    
    [Tooltip("최대 녹음 시간 (초)")]
    [SerializeField] private int maxRecordTime = 300; // 5분
    
    [Header("File Settings")]
    [Tooltip("녹음 파일이 저장될 폴더 이름")]
    [SerializeField] private string recordingFolderName = "VoiceRecordings";
    
    // 녹음 상태
    private bool isRecording = false;
    private AudioClip recordedClip;
    private string deviceName;
    private string currentRecordingPath;
    
    // 이벤트
    public event Action<string> OnRecordingCompleted; // 녹음 완료 시 파일 경로 전달
    public event Action<float> OnRecordingProgress; // 녹음 진행 상황 (0~1)
    
    public bool IsRecording => isRecording;
    public string CurrentRecordingPath => currentRecordingPath;
    
    void Start()
    {
        // 마이크 권한 요청 (Android)
        #if UNITY_ANDROID && !UNITY_EDITOR
        if (!Permission.HasUserAuthorizedPermission(Permission.Microphone))
        {
            Permission.RequestUserPermission(Permission.Microphone);
        }
        #endif
        
        // 녹음 폴더 생성
        string folderPath = GetRecordingFolderPath();
        if (!Directory.Exists(folderPath))
        {
            Directory.CreateDirectory(folderPath);
            Debug.Log($"[VoiceRecorder] 녹음 폴더 생성: {folderPath}");
        }
    }
    
    /// <summary>
    /// 녹음 시작
    /// </summary>
    public void StartRecording()
    {
        if (isRecording)
        {
            Debug.LogWarning("[VoiceRecorder] 이미 녹음 중입니다!");
            return;
        }
        
        // Android 마이크 권한 확인
        #if UNITY_ANDROID && !UNITY_EDITOR
        if (!Permission.HasUserAuthorizedPermission(Permission.Microphone))
        {
            Debug.LogError("[VoiceRecorder] 마이크 권한이 없습니다!");
            Permission.RequestUserPermission(Permission.Microphone);
            return;
        }
        #endif
        
        // 사용 가능한 마이크 디바이스 확인
        if (Microphone.devices.Length == 0)
        {
            Debug.LogError("[VoiceRecorder] 사용 가능한 마이크가 없습니다!");
            return;
        }
        
        // 첫 번째 마이크 디바이스 사용
        deviceName = Microphone.devices[0];
        Debug.Log($"[VoiceRecorder] 녹음 시작: 디바이스={deviceName}, 샘플레이트={sampleRate}Hz");
        
        // 녹음 시작
        recordedClip = Microphone.Start(deviceName, false, maxRecordTime, sampleRate);
        isRecording = true;
        
        // 녹음 진행 상황 모니터링 시작
        StartCoroutine(MonitorRecording());
    }
    
    /// <summary>
    /// 녹음 중지 및 저장
    /// </summary>
    public string StopRecording()
    {
        if (!isRecording)
        {
            Debug.LogWarning("[VoiceRecorder] 녹음 중이 아닙니다!");
            return null;
        }
        
        // 녹음 중지
        int lastSample = Microphone.GetPosition(deviceName);
        Microphone.End(deviceName);
        isRecording = false;
        
        Debug.Log($"[VoiceRecorder] 녹음 중지: 마지막 샘플 위치={lastSample}");
        
        // 녹음된 데이터가 없으면 null 반환
        if (lastSample == 0 || recordedClip == null)
        {
            Debug.LogWarning("[VoiceRecorder] 녹음된 데이터가 없습니다!");
            return null;
        }
        
        // 실제 녹음된 부분만 추출
        AudioClip trimmedClip = TrimAudioClip(recordedClip, lastSample);
        
        // WAV 파일로 저장
        string filePath = SaveAsWav(trimmedClip);
        
        if (!string.IsNullOrEmpty(filePath))
        {
            currentRecordingPath = filePath;
            Debug.Log($"[VoiceRecorder] 녹음 완료: {filePath}");
            
            // 녹음 완료 이벤트 발생
            OnRecordingCompleted?.Invoke(filePath);
            
            return filePath;
        }
        
        return null;
    }
    
    /// <summary>
    /// 녹음 취소
    /// </summary>
    public void CancelRecording()
    {
        if (isRecording)
        {
            Microphone.End(deviceName);
            isRecording = false;
            recordedClip = null;
            Debug.Log("[VoiceRecorder] 녹음 취소됨");
        }
    }
    
    /// <summary>
    /// 녹음 진행 상황 모니터링
    /// </summary>
    private System.Collections.IEnumerator MonitorRecording()
    {
        while (isRecording)
        {
            int currentSample = Microphone.GetPosition(deviceName);
            float progress = (float)currentSample / (sampleRate * maxRecordTime);
            OnRecordingProgress?.Invoke(progress);
            
            yield return new WaitForSeconds(0.1f);
        }
    }
    
    /// <summary>
    /// AudioClip을 실제 녹음된 길이로 자르기
    /// </summary>
    private AudioClip TrimAudioClip(AudioClip clip, int samples)
    {
        float[] data = new float[samples * clip.channels];
        clip.GetData(data, 0);
        
        AudioClip trimmedClip = AudioClip.Create(
            "TrimmedRecording",
            samples,
            clip.channels,
            clip.frequency,
            false
        );
        
        trimmedClip.SetData(data, 0);
        return trimmedClip;
    }
    
    /// <summary>
    /// AudioClip을 WAV 파일로 저장
    /// </summary>
    private string SaveAsWav(AudioClip clip)
    {
        if (clip == null)
        {
            Debug.LogError("[VoiceRecorder] 저장할 AudioClip이 null입니다!");
            return null;
        }
        
        // 파일명 생성 (타임스탬프 사용)
        string timestamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");
        string fileName = $"voice_recording_{timestamp}.wav";
        string filePath = Path.Combine(GetRecordingFolderPath(), fileName);
        
        try
        {
            // WAV 파일로 변환 및 저장
            byte[] wavData = ConvertAudioClipToWav(clip);
            File.WriteAllBytes(filePath, wavData);
            
            Debug.Log($"[VoiceRecorder] WAV 파일 저장 성공: {filePath} (크기: {wavData.Length} bytes)");
            return filePath;
        }
        catch (Exception e)
        {
            Debug.LogError($"[VoiceRecorder] WAV 파일 저장 실패: {e.Message}");
            return null;
        }
    }
    
    /// <summary>
    /// AudioClip을 WAV 형식의 byte 배열로 변환
    /// </summary>
    private byte[] ConvertAudioClipToWav(AudioClip clip)
    {
        float[] samples = new float[clip.samples * clip.channels];
        clip.GetData(samples, 0);
        
        Int16[] intData = new Int16[samples.Length];
        Byte[] bytesData = new Byte[samples.Length * 2];
        
        // float 샘플을 Int16으로 변환
        int rescaleFactor = 32767; // Int16.MaxValue
        for (int i = 0; i < samples.Length; i++)
        {
            intData[i] = (short)(samples[i] * rescaleFactor);
            Byte[] byteArr = BitConverter.GetBytes(intData[i]);
            byteArr.CopyTo(bytesData, i * 2);
        }
        
        // WAV 헤더 생성
        int frequency = clip.frequency;
        int channels = clip.channels;
        
        using (MemoryStream stream = new MemoryStream())
        {
            using (BinaryWriter writer = new BinaryWriter(stream))
            {
                // RIFF 헤더
                writer.Write(System.Text.Encoding.ASCII.GetBytes("RIFF"));
                writer.Write(36 + bytesData.Length);
                writer.Write(System.Text.Encoding.ASCII.GetBytes("WAVE"));
                
                // fmt 청크
                writer.Write(System.Text.Encoding.ASCII.GetBytes("fmt "));
                writer.Write(16);
                writer.Write((ushort)1); // PCM
                writer.Write((ushort)channels);
                writer.Write(frequency);
                writer.Write(frequency * channels * 2); // byte rate
                writer.Write((ushort)(channels * 2)); // block align
                writer.Write((ushort)16); // bits per sample
                
                // data 청크
                writer.Write(System.Text.Encoding.ASCII.GetBytes("data"));
                writer.Write(bytesData.Length);
                writer.Write(bytesData);
            }
            
            return stream.ToArray();
        }
    }
    
    /// <summary>
    /// 녹음 파일이 저장될 폴더 경로 반환
    /// </summary>
    private string GetRecordingFolderPath()
    {
        return Path.Combine(Application.persistentDataPath, recordingFolderName);
    }
    
    /// <summary>
    /// 녹음 파일 삭제
    /// </summary>
    public bool DeleteRecording(string filePath)
    {
        if (string.IsNullOrEmpty(filePath) || !File.Exists(filePath))
        {
            Debug.LogWarning($"[VoiceRecorder] 삭제할 파일이 존재하지 않습니다: {filePath}");
            return false;
        }
        
        try
        {
            File.Delete(filePath);
            Debug.Log($"[VoiceRecorder] 녹음 파일 삭제: {filePath}");
            return true;
        }
        catch (Exception e)
        {
            Debug.LogError($"[VoiceRecorder] 파일 삭제 실패: {e.Message}");
            return false;
        }
    }
    
    /// <summary>
    /// 현재 녹음 시간 반환 (초)
    /// </summary>
    public float GetRecordingTime()
    {
        if (!isRecording || string.IsNullOrEmpty(deviceName))
            return 0f;
        
        int position = Microphone.GetPosition(deviceName);
        return (float)position / sampleRate;
    }
    
    void OnDestroy()
    {
        // 녹음 중이면 중지
        if (isRecording)
        {
            CancelRecording();
        }
    }
}
