}

.map-participants-title,
.map-participants-summary {
    height: 82px;
    padding-left: 24px;
    padding-right: 24px;
    border-radius: 20px;
    background-color: rgb(224, 224, 224);
    color: rgb(78, 78, 78);
    font-size: 34px;
    -unity-text-align: middle-left;
}

.map-participants-title {
    margin-right: 10px;
}

.map-participants-summary {
    max-width: 760px;
    overflow: hidden;
    flex-direction: row;
    align-items: center;
}

.map-participants-manager-summary,
.map-participants-repairer-summary {
    color: rgb(78, 78, 78);
    font-size: 34px;
    white-space: nowrap;
}

.map-participants-manager-summary {
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.map-participants-button:hover:enabled .map-participants-title,
.map-participants-button:hover:enabled .map-participants-summary {
    background-color: rgb(213, 213, 213);
}

.map-participants-button.is-read-only .map-participants-summary,
.map-participants-button.is-read-only:hover:enabled .map-participants-summary {
    padding-left: 0;
    padding-right: 0;
    background-color: rgba(0, 0, 0, 0);
}

.map-participants-button.is-hidden,
.map-scan-time-label.is-hidden {
