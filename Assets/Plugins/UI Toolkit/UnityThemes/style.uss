:root {
    --nav-bg: rgb(30, 30, 34);
    --nav-icon-inactive: rgb(243, 243, 244);
    --brand-pink: rgb(161, 31, 63);
    --brand-pink-hover: rgb(143, 27, 56);
    --brand-pink-active: rgb(126, 24, 49);
    --nav-icon-active: var(--brand-pink);
    --nav-bar-radius: 84px;
}

.unity-label {
    padding: 0;
    margin: 0;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
    color: rgb(28, 28, 28);
}

.unity-button {
    background-color: transparent;
    border-color: transparent;
    border-width: 0;
    padding: 0;
    margin: 0;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
}

.unity-button:hover:enabled {
    background-color: transparent;
    border-color: transparent;
}

.unity-button:active:enabled {
    background-color: transparent;
    border-color: transparent;
}

.unity-button:focus {
    border-left-color: transparent;
    border-right-color: transparent;
    border-top-color: transparent;
    border-bottom-color: transparent;
}

.unity-button:focus:enabled {
    border-left-color: transparent;
    border-right-color: transparent;
    border-top-color: transparent;
    border-bottom-color: transparent;
}

.common-icon-button {
    width: 88px;
    height: 88px;
    border-width: 0;
    border-radius: 999px;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    transition-property: background-color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.common-icon-button:hover:enabled {
    background-color: rgba(0, 0, 0, 0.14);
    border-color: transparent;
}

.common-icon-button:active:enabled {
    background-color: rgba(0, 0, 0, 0.22);
    border-color: transparent;
}

.common-icon-button-icon {
    width: 50px;
    height: 50px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(42, 42, 42);
    picking-mode: ignore;
}

.splash-root {
    flex-grow: 1;
    justify-content: center;
    background-color: var(--brand-pink);
}

.splash-brand {
    position: absolute;
    left: 0;
    right: 0;
    top: 500px;
    align-items: center;
}

.splash-symbol {
    width: 300px;
    height: 250px;
    margin-bottom: 34px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/system/icon_white.png?fileID=2800000&guid=a90bf743c20b64942a4a68d0465a7c3e&type=3#icon_white");
    -unity-background-scale-mode: scale-to-fit;
}

.splash-logo {
    width: 680px;
    height: 220px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/logo.png?fileID=2800000&guid=a402c67bcb520e24fa718d51047c61ed&type=3#logo");
    -unity-background-scale-mode: scale-to-fit;
}

.splash-tagline {
    margin-top: 30px;
    color: rgb(255, 255, 255);
    font-size: 52px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
}

.splash-panel {
    position: absolute;
    left: 110px;
    right: 110px;
    bottom: 220px;
    display: flex;
}

.splash-signup-panel {
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(246, 246, 246);
}

.splash-signup-panel .home-header {
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
}

.splash-signup-description {
    margin-top: 12px;
    font-size: 34px;
    color: rgb(135, 135, 135);
}

.splash-signup-bottom-bar {
    position: absolute;
    left: 60px;
    right: 60px;
    bottom: 60px;
    height: 200px;
    flex-direction: row;
    align-items: center;
}

.splash-login-button-kakao:hover:enabled {
    background-color: rgb(246, 220, 0);
}

.splash-signup-status {
    min-height: 42px;
    margin-top: 44px;
    color: rgb(87, 87, 87);
    font-size: 34px;
}

.main-root {
    flex-grow: 1;
    position: relative;
    background-color: rgb(246, 246, 246);
}

.tab-viewport {
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    transition-property: filter;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.tab-strip {
    flex-direction: row;
    position: relative;
    left: 0;
    height: 100%;
    transition-property: left;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
    width: 500%;
}

.tab-page {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
    flex-grow: 0;
    min-height: 0;
    display: flex;
}

.tab-page-layout {
    height: 100%;
    flex-direction: column;
    min-height: 0;
    padding-right: 50px;
    padding-left: 50px;
    padding-top: 175px;
    padding-bottom: 0;
}

.tab-fixed-header {
    flex-grow: 0;
    flex-shrink: 0;
}

.tab-content-scroll {
    flex-grow: 1;
    min-height: 0;
}

.tab-content-scroll .unity-scroll-view__content-container {
    align-items: stretch;
}

.tab-content-inner {
    flex-grow: 0;
    padding-bottom: 300px;
}

#memo-content-scroll .unity-scroll-view__content-container {
    flex-grow: 1;
}

#memo-trash-scroll .unity-scroll-view__content-container {
    flex-grow: 1;
}

.tab-content-inner.is-memo-list-empty {
    flex-grow: 1;
    padding-bottom: 0;
}

#home-content-scroll {
    margin-left: -50px;
    margin-right: -50px;
}

#home-content-scroll .unity-scroll-view__content-container {
    padding-left: 0;
    padding-right: 0;
}

#home-content-scroll .memo-section {
    margin-left: 0;
    margin-right: 0;
}

#memo-content-scroll {
    margin-left: -50px;
    margin-right: -50px;
}

#memo-content-scroll .unity-scroll-view__content-container {
    padding-left: 0;
    padding-right: 0;
}

#memo-content-scroll .memo-section {
    margin-left: 0;
    margin-right: 0;
}

.memo-tab-mode-page {
    background-color: rgb(86, 99, 142);
}

.memo-tab-mode-page.is-admin-mode {
    background-color: var(--brand-pink);
}

.memo-mode-title-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    min-width: 0;
}

.memo-mode-title {
    color: rgb(255, 255, 255);
    margin-right: 28px;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    -unity-text-overflow-position: end;
    picking-mode: ignore;
}

.memo-header-actions {
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}

.home-header {
    flex-grow: 0;
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 70px;
}

.home-greeting {
    font-size: 60px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.page-header-title {
    font-size: 50px;
    color: rgb(28, 28, 28);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.home-right-icon-button {
    margin-left: 50px;
}

.memo-header-icon-button {
    margin-left: 50px;
}

.memo-tab-mode-page .memo-header-icon-button .common-icon-button-icon {
    -unity-background-image-tint-color: rgb(245, 245, 245);
}

.memo-filter-icon-button {
    margin-left: 24px;
}

.memo-section {
    flex-grow: 1;
    width: auto;
    min-width: 0;
    align-self: stretch;
    position: relative;
    margin-left: -50px;
    margin-right: -50px;
    background-color: var(--nav-bg);
    padding-top: 100px;
    padding-bottom: 100px;
}

#mode-back {
    background-color: rgb(86, 99, 142);
}

#mode-back.is-admin-mode {
    background-color: var(--brand-pink);
}

.memo-section-content {
    flex-grow: 1;
}

.memo-section-header {
    flex-grow: 0;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
    padding-right: 50px;
    padding-left: 50px;
}

.home-mode-title-row {
    flex-direction: row;
    align-items: center;
}

.home-mode-title {
    color: rgb(255, 255, 255);
    margin-right: 28px;
}

.home-mode-toggle {
    width: 160px;
    height: 76px;
    border-radius: 38px;
    background-color: rgb(234, 236, 239);
    padding-top: 6px;
    padding-right: 6px;
    padding-bottom: 6px;
    padding-left: 6px;
    justify-content: center;
    border-width: 0;
    flex-shrink: 0;
}

.home-mode-toggle:hover:enabled,
.home-mode-toggle:active:enabled {
    background-color: rgb(234, 236, 239);
}

.home-mode-toggle-thumb {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    background-color: var(--brand-pink);
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/admin.png?fileID=2800000&guid=5b0fcf6366924744cb2f0df276925867&type=3#admin");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    align-self: flex-start;
    transition-property: translate, background-color;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
    background-size: 60% 60%;
}

.home-mode-toggle.is-work-mode .home-mode-toggle-thumb {
    translate: 84px 0;
    background-color: rgb(86, 99, 142);
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/user.png?fileID=2800000&guid=3a95cf702d6e3e64ca7c035145fdacfd&type=3#user");
}

.memo-section-title {
    font-size: 50px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
}

.memo-section-more {
    font-size: 35px;
    color: rgb(233, 233, 233);
}

.memo-scroll {
    flex-grow: 1;
    height: 700px;
}

.memo-scroll-content {
    flex-direction: row;
    padding-left: 50px;
    padding-right: 40px;
}

.memo-card {
    width: 900px;
    min-width: 760px;
    height: 700px;
    background-color: rgb(255, 255, 255);
    border-top-left-radius: 80px;
    border-top-right-radius: 80px;
    border-bottom-left-radius: 80px;
    border-bottom-right-radius: 80px;
    padding: 28px;
    margin-right: 40px;
    padding-top: 60px;
    padding-right: 60px;
    padding-bottom: 60px;
    padding-left: 60px;
}

.memo-title {
    font-size: 45px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
    margin-bottom: 25px;
}

.memo-divider {
    height: 2px;
    background-color: rgb(207, 207, 207);
    margin-bottom: 30px;
}

.memo-check-row {
    height: 120px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgb(239, 239, 239);
    border-top-left-radius: 45px;
    border-top-right-radius: 45px;
    border-bottom-left-radius: 45px;
    border-bottom-right-radius: 45px;
    padding-left: 40px;
    padding-right: 40px;
    margin-bottom: 12px;
}

.memo-check-text {
    font-size: 40px;
    color: rgb(44, 44, 44);
}

.memo-check-toggle {
    margin: 0;
    padding: 0;
}

.memo-check-toggle .unity-toggle__label {
    display: none;
}

.memo-check-toggle .unity-toggle__input {
    width: 64px;
    height: 64px;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: 0;
    border-radius: 10px;
    background-color: rgb(210, 210, 210);
    background-image: none;
    transition-property: background-color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.memo-check-toggle .unity-toggle__input:hover {
    background-color: rgb(190, 190, 190);
}

.memo-check-toggle .unity-toggle__input:active {
    background-color: rgb(170, 170, 170);
}

.memo-check-toggle:checked .unity-toggle__input {
    background-color: rgb(90, 90, 90);
    background-image: none;
}

.memo-check-toggle:checked .unity-toggle__input:hover {
    background-color: rgb(76, 76, 76);
}

.memo-check-toggle:checked .unity-toggle__input:active {
    background-color: rgb(60, 60, 60);
}

.memo-check-toggle .unity-toggle__checkmark {
    width: 42px;
    height: 42px;
    margin: 0;
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    opacity: 0;
}

.memo-check-toggle:checked .unity-toggle__checkmark {
    opacity: 1;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/check.png?fileID=2800000&guid=cc44cf71ac7687d4c82692e2f8ff010c&type=3#check");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.memo-footer {
    flex-grow: 1;
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
}

.memo-footer-text {
    font-size: 35px;
    color: rgb(135, 135, 135);
}

.memo-footer-date {
    margin-left: auto;
}

.map-tab-page {
    background-color: rgb(244, 244, 244);
}

.map-top-bar {
    position: relative;
    margin-bottom: 0;
}

.map-title-group {
    width: 100%;
    flex-direction: row;
    align-items: center;
    min-width: 0;
}

.map-current-address-label {
    margin-left: 30px;
    font-size: 40px;
    color: rgb(84, 84, 84);
    -unity-text-align: lower-left;
}

.map-list-button {
    background-image: none;
}

.map-list-button .common-icon-button-icon {
    width: 58px;
    height: 58px;
}

.map-read-mode-label {
    height: 150px;
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    font-size: 38px;
    color: rgb(96, 96, 96);
    -unity-text-align: middle-left;
}

.map-read-mode-label.is-hidden,
.map-scan-time-label.is-hidden {
    visibility: hidden;
}

.map-preview {
    flex-grow: 1;
    min-height: 0;
    position: relative;
    margin-left: -50px;
    margin-right: -50px;
    background-color: rgb(172, 172, 172);
    overflow: hidden;
}

.map-preview.is-empty {
    background-color: rgb(226, 226, 226);
}

.map-preview-menu-button {
    position: absolute;
    top: 24px;
    right: 40px;
    width: 70px;
    height: 70px;
    font-size: 44px;
    color: rgb(66, 66, 66);
    -unity-text-align: middle-center;
}

.map-create-memo-actions {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 360px;
    margin-left: -180px;
    margin-top: -116px;
}

.map-create-memo-actions.is-hidden {
    display: none;
}

.map-create-memo-button {
    width: 360px;
    height: 96px;
    margin-bottom: 40px;
    border-radius: 48px;
    background-color: rgb(30, 30, 34);
    color: rgb(255, 255, 255);
    font-size: 34px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.map-create-memo-button:hover:enabled {
    background-color: rgb(50, 50, 55);
}

.map-create-memo-button:active:enabled {
    background-color: rgb(16, 16, 20);
}

.map-scan-time-label {
    position: absolute;
    right: 40px;
    bottom: 28px;
    font-size: 28px;
    color: rgb(91, 91, 91);
}

.map-empty-state {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.map-empty-state.is-hidden {
    display: none;
}

.map-empty-title {
    font-size: 45px;
    color: rgb(18, 18, 18);
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.map-empty-subtitle {
    margin-top: 22px;
    font-size: 35px;
    color: rgb(166, 166, 166);
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
}

.scan-map-scroll-content {
    flex-direction: row;
    padding-left: 50px;
    padding-right: 40px;
}

.scan-map-card {
    width: 760px;
    min-width: 760px;
    height: 900px;
    margin-right: 32px;
    border-radius: 28px;
    background-color: rgb(132, 132, 132);
    overflow: hidden;
    border-top-left-radius: 80px;
    border-top-right-radius: 80px;
    border-bottom-right-radius: 80px;
    border-bottom-left-radius: 80px;
}

.scan-map-thumbnail {
    flex-grow: 1;
}

.scan-map-info {
    flex-grow: 0;
    padding-top: 60px;
    padding-right: 60px;
    padding-bottom: 60px;
    padding-left: 60px;
}

.scan-map-title {
    font-size: 42px;
    color: rgb(245, 245, 245);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
}

.scan-map-subtitle {
    margin-top: 8px;
    font-size: 30px;
    color: rgba(245, 245, 245, 0.88);
}

.bottom-nav-wrapper {
    position: absolute;
    left: 60px;
    right: 60px;
    bottom: 60px;
    height: 200px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    transition-duration: 0.26s;
    transition-timing-function: ease-out;
    transition-property: justify-content, filter;
}

.bottom-nav {
    width: 100%;
    height: 100%;
    flex-direction: row;
    position: absolute;
    left: 0;
    right: 0;
    overflow: hidden;
    align-items: center;
    justify-content: space-around;
    background-color: var(--nav-bg);
    border-radius: var(--nav-bar-radius);
    padding-left: 18px;
    padding-right: 18px;
    transition-duration: 0.28s;
    transition-timing-function: ease-out;
    transition-property: left, right, width, height, border-radius, padding-left, padding-right;
}

.nav-item {
    width: 130px;
    height: 130px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-radius: 28px;
    background-color: rgba(0, 0, 0, 0);
    position: relative;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    -unity-font-style: normal;
    padding-top: 0;
    padding-bottom: 0;
    transition-duration: 0.26s;
    transition-timing-function: ease-out;
    transition-property: opacity, translate;
}

.scan-start-bg {
    position: absolute;
    left: auto;
    right: 14px;
    top: 0;
    width: 0;
    height: 200px;
    border-radius: var(--nav-bar-radius);
    background-color: var(--nav-bg);
    opacity: 0;
    overflow: hidden;
    translate: 24px 0;
    transition-duration: 0.28s;
    transition-timing-function: ease-out;
    transition-property: width, height, border-radius, opacity, translate;
    transition-delay: 0s;
    visibility: hidden;
}

.scan-nav-start {
    position: absolute;
    left: 20px;
    right: 20px;
    top: 20px;
    bottom: 20px;
    width: auto;
    height: auto;
    border-radius: 70px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-color: var(--brand-pink);
    opacity: 0;
    justify-content: center;
    align-items: center;
    translate: 16px 0;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
    transition-property: background-color, opacity, translate;
    transition-delay: 0.06s;
    visibility: hidden;
    border-top-left-radius: 60px;
    border-top-right-radius: 60px;
    border-bottom-right-radius: 60px;
    border-bottom-left-radius: 60px;
    color: rgb(255, 255, 255);
    font-size: 44px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.scan-nav-start:hover:enabled {
    background-color: var(--brand-pink-hover);
}

.scan-nav-start:active:enabled {
    background-color: var(--brand-pink-active);
}

.scan-nav-start.is-disabled {
    background-color: rgb(170, 130, 140);
    color: rgb(255, 255, 255);
}

.scan-nav-start.is-disabled:hover:enabled,
.scan-nav-start.is-disabled:active:enabled {
    background-color: rgb(170, 130, 140);
}

.bottom-nav.is-scan-mode #nav-home,
.bottom-nav.is-scan-mode #nav-menu,
.bottom-nav.is-scan-mode #nav-map,
.bottom-nav.is-scan-mode #nav-profile {
    opacity: 0;
    translate: 0 22px;
    position: absolute;
    visibility: hidden;
}

.bottom-nav-wrapper.is-scan-mode {
    justify-content: flex-start;
}

.bottom-nav-wrapper.is-scan-mode .bottom-nav {
    left: 0;
    right: auto;
    width: 164px;
    top: 0;
    height: 164px;
    border-radius: 82px;
    justify-content: center;
    padding-left: 0;
    padding-right: 0;
}

#nav-scan {
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
    transition-property: width, height, border-radius, background-color, margin-left;
}

.bottom-nav.is-scan-mode #nav-scan {
    width: 132px;
    height: 132px;
    border-radius: 66px;
    background-color: rgb(24, 24, 28);
    margin-left: 0;
    margin-right: 0;
    justify-content: center;
    align-items: center;
    padding-top: 0;
    padding-bottom: 0;
}

.bottom-nav.is-scan-mode #nav-scan .nav-icon {
    -unity-background-image-tint-color: rgb(255, 53, 87);
}

.bottom-nav-wrapper.is-scan-mode .scan-start-bg {
    left: 188px;
    right: 14px;
    top: 0;
    height: 164px;
    border-radius: 82px;
    width: auto;
    opacity: 1;
    translate: 0 0;
    visibility: visible;
}

.bottom-nav-wrapper.is-scan-mode .scan-start-bg .scan-nav-start {
    opacity: 1;
    translate: 0 0;
    visibility: visible;
}

.bottom-nav-wrapper.is-memo-filter-mode .bottom-nav,
.bottom-nav-wrapper.is-memo-detail-mode .bottom-nav,
.bottom-nav-wrapper.is-memo-create-mode .bottom-nav,
.bottom-nav-wrapper.is-memo-trash-mode .bottom-nav {
    display: none;
}

.nav-press-bg {
    position: absolute;
    left: -10px;
    right: -10px;
    top: -10px;
    bottom: -10px;
    border-radius: 24px;
    background-color: rgba(42, 42, 47, 0);
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
    border-top-left-radius: 50px;
    border-top-right-radius: 50px;
    border-bottom-right-radius: 50px;
    border-bottom-left-radius: 50px;
}

.nav-item:hover {
    background-color: rgba(0, 0, 0, 0);
    transition-duration: 0.16s;
}

.nav-item:active {
    background-color: rgba(0, 0, 0, 0);
    transition-duration: 0.12s;
}

.nav-item:hover .nav-press-bg {
    background-color: rgba(44, 44, 50, 0.68);
}

.nav-item:active .nav-press-bg {
    background-color: rgba(54, 54, 60, 0.82);
}

.nav-item.is-tapping-down {
    background-color: rgba(0, 0, 0, 0);
}

.nav-item.is-tapping-down .nav-press-bg {
    top: 16px;
    bottom: 4px;
    left: 12px;
    right: 12px;
    border-radius: 36px;
    background-color: rgba(50, 50, 56, 0.95);
}

.nav-item > .nav-icon {
    position: relative;
    top: 0;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

.nav-item.is-tapping-down > .nav-icon {
    top: 2px;
}

.nav-icon {
    width: 52px;
    height: 52px;
    background-position: center;
    background-repeat: no-repeat;
    background-size: contain;
    -unity-background-image-tint-color: var(--nav-icon-inactive);
}

.nav-label {
    display: none;
    font-size: 30px;
    color: var(--nav-icon-inactive);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
    margin-top: 20px;
}

.nav-item.is-active .nav-icon {
    -unity-background-image-tint-color: var(--nav-icon-active);
    transition-duration: 0.18s;
}

.fade-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
}

.memo-search-input {
    font-size: 50px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
