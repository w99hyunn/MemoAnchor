}

.map-reconstruction-preview {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.map-reconstruction-memo-overlay,
.map-reconstruction-memo-markers {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.map-reconstruction-memo-marker {
    position: absolute;
    width: 64px;
    height: 77px;
    margin-left: -32px;
    margin-top: -77px;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/map_view_memo.png?fileID=2800000&guid=e6ab136ea6706684dba43034af755e4d&type=3#map_view_memo");
