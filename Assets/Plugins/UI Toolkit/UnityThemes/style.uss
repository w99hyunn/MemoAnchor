.memo-search-page {
    background-color: rgb(255, 255, 255);
    padding-left: 60px;
    padding-right: 60px;
}

.memo-search-header {
    height: 110px;
    border-bottom-width: 0;
    justify-content: flex-start;
}

.memo-search-header .memo-filter-back-button {
    position: relative;
    left: 0;
    width: 65px;
    height: 65px;
    margin-right: 22px;
    flex-shrink: 0;
}

.memo-search-header .memo-filter-back-icon {
    width: 42px;
    height: 42px;
}

.memo-search-page .memo-search-input-box {
    flex-grow: 1;
    height: 110px;
    border-radius: 55px;
    background-color: rgb(246, 246, 246);
    margin-left: 0;
    padding-left: 38px;
    padding-right: 38px;
}

.memo-search-history-section {
    padding-top: 92px;
    padding-bottom: 0;
}

.memo-search-history-row {
    height: 86px;
    flex-direction: row;
    align-items: center;
}

.memo-search-history-content {
    flex-grow: 1;
    min-width: 0;
    height: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-left: 18px;
    padding-right: 18px;
    border-radius: 28px;
}

.memo-search-history-content:hover:enabled {
    background-color: rgb(248, 248, 248);
    border-color: transparent;
}

.memo-search-history-content:active:enabled {
    background-color: rgb(236, 236, 236);
    border-color: transparent;
}

.memo-search-history-icon {
    width: 38px;
    height: 38px;
    margin-right: 26px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/tabler_clock.png?fileID=2800000&guid=9f748a7700dd0f74da95ba8e51f28b73&type=3#tabler_clock");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(124, 124, 124);
}

.memo-search-history-query {
    flex-grow: 1;
    min-width: 0;
    font-size: 42px;
    color: rgb(28, 28, 28);
    -unity-text-align: middle-left;
    overflow: hidden;
    -unity-text-overflow-position: end;
}

.memo-search-history-date {
    width: 105px;
    font-size: 32px;
    color: rgb(178, 178, 178);
    -unity-text-align: middle-right;
}

.memo-search-history-remove {
    width: 76px;
    height: 76px;
    margin-left: 18px;
    border-radius: 38px;
    align-items: center;
    justify-content: center;
}

.memo-search-history-remove:hover:enabled {
    background-color: rgb(248, 248, 248);
    border-color: transparent;
}

.memo-search-history-remove:active:enabled {
    background-color: rgb(236, 236, 236);
    border-color: transparent;
}

.memo-search-history-remove-icon {
    width: 50px;
    height: 50px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/xbutton.png?fileID=2800000&guid=ec503318264761140bef84a89627b643&type=3#xbutton");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(118, 118, 118);
}

.memo-search-empty-label {
    margin-top: 4px;
    font-size: 34px;
    color: rgb(168, 168, 168);
}

.memo-search-empty-label.is-hidden {
    display: none;
}

.splash-action-button {
    width: 100%;
    flex-grow: 0;
    margin-left: 0;
    margin-right: 0;
}

.splash-action-button.splash-login-button-kakao {
    background-color: rgb(254, 229, 0);
    color: rgb(25, 22, 0);
}

.scan-step-title {
    margin-top: 50px;
    font-size: 60px;
    color: rgb(68, 68, 68);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
}

.scan-field-group {
    margin-top: 60px;
}

.scan-field-label {
    margin-bottom: 12px;
    font-size: 45px;
    color: rgb(78, 78, 78);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
}

.scan-input-box {
    height: 120px;
    border-radius: 28px;
    background-color: rgb(255, 255, 255);
    justify-content: center;
    padding-left: 30px;
    padding-right: 30px;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    transition-property: border-left-color, border-right-color, border-top-color, border-bottom-color, background-color, translate;
    transition-duration: 0.08s;
    transition-timing-function: ease-out;
}

.scan-input-field {
    flex-grow: 1;
    height: 100%;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(84, 84, 84);
}

.scan-input-field .unity-base-field__input,
.scan-input-field .unity-base-text-field__input {
    height: 100%;
    margin: 0;
    padding: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(84, 84, 84);
    font-size: 42px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
}

.scan-input-field .unity-base-text-field__input--placeholder {
    color: rgb(186, 186, 186);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
}

.scan-select-button {
    flex-grow: 1;
    height: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 0;
    padding-right: 0;
}

.scan-select-button-text-field {
    flex-grow: 1;
    margin: 0;
    padding: 0;
}

.scan-select-button-text-field > .unity-text-field__input {
    padding-right: 16px;
}

.scan-select-button-arrow {
    margin-left: 24px;
    font-size: 68px;
    color: rgb(160, 160, 160);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
}

.scan-action-dialog-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: flex-end;
    background-color: rgba(0, 0, 0, 0.6);
    padding-left: 40px;
    padding-right: 40px;
    padding-bottom: 40px;
    visibility: visible;
    padding-top: 40px;
    opacity: 1;
}

.scan-action-dialog-overlay.is-anim-ready {
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.24s;
    transition-timing-function: ease-out;
}

.scan-action-dialog-overlay.is-anim-ready.is-open {
    opacity: 1;
}

.scan-action-dialog-sheet {
    width: 100%;
    min-height: 760px;
    border-radius: 44px;
    background-color: rgb(255, 255, 255);
    padding-top: 30px;
    padding-right: 50px;
    padding-bottom: 50px;
    padding-left: 50px;
    translate: 0 0;
    border-top-left-radius: 90px;
    border-top-right-radius: 90px;
    border-bottom-right-radius: 90px;
    border-bottom-left-radius: 90px;
    opacity: 1;
}

.scan-action-dialog-overlay.is-anim-ready .scan-action-dialog-sheet {
    opacity: 0;
    translate: 0 48px;
    transition-property: opacity, translate;
    transition-duration: 0.24s;
    transition-timing-function: ease-out;
}

.scan-action-dialog-overlay.is-anim-ready.is-open .scan-action-dialog-sheet {
    opacity: 1;
    translate: 0 0;
}

.scan-action-dialog-handle {
    width: 96px;
    height: 8px;
    border-radius: 4px;
    background-color: rgb(224, 226, 230);
    align-self: center;
    margin-top: 10px;
    margin-bottom: 75px;
}

.scan-action-dialog-title {
    font-size: 52px;
    color: rgb(53, 61, 77);
    margin-bottom: 50px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
    padding-right: 25px;
    padding-left: 25px;
}

.scan-action-list {
    width: 100%;
    margin-bottom: 18px;
    border-radius: 0;
}

.scan-action-list-item {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    margin: 0;
    border-width: 0;
    min-height: 118px;
    padding-top: 50px;
    padding-bottom: 50px;
    padding-left: 25px;
    padding-right: 25px;
    border-radius: 50px;
    transition-property: background-color;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
    margin-bottom: 20px;
    background-color: rgba(255, 255, 255, 0);
}

.scan-action-list-item:active:enabled {
    background-color: rgb(228, 233, 241);
}

.scan-action-list-item:hover:enabled {
    background-color: rgb(237, 240, 245);
}

.scan-action-option-icon-slot {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background-color: rgb(255, 230, 234);
    margin-right: 50px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.scan-action-option-icon-placeholder {
    width: 26px;
    height: 26px;
    border-radius: 13px;
    background-color: rgb(255, 53, 87);
}

.scan-action-option-texts {
    flex-grow: 1;
    min-width: 0;
}

.scan-action-option-title {
    font-size: 50px;
    color: rgb(49, 57, 73);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
    -unity-text-align: upper-left;
}

.scan-action-option-description {
    margin-top: 10px;
    min-height: 30px;
    font-size: 35px;
    color: rgb(145, 151, 163);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
    -unity-text-align: upper-left;
}

.scan-action-list-chevron {
    margin-left: 12px;
    font-size: 80px;
    color: rgb(198, 202, 209);
}

.scan-action-footer {
    flex-direction: row;
    margin-top: 12px;
    width: 100%;
}

.scan-action-footer-button {
    flex-grow: 1;
    height: 102px;
    border-radius: 22px;
    border-width: 0;
    font-size: 34px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.scan-action-footer-button-muted {
    margin-right: 14px;
    background-color: rgb(235, 235, 239);
    color: rgb(108, 114, 127);
}

.scan-action-footer-button-primary {
    background-color: rgb(59, 130, 232);
    color: rgb(255, 255, 255);
}

.alert-dialog-page {
    flex-grow: 1;
    background-color: rgb(246, 246, 246);
    padding-top: 175px;
}

.alert-dialog-header {
    height: 170px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 36px;
    padding-right: 36px;
    background-color: rgb(246, 246, 246);
}

.alert-back-button {
    width: 92px;
    height: 92px;
    color: rgb(44, 44, 44);
    font-size: 86px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
}

.alert-dialog-title {
    font-size: 50px;
    color: rgb(24, 24, 24);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.alert-header-spacer {
    width: 92px;
    height: 92px;
}

.alert-scroll {
    flex-grow: 1;
    background-color: rgb(246, 246, 246);
}

.alert-section {
    background-color: rgb(255, 255, 255);
}

.alert-request-item {
    min-height: 220px;
    padding-top: 34px;
    padding-right: 36px;
    padding-bottom: 32px;
    padding-left: 36px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(235, 235, 235);
}

.alert-map-item {
    min-height: 220px;
    padding-top: 34px;
    padding-right: 36px;
    padding-bottom: 32px;
    padding-left: 36px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(235, 235, 235);
}

.alert-request-main {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
}

.alert-text-column {
    flex-grow: 1;
    min-width: 0;
}

.alert-primary-text {
    font-size: 38px;
    color: rgb(16, 16, 16);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
    white-space: normal;
}

.alert-secondary-text {
    margin-top: 14px;
    font-size: 34px;
    color: rgb(97, 97, 97);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
}

.alert-time-text {
    flex-shrink: 0;
    margin-left: 24px;
    font-size: 34px;
    color: rgb(154, 154, 154);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
}

.alert-action-row {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 24px;
}

.alert-action-button {
    min-width: 220px;
    height: 76px;
    border-radius: 38px;
    border-width: 2px;
    font-size: 34px;
    margin-left: 18px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.alert-action-secondary {
    color: rgb(30, 30, 30);
    background-color: rgb(255, 255, 255);
    border-color: rgb(78, 78, 78);
}

.alert-action-primary {
    color: rgb(255, 255, 255);
    background-color: rgb(75, 88, 132);
    border-color: rgb(75, 88, 132);
}

.alert-gap {
    height: 200px;
    background-color: rgb(246, 246, 246);
}

.alert-close-button {
    width: 70px;
    height: 70px;
    color: rgb(65, 171, 219);
    font-size: 42px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

#signup-company-input-box.is-error,
#signup-name-input-box.is-error,
#signup-email-input-box.is-error {
    background-color: rgb(255, 247, 249);
}

.splash-root .splash-signup-panel .scan-input-box {
    position: relative;
}

.splash-root .splash-signup-panel .scan-input-box .signup-input-border {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-top-left-radius: 28px;
    border-top-right-radius: 28px;
    border-bottom-right-radius: 28px;
    border-bottom-left-radius: 28px;
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.splash-root .splash-signup-panel .scan-input-box.is-error .signup-input-border {
    border-left-color: rgb(248, 128, 148);
    border-right-color: rgb(248, 128, 148);
    border-top-color: rgb(248, 128, 148);
    border-bottom-color: rgb(248, 128, 148);
}

.splash-root .splash-panel {
    display: flex;
    opacity: 1;
    visibility: visible;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.28s;
    transition-timing-function: ease-out;
}

.splash-root .splash-panel.is-hidden {
    opacity: 0;
    visibility: hidden;
    translate: 0 28px;
}

.splash-root .splash-action-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.splash-root .splash-login-icon {
    width: 48px;
    height: 48px;
    margin-right: 22px;
    -unity-background-scale-mode: scale-to-fit;
}

.splash-root .splash-login-label {
    color: rgb(255, 255, 255);
    font-size: 44px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.splash-root .splash-login-button-kakao .splash-login-label {
    color: rgb(25, 22, 0);
}

.splash-root .splash-login-icon-kakao {
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/kakao.png?fileID=2800000&guid=ced5c007636d4164e8a3ccfbc2205ad8&type=3#kakao");
}

.splash-root .splash-login-icon-google {
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/google.png?fileID=2800000&guid=34f0e8d1f61950e41abd1b3637218c23&type=3#google");
}

.splash-root .splash-primary-button {
    background-color: rgb(177, 28, 68);
    color: rgb(255, 255, 255);
    font-size: 44px;
}

.splash-root .splash-primary-button:hover:enabled {
    background-color: rgb(158, 24, 61);
}

.splash-root .splash-primary-button:active:enabled {
    background-color: rgb(136, 20, 52);
}

.splash-root .splash-auth-popup {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding-left: 50px;
    padding-right: 50px;
    background-color: rgba(0, 0, 0, 0.48);
    visibility: visible;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.splash-root .splash-auth-popup.is-hidden {
    visibility: hidden;
    opacity: 0;
}

.splash-root .splash-auth-popup-sheet {
    width: 88%;
    min-height: 420px;
    border-top-left-radius: 90px;
    border-top-right-radius: 90px;
    border-bottom-right-radius: 90px;
    border-bottom-left-radius: 90px;
    background-color: rgb(255, 255, 255);
    padding-top: 68px;
    padding-right: 58px;
    padding-bottom: 58px;
    padding-left: 58px;
}

.splash-root .splash-auth-popup-title {
    color: rgb(49, 57, 73);
    margin-bottom: 34px;
    padding-left: 18px;
    padding-right: 18px;
    -unity-text-align: upper-left;
}

.splash-root .splash-auth-popup-message {
    color: rgb(72, 82, 99);
    -unity-text-align: upper-left;
    white-space: normal;
    margin-bottom: 54px;
    padding-left: 18px;
    padding-right: 18px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Light.ttf?fileID=12800000&guid=8c634880071f83d4da7be3c9ff6f0be8&type=3#Pretendard-Light");
}

.splash-root .splash-auth-popup-button {
    width: 100%;
    flex-grow: 0;
    height: 136px;
    border-radius: 40px;
}
