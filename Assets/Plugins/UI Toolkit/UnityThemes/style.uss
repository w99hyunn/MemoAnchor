:root {
    --nav-bg: rgb(30, 30, 34);
    --nav-icon-inactive: rgb(243, 243, 244);
    --nav-icon-active: rgb(255, 53, 87);
}

.unity-label {
    padding: 0;
    margin: 0;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
    color: rgb(28, 28, 28);
}

.unity-button {
    background-color: transparent;
    border-color: transparent;
    border-width: 0;
    padding: 0;
    margin: 0;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
}

.main-root {
    flex-grow: 1;
    position: relative;
    background-color: rgb(255, 255, 255);
}

.tab-viewport {
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
}

.tab-strip {
    flex-direction: row;
    position: relative;
    left: 0;
    height: 100%;
    transition-property: left;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
    width: 500%;
}

.tab-page {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
    flex-grow: 0;
    min-height: 0;
    display: flex;
}

.tab-page-layout {
    height: 100%;
    flex-direction: column;
    min-height: 0;
    padding-right: 50px;
    padding-left: 50px;
    padding-top: 175px;
    padding-bottom: 0;
}

.tab-fixed-header {
    flex-grow: 0;
    flex-shrink: 0;
}

.tab-content-scroll {
    flex-grow: 1;
    height: 100%;
    min-height: 0;
}

.tab-content-scroll .unity-scroll-view__content-container {
    align-items: stretch;
}

.tab-content-inner {
    flex-grow: 0;
    padding-bottom: 300px;
}

#home-content-scroll {
    margin-left: -50px;
    margin-right: -50px;
}

#home-content-scroll .unity-scroll-view__content-container {
    padding-left: 0;
    padding-right: 0;
}

#home-content-scroll .memo-section {
    margin-left: 0;
    margin-right: 0;
}

#memo-content-scroll {
    margin-left: -50px;
    margin-right: -50px;
}

#memo-content-scroll .unity-scroll-view__content-container {
    padding-left: 0;
    padding-right: 0;
}

#memo-content-scroll .memo-section {
    margin-left: 0;
    margin-right: 0;
}

.home-header {
    flex-grow: 0;
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 70px;
}

.home-greeting {
    font-size: 60px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
}

.home-right-icon-button {
    width: 65px;
    height: 65px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/alert.png?fileID=2800000&guid=a8ce16252c0ae1d46840a9dfaf22b609&type=3#alert");
    -unity-background-image-tint-color: rgb(28, 28, 28);
    -unity-background-scale-mode: scale-to-fit;
    margin-left: 30px;
}

.memo-section {
    flex-grow: 1;
    width: auto;
    min-width: 0;
    align-self: stretch;
    position: relative;
    margin-left: -50px;
    margin-right: -50px;
    background-color: var(--nav-bg);
    padding-top: 100px;
    padding-bottom: 100px;
}

.memo-section-bg {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(246, 246, 246);
}

.memo-section-content {
    flex-grow: 1;
}

.memo-section-header {
    flex-grow: 0;
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 30px;
    padding-right: 50px;
    padding-left: 50px;
}

.memo-section-title {
    font-size: 50px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
}

.memo-section-more {
    font-size: 35px;
    color: rgb(233, 233, 233);
}

.memo-scroll {
    flex-grow: 1;
    height: 700px;
}

.memo-scroll-content {
    flex-direction: row;
    padding-left: 50px;
    padding-right: 40px;
}

.memo-card {
    width: 900px;
    min-width: 760px;
    height: 700px;
    background-color: rgb(255, 255, 255);
    border-top-left-radius: 80px;
    border-top-right-radius: 80px;
    border-bottom-left-radius: 80px;
    border-bottom-right-radius: 80px;
    padding: 28px;
    margin-right: 40px;
    padding-top: 60px;
    padding-right: 60px;
    padding-bottom: 60px;
    padding-left: 60px;
}

.memo-title {
    font-size: 45px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
    margin-bottom: 25px;
}

.memo-divider {
    height: 2px;
    background-color: rgb(207, 207, 207);
    margin-bottom: 30px;
}

.memo-check-row {
    height: 120px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgb(239, 239, 239);
    border-top-left-radius: 45px;
    border-top-right-radius: 45px;
    border-bottom-left-radius: 45px;
    border-bottom-right-radius: 45px;
    padding-left: 40px;
    padding-right: 40px;
    margin-bottom: 12px;
}

.memo-check-text {
    font-size: 40px;
    color: rgb(44, 44, 44);
}

.memo-check-toggle {
    margin: 0;
    padding: 0;
}

.memo-check-toggle .unity-toggle__label {
    display: none;
}

.memo-check-toggle .unity-toggle__input {
    width: 70px;
    height: 70px;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-color: rgb(160, 160, 160);
    border-right-color: rgb(160, 160, 160);
    border-bottom-color: rgb(160, 160, 160);
    border-left-color: rgb(160, 160, 160);
    border-radius: 20px;
    background-color: rgb(255, 255, 255);
    background-image: none;
}

.memo-check-toggle:checked .unity-toggle__input {
    background-color: rgb(217, 217, 217);
    background-image: none;
}

.memo-check-toggle .unity-toggle__checkmark {
    width: 40px;
    height: 40px;
    margin: 0;
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    opacity: 0;
}

.memo-check-toggle:checked .unity-toggle__checkmark {
    opacity: 1;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/check.png?fileID=2800000&guid=cc44cf71ac7687d4c82692e2f8ff010c&type=3#check");
    -unity-background-scale-mode: scale-to-fit;
}

.memo-checkbox {
    width: 34px;
    height: 34px;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-color: rgb(160, 160, 160);
    border-right-color: rgb(160, 160, 160);
    border-bottom-color: rgb(160, 160, 160);
    border-left-color: rgb(160, 160, 160);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.memo-checkbox-checked {
    background-color: rgb(217, 217, 217);
}

.memo-footer {
    flex-grow: 1;
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
}

.memo-footer-text {
    font-size: 35px;
    color: rgb(135, 135, 135);
}

.memo-footer-date {
    margin-left: auto;
}

.scan-map-scroll-content {
    flex-direction: row;
    padding-left: 50px;
    padding-right: 40px;
}

.scan-map-card {
    width: 760px;
    min-width: 760px;
    height: 900px;
    margin-right: 32px;
    border-radius: 28px;
    background-color: rgb(132, 132, 132);
    overflow: hidden;
    border-top-left-radius: 80px;
    border-top-right-radius: 80px;
    border-bottom-right-radius: 80px;
    border-bottom-left-radius: 80px;
}

.scan-map-thumbnail {
    flex-grow: 1;
}

.scan-map-info {
    flex-grow: 0;
    padding-top: 60px;
    padding-right: 60px;
    padding-bottom: 60px;
    padding-left: 60px;
}

.scan-map-title {
    font-size: 42px;
    color: rgb(245, 245, 245);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
}

.scan-map-subtitle {
    margin-top: 8px;
    font-size: 30px;
    color: rgba(245, 245, 245, 0.88);
}

.bottom-nav-wrapper {
    position: absolute;
    left: 60px;
    right: 60px;
    bottom: 60px;
    height: 200px;
    align-items: center;
    justify-content: center;
}

.bottom-nav {
    width: 100%;
    height: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    background-color: var(--nav-bg);
    border-radius: 100px;
    padding-left: 18px;
    padding-right: 18px;
}

.nav-item {
    width: 130px;
    height: 130px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-radius: 28px;
    background-color: rgba(0, 0, 0, 0);
    position: relative;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    -unity-font-style: normal;
    padding-top: 10px;
    padding-bottom: 10px;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

.nav-press-bg {
    position: absolute;
    left: -10px;
    right: -10px;
    top: -10px;
    bottom: -20px;
    border-radius: 24px;
    background-color: rgba(42, 42, 47, 0);
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
    border-top-left-radius: 50px;
    border-top-right-radius: 50px;
    border-bottom-right-radius: 50px;
    border-bottom-left-radius: 50px;
}

.nav-item:hover {
    background-color: rgba(0, 0, 0, 0);
    transition-duration: 0.16s;
}

.nav-item:active {
    background-color: rgba(0, 0, 0, 0);
    transition-duration: 0.12s;
}

.nav-item:hover .nav-press-bg {
    background-color: rgba(44, 44, 50, 0.68);
}

.nav-item:active .nav-press-bg {
    background-color: rgba(54, 54, 60, 0.82);
}

.nav-item.is-tapping-down {
    background-color: rgba(0, 0, 0, 0);
}

.nav-item.is-tapping-down .nav-press-bg {
    top: 16px;
    bottom: 4px;
    left: 12px;
    right: 12px;
    border-radius: 36px;
    background-color: rgba(50, 50, 56, 0.95);
}

.nav-item > .nav-icon,
.nav-item > .nav-label {
    position: relative;
    top: 0;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

.nav-item.is-tapping-down > .nav-icon,
.nav-item.is-tapping-down > .nav-label {
    top: 2px;
}

.nav-icon {
    width: 52px;
    height: 52px;
    background-position: center;
    background-repeat: no-repeat;
    background-size: contain;
    -unity-background-image-tint-color: var(--nav-icon-inactive);
}

.nav-label {
    font-size: 30px;
    color: var(--nav-icon-inactive);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
    margin-top: 20px;
}

.nav-item.is-active .nav-icon {
    -unity-background-image-tint-color: var(--nav-icon-active);
    transition-duration: 0.18s;
}

.nav-item.is-active .nav-label {
    color: var(--nav-icon-active);
    transition-duration: 0.18s;
}

.fade-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
}

.memo-search-input {
    font-size: 50px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
    background-color: rgba(255, 255, 255, 0);
    height: 95px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    color: rgb(255, 255, 255);
}

.memo-search-input .unity-base-text-field__input {
    background-color: transparent;
    border-radius: 45px;
    padding-left: 120px;
    border-color: rgb(178, 178, 178);
}

.unity-base-text-field__input {
    color: rgb(255, 255, 255);
}

.unity-base-text-field__input--placeholder {
    color: rgb(88, 88, 88);
}

.memo-list-container {
    margin-top: 0;
    padding-top: 0;
    padding-right: 0;
    padding-left: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-bottom: 0;
}

.memo-list-scroll {
    flex-grow: 1;
    min-height: 0;
    margin-top: 8px;
}

.memo-list-item {
    height: 350px;
    flex-direction: row;
    align-items: center;
    padding-left: 75px;
    padding-right: 75px;
    background-color: rgb(255, 255, 255);
    padding-top: 75px;
    padding-bottom: 75px;
}

.memo-list-item-icon {
    width: 50px;
    height: 50px;
    margin-right: 20px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/memo-list/gallery.png?fileID=2800000&guid=805e5b39866ef38418d58c22145056e8&type=3#gallery");
    -unity-background-scale-mode: scale-to-fit;
}

.memo-list-item-body {
    flex-grow: 1;
    min-width: 0;
    height: 100%;
}

.memo-list-item-title {
    font-size: 50px;
    color: rgb(22, 22, 22);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.memo-list-item-meta-row {
    flex-direction: row;
    margin-top: 10px;
    margin-left: 70px;
}

.memo-list-item-meta {
    margin-right: 22px;
    font-size: 40px;
    color: rgb(156, 156, 156);
}

.memo-list-item-dot {
    width: 22px;
    height: 22px;
    margin-left: 12px;
    border-radius: 11px;
    background-color: rgb(236, 60, 85);
}
