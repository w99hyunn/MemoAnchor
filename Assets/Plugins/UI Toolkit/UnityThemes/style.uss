}

.map-participants-invite-code {
    margin-left: 18px;
    color: rgb(134, 134, 134);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.map-participants-copy-icon {
    width: 36px;
    height: 36px;
    margin-left: 14px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/copy.png?fileID=2800000&guid=f2faea3e3249a3a4d86ff2a957c98f51&type=3#copy");
    -unity-background-image-tint-color: rgb(168, 168, 168);
}

.map-participants-invite-code-button:hover:enabled .map-participants-copy-icon {
    -unity-background-image-tint-color: rgb(130, 130, 130);
}

.map-participants-invite-code-button:active:enabled .map-participants-copy-icon {
    -unity-background-image-tint-color: rgb(92, 92, 92);
