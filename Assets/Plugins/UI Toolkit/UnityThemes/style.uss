}

.map-reconstruction-memo-marker.is-completion-requested {
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/map_view_memo_ok.png?fileID=2800000&guid=7930cab31825cf44ca19a72f40266cec&type=3#map_view_memo_ok");
}

.map-reconstruction-memo-marker:active:enabled {
    background-color: rgba(0, 0, 0, 0);
    opacity: 0.72;
}

.map-reconstruction-memo-card {
    position: absolute;
    width: 380px;
    height: 320px;
    padding: 28px;
    overflow: visible;
    border-width: 8px;
