:root {
    --nav-bg: rgb(30, 30, 34);
    --nav-icon-inactive: rgb(243, 243, 244);
    --brand-pink: rgb(161, 31, 63);
    --brand-pink-hover: rgb(143, 27, 56);
    --brand-pink-active: rgb(126, 24, 49);
    --nav-icon-active: var(--brand-pink);
    --nav-bar-radius: 84px;
    --bottom-sheet-list-title-size: 36px;
    --bottom-sheet-list-primary-size: 40px;
    --bottom-sheet-list-secondary-size: 32px;
}

.unity-label {
    padding: 0;
    margin: 0;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
    color: rgb(28, 28, 28);
}

.unity-button {
    background-color: transparent;
    border-color: transparent;
    border-width: 0;
    padding: 0;
    margin: 0;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
}

.unity-button:hover:enabled {
    background-color: transparent;
    border-color: transparent;
}

.unity-button:active:enabled {
    background-color: transparent;
    border-color: transparent;
}

.unity-button:focus {
    border-left-color: transparent;
    border-right-color: transparent;
    border-top-color: transparent;
    border-bottom-color: transparent;
}

.unity-button:focus:enabled {
    border-left-color: transparent;
    border-right-color: transparent;
    border-top-color: transparent;
    border-bottom-color: transparent;
}

.common-icon-button {
    width: 88px;
    height: 88px;
    border-width: 0;
    border-radius: 999px;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    transition-property: background-color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.common-icon-button:hover:enabled {
    background-color: rgba(0, 0, 0, 0.14);
    border-color: transparent;
}

.common-icon-button:active:enabled {
    background-color: rgba(0, 0, 0, 0.22);
    border-color: transparent;
}

.common-icon-button-icon {
    width: 50px;
    height: 50px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(42, 42, 42);
}

.horizontal-row {
    flex-direction: row;
    align-items: center;
}

.flex-title-row {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    min-width: 0;
}

.content-list {
    flex-grow: 0;
}

.wrap-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.flex-text-column {
    flex-grow: 1;
    min-width: 0;
}

.full-width-list {
    width: 100%;
}

.horizontal-card-scroll-content {
    flex-direction: row;
    padding-left: 50px;
    padding-right: 40px;
}

.splash-root {
    flex-grow: 1;
    justify-content: center;
    background-color: var(--brand-pink);
}

.splash-brand {
    position: absolute;
    left: 0;
    right: 0;
    top: 500px;
    align-items: center;
}

.splash-symbol {
    width: 300px;
    height: 250px;
    margin-bottom: 34px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/system/icon_new.png?fileID=2800000&guid=c5484f5bd1c29de40898e64802107c7b&type=3#icon_new");
    -unity-background-scale-mode: scale-to-fit;
}

.splash-logo {
    width: 680px;
    height: 220px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/logo.png?fileID=2800000&guid=a402c67bcb520e24fa718d51047c61ed&type=3#logo");
    -unity-background-scale-mode: scale-to-fit;
}

.splash-tagline {
    margin-top: 30px;
    color: rgb(255, 255, 255);
    font-size: 52px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
}

.splash-panel {
    position: absolute;
    left: 140px;
    right: 140px;
    bottom: 220px;
    display: flex;
}

.splash-signup-panel {
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(246, 246, 246);
}

.splash-signup-panel .home-header {
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
}

.splash-signup-description {
    margin-top: 12px;
    font-size: 34px;
    color: rgb(135, 135, 135);
}

.splash-signup-bottom-bar {
    position: absolute;
    left: 60px;
    right: 60px;
    bottom: 60px;
    height: 200px;
    flex-direction: row;
    align-items: center;
}

.splash-login-button-kakao:hover:enabled {
    background-color: rgb(246, 220, 0);
}

.splash-signup-status {
    min-height: 42px;
    margin-top: 44px;
    color: rgb(87, 87, 87);
    font-size: 34px;
}

.main-root {
    flex-grow: 1;
    position: relative;
    background-color: rgb(246, 246, 246);
}

.tab-viewport {
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    transition-property: filter;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.tab-strip {
    flex-direction: row;
    position: relative;
    left: 0;
    height: 100%;
    transition-property: left;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
    width: 500%;
}

.tab-page {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
    flex-grow: 0;
    min-height: 0;
    display: flex;
}

.tab-page-layout {
    height: 100%;
    flex-direction: column;
    min-height: 0;
    padding-right: 50px;
    padding-left: 50px;
    padding-top: 175px;
    padding-bottom: 0;
}

.tab-fixed-header {
    flex-grow: 0;
    flex-shrink: 0;
}

.tab-content-scroll {
    flex-grow: 1;
    min-height: 0;
}

.page-scroll {
    flex-grow: 1;
    min-height: 0;
}

.tab-content-scroll .unity-scroll-view__content-container {
    align-items: stretch;
}

.tab-content-inner {
    flex-grow: 0;
    padding-bottom: 300px;
}

#memo-content-scroll .unity-scroll-view__content-container,
#map-memo-content-scroll .unity-scroll-view__content-container {
    flex-grow: 1;
}

#memo-trash-scroll .unity-scroll-view__content-container {
    flex-grow: 1;
}

.tab-content-inner.is-memo-list-empty {
    flex-grow: 1;
    padding-bottom: 0;
}

#home-content-scroll {
    margin-left: -50px;
    margin-right: -50px;
}

#home-content-scroll .unity-scroll-view__content-container {
    padding-left: 0;
    padding-right: 0;
}

#home-content-scroll .memo-section {
    margin-left: 0;
    margin-right: 0;
}

#memo-content-scroll {
    margin-left: -50px;
    margin-right: -50px;
}

#memo-content-scroll .unity-scroll-view__content-container {
    padding-left: 0;
    padding-right: 0;
}

#memo-content-scroll .memo-section {
    margin-left: 0;
    margin-right: 0;
}

.memo-tab-mode-page {
    background-color: rgb(83, 94, 131);
}

.memo-tab-mode-page.is-admin-mode {
    background-color: var(--brand-pink);
}

.memo-mode-title {
    color: rgb(255, 255, 255);
    margin-right: 28px;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    -unity-text-overflow-position: end;
}

.memo-header-actions {
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}

.home-header {
    flex-grow: 0;
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 70px;
}

.home-greeting {
    font-size: 70px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.page-header-title {
    font-size: 50px;
    color: rgb(28, 28, 28);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

#memo-detail-place-label {
    font-size: 58px;
}

.header-icon-button {
    margin-left: 50px;
}

.memo-tab-mode-page .header-icon-button .common-icon-button-icon {
    -unity-background-image-tint-color: rgb(245, 245, 245);
}

.memo-filter-icon-button {
    margin-left: 24px;
}

.memo-section {
    flex-grow: 1;
    width: auto;
    min-width: 0;
    align-self: stretch;
    position: relative;
    margin-left: -50px;
    margin-right: -50px;
    background-color: var(--nav-bg);
    padding-top: 50px;
    padding-bottom: 50px;
}

#mode-back {
    background-color: rgb(83, 94, 131);
}

#mode-back.is-admin-mode {
    background-color: var(--brand-pink);
}

.memo-section-content {
    flex-grow: 1;
}

.memo-section-header {
    flex-grow: 0;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
    padding-right: 50px;
    padding-left: 50px;
}

.home-mode-title {
    color: rgb(255, 255, 255);
    margin-right: 28px;
}

.home-mode-toggle {
    width: 160px;
    height: 76px;
    border-radius: 38px;
    background-color: rgb(234, 236, 239);
    padding-top: 6px;
    padding-right: 6px;
    padding-bottom: 6px;
    padding-left: 6px;
    justify-content: center;
    border-width: 0;
    flex-shrink: 0;
}

.home-mode-toggle:hover:enabled,
.home-mode-toggle:active:enabled {
    background-color: rgb(234, 236, 239);
}

.home-mode-toggle-thumb {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    background-color: var(--brand-pink);
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/admin.png?fileID=2800000&guid=5b0fcf6366924744cb2f0df276925867&type=3#admin");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 182, 200);
    align-self: flex-start;
    transition-property: translate, background-color;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
    background-size: 60% 60%;
}

.home-mode-toggle.is-work-mode .home-mode-toggle-thumb {
    translate: 84px 0;
    background-color: rgb(83, 94, 131);
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/user.png?fileID=2800000&guid=3a95cf702d6e3e64ca7c035145fdacfd&type=3#user");
    -unity-background-image-tint-color: rgb(149, 171, 249);
}

.memo-section-title {
    font-size: 50px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.memo-section-more {
    font-size: 35px;
    color: rgb(233, 233, 233);
}

.memo-scroll {
    flex-grow: 1;
    height: 700px;
}

.home-memo-scroll-frame {
    position: relative;
    width: 100%;
    height: 700px;
}

.home-memo-scroll {
    width: 100%;
    height: 700px;
}

.home-memo-empty-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    font-size: 38px;
    color: rgba(255, 255, 255, 0.78);
    -unity-text-align: middle-center;
}

.home-map-scroll-frame {
    position: relative;
    width: 100%;
    height: 900px;
}

.home-map-scroll {
    width: 100%;
    height: 900px;
}

.home-map-empty-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    font-size: 38px;
    color: rgb(135, 135, 135);
    -unity-text-align: middle-center;
}

.memo-card {
    width: 900px;
    min-width: 760px;
    height: 700px;
    background-color: rgb(255, 255, 255);
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-left-radius: 30px;
    border-bottom-right-radius: 30px;
    padding: 28px;
    margin-right: 40px;
    padding-top: 60px;
    padding-right: 60px;
    padding-bottom: 60px;
    padding-left: 60px;
}

.memo-title {
    font-size: 45px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
    margin-bottom: 25px;
}

.memo-divider {
    height: 2px;
    background-color: rgb(207, 207, 207);
    margin-bottom: 30px;
}

.memo-check-row {
    height: 120px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgb(239, 239, 239);
    border-top-left-radius: 45px;
    border-top-right-radius: 45px;
    border-bottom-left-radius: 45px;
    border-bottom-right-radius: 45px;
    padding-left: 40px;
    padding-right: 40px;
    margin-bottom: 12px;
}

.memo-check-text {
    font-size: 40px;
    color: rgb(44, 44, 44);
}

.memo-check-toggle {
    margin: 0;
    padding: 0;
}

.memo-check-toggle .unity-toggle__label {
    display: none;
}

.memo-check-toggle .unity-toggle__input {
    width: 64px;
    height: 64px;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: 0;
    border-radius: 10px;
    background-color: rgb(210, 210, 210);
    background-image: none;
    transition-property: background-color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.memo-check-toggle .unity-toggle__input:hover {
    background-color: rgb(190, 190, 190);
}

.memo-check-toggle .unity-toggle__input:active {
    background-color: rgb(170, 170, 170);
}

.memo-check-toggle:checked .unity-toggle__input {
    background-color: rgb(90, 90, 90);
    background-image: none;
}

.memo-check-toggle:checked .unity-toggle__input:hover {
    background-color: rgb(76, 76, 76);
}

.memo-check-toggle:checked .unity-toggle__input:active {
    background-color: rgb(60, 60, 60);
}

.memo-check-toggle .unity-toggle__checkmark {
    width: 42px;
    height: 42px;
    margin: 0;
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    opacity: 0;
}

.memo-check-toggle:checked .unity-toggle__checkmark {
    opacity: 1;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/check.png?fileID=2800000&guid=cc44cf71ac7687d4c82692e2f8ff010c&type=3#check");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.memo-footer {
    flex-grow: 1;
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
}

.memo-footer-text {
    font-size: 35px;
    color: rgb(135, 135, 135);
}

.memo-footer-date {
    margin-left: auto;
}

.home-memo-footer-person {
    flex-direction: row;
    align-items: flex-end;
    flex-shrink: 0;
}

.home-memo-footer-role {
    margin-right: 10px;
}

.home-memo-footer-person-name {
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.home-memo-body-text {
    flex-grow: 1;
    font-size: 40px;
    color: rgb(44, 44, 44);
    white-space: normal;
}

.home-memo-footer-location {
    max-width: 330px;
    margin-left: 30px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.home-memo-voice-row {
    height: 100px;
}

.home-memo-checkmark {
    width: 58px;
    height: 58px;
    flex-shrink: 0;
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-left-color: rgb(155, 155, 155);
    border-right-color: rgb(155, 155, 155);
    border-top-color: rgb(155, 155, 155);
    border-bottom-color: rgb(155, 155, 155);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.memo-check-row.is-complete .memo-check-text {
    color: rgb(165, 165, 165);
}

.memo-check-row.is-complete .home-memo-checkmark {
    background-color: rgb(205, 205, 205);
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/check.png?fileID=2800000&guid=cc44cf71ac7687d4c82692e2f8ff010c&type=3#check");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(155, 155, 155);
}

.home-memo-image-gallery {
    height: 300px;
    margin-bottom: 10px;
    overflow: hidden;
}

.home-memo-image-gallery .unity-scroll-view__content-container {
    flex-direction: row;
}

.home-memo-image-preview {
    width: 245px;
    height: 280px;
    flex-shrink: 0;
    margin-right: 18px;
    background-color: rgb(225, 225, 225);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    -unity-background-scale-mode: scale-and-crop;
}

.home-completion-request-card {
    padding-top: 42px;
}

.home-completion-title-row {
    height: 130px;
    flex-direction: row;
    align-items: center;
    padding-left: 38px;
    padding-right: 38px;
    margin-bottom: 70px;
    background-color: rgb(239, 239, 239);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.home-completion-title {
    flex-grow: 1;
    min-width: 0;
    font-size: 43px;
    color: rgb(35, 35, 35);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
}

.home-completion-arrow {
    width: 64px;
    font-size: 52px;
    color: rgb(35, 35, 35);
    -unity-text-align: middle-center;
}

.home-completion-actions {
    height: 245px;
    flex-direction: row;
    margin-bottom: 38px;
}

.home-completion-action {
    flex-grow: 1;
    height: 245px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 30px;
    font-size: 43px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.home-completion-action.is-supplement {
    margin-right: 14px;
    color: rgb(255, 65, 88);
    background-color: rgb(255, 215, 220);
}

.home-completion-action.is-supplement:hover:enabled {
    border-color: transparent;
    background-color: rgb(255, 199, 207);
}

.home-completion-action.is-supplement:active:enabled {
    border-color: transparent;
    background-color: rgb(255, 181, 192);
}

.home-completion-action.is-complete {
    margin-left: 14px;
    color: rgb(83, 94, 131);
    background-color: rgb(218, 225, 248);
}

.home-completion-action.is-complete:hover:enabled {
    border-color: transparent;
    background-color: rgb(203, 213, 244);
}

.home-completion-action.is-complete:active:enabled {
    border-color: transparent;
    background-color: rgb(187, 201, 239);
}

.map-tab-page {
    background-color: rgb(244, 244, 244);
}

.map-top-bar {
    position: relative;
    margin-bottom: 0;
}

.map-title-group {
    width: auto;
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    align-items: center;
    min-width: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
}

.map-title-group:hover:enabled,
.map-title-group:active:enabled,
.map-title-group:disabled {
    background-color: rgba(0, 0, 0, 0);
}

.map-current-address-label {
    margin-left: 30px;
    font-size: 40px;
    color: rgb(84, 84, 84);
    -unity-text-align: lower-left;
}

.map-list-button {
    background-image: none;
}

.map-list-button .common-icon-button-icon {
    width: 58px;
    height: 58px;
}

.map-participants-button {
    height: 150px;
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
}

#map-memo-page .page-header {
    justify-content: flex-start;
    padding-left: 180px;
    padding-right: 50px;
}

#map-memo-page .map-title-group {
    width: auto;
    flex-grow: 1;
}

#map-memo-page .memo-section {
    margin-left: 0;
    margin-right: 0;
}

#map-memo-page .home-greeting,
#map-memo-page .map-current-address-label {
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    -unity-text-overflow-position: end;
}

#map-memo-page .memo-search-input .unity-base-text-field__input,
#map-memo-page .memo-search-input .unity-base-text-field__input--placeholder {
    color: rgb(88, 88, 88);
}

#map-memo-empty-state {
