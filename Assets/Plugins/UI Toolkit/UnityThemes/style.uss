.memo-card-footer {
    margin-top: auto;
    height: 58px;
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
}

.memo-card-footer-item {
    flex-direction: row;
    margin-left: 18px;
    margin-right: 18px;
}

.memo-card-footer-label {
    font-size: 32.5px;
    color: rgb(160, 160, 160);
}

.memo-card-footer-prefix {
    margin-right: 6px;
    color: rgb(128, 128, 128);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.page-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(250, 250, 250);
    padding-top: 120px;
    display: flex;
}

.page-header {
    height: 145px;
    flex-grow: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-bottom-width: 0;
}

.page-back-button {
    position: absolute;
    left: 50px;
}

.page-back-button .common-icon-button-icon {
    width: 44px;
    height: 44px;
}

.page-back-button:active:enabled .common-icon-button-icon {
    -unity-background-image-tint-color: rgb(20, 20, 20);
}

.memo-filter-scroll {
    flex-grow: 1;
    min-height: 0;
    padding-left: 50px;
    padding-right: 50px;
    margin-bottom: 260px;
}

.memo-filter-section {
    flex-grow: 0;
    padding-top: 70px;
    padding-bottom: 45px;
}

.memo-filter-section-title {
    font-size: 42px;
    color: rgb(68, 68, 68);
    margin-bottom: 42px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
}

.memo-filter-divider {
    height: 1px;
    background-color: rgb(228, 228, 228);
}

.memo-filter-date-row {
    height: 110px;
    flex-direction: row;
    align-items: center;
}

.memo-filter-date-button {
    flex-grow: 1;
    flex-basis: 0;
    height: 110px;
    border-width: 2px;
    border-color: rgb(219, 219, 219);
    border-radius: 55px;
    background-color: rgb(255, 255, 255);
    flex-direction: row;
    align-items: center;
    justify-content: center;
    transition-property: background-color, border-color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.memo-filter-date-button:hover:enabled {
    background-color: rgb(248, 248, 248);
    border-color: rgb(194, 194, 194);
}

.memo-filter-date-button:active:enabled {
    background-color: rgb(239, 239, 239);
    border-color: rgb(170, 170, 170);
}

.memo-filter-date-button.is-selected {
    border-color: rgb(83, 94, 131);
}

.memo-filter-date-button.is-selected:hover:enabled {
    background-color: rgb(246, 247, 252);
    border-color: rgb(76, 90, 133);
}

.memo-filter-date-button.is-selected:active:enabled {
    background-color: rgb(235, 238, 248);
    border-color: rgb(66, 79, 119);
}

.page-overlay.is-admin-mode .memo-filter-date-button.is-selected {
    border-color: var(--brand-pink);
}

.page-overlay.is-admin-mode .memo-filter-date-button.is-selected:hover:enabled {
    background-color: rgb(255, 246, 249);
    border-color: var(--brand-pink-hover);
}

.page-overlay.is-admin-mode .memo-filter-date-button.is-selected:active:enabled {
    background-color: rgb(255, 235, 241);
    border-color: var(--brand-pink-active);
}

.memo-filter-date-button.is-error {
    border-color: rgb(236, 60, 85);
}

.memo-filter-date-button.is-error:hover:enabled {
    background-color: rgb(255, 247, 249);
    border-color: rgb(236, 60, 85);
}

.memo-filter-date-button.is-error:active:enabled {
    background-color: rgb(255, 235, 239);
    border-color: rgb(210, 44, 70);
}

.memo-filter-date-text {
    font-size: 34px;
    color: rgb(88, 88, 88);
}

.memo-filter-date-button.is-selected .memo-filter-date-text {
    color: rgb(28, 28, 28);
}

.memo-filter-date-button.is-error .memo-filter-date-text {
    color: rgb(236, 60, 85);
}

.memo-filter-calendar-icon {
    width: 34px;
    height: 34px;
    margin-left: 18px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/calendar_month.png?fileID=2800000&guid=b1dcfd6da9be6544b8081fdc92d97423&type=3#calendar_month");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(84, 84, 84);
}

.memo-filter-date-button.is-selected .memo-filter-calendar-icon {
    -unity-background-image-tint-color: rgb(83, 94, 131);
}

.page-overlay.is-admin-mode .memo-filter-date-button.is-selected .memo-filter-calendar-icon {
    -unity-background-image-tint-color: var(--brand-pink);
}

.memo-filter-date-button.is-error .memo-filter-calendar-icon {
    -unity-background-image-tint-color: rgb(236, 60, 85);
}

.memo-filter-date-dash {
    width: 72px;
    height: 2px;
    margin-left: 22px;
    margin-right: 22px;
    background-color: rgb(190, 190, 190);
    -unity-text-align: middle-center;
    font-size: 0;
    color: rgba(0, 0, 0, 0);
}

.memo-filter-check-button {
    width: 64px;
    height: 64px;
    margin-left: 24px;
    border-radius: 10px;
    background-color: rgb(210, 210, 210);
    align-items: center;
    justify-content: center;
    transition-property: background-color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.memo-filter-check-button:hover:enabled {
    background-color: rgb(190, 190, 190);
}

.memo-filter-check-button:active:enabled {
    background-color: rgb(170, 170, 170);
}

.memo-filter-check-button.is-selected {
    background-color: rgb(90, 90, 90);
}

.memo-filter-check-button.is-selected:hover:enabled {
    background-color: rgb(76, 76, 76);
}

.memo-filter-check-button.is-selected:active:enabled {
    background-color: rgb(60, 60, 60);
}

.page-overlay.is-admin-mode .memo-filter-check-button.is-selected {
    background-color: var(--brand-pink);
}

.page-overlay.is-admin-mode .memo-filter-check-button.is-selected:hover:enabled {
    background-color: var(--brand-pink-hover);
}

.page-overlay.is-admin-mode .memo-filter-check-button.is-selected:active:enabled {
    background-color: var(--brand-pink-active);
}

.memo-filter-check-icon {
    width: 42px;
    height: 42px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/check.png?fileID=2800000&guid=cc44cf71ac7687d4c82692e2f8ff010c&type=3#check");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.memo-filter-calendar {
    margin-top: 34px;
    border-width: 2px;
    border-color: rgb(83, 94, 131);
    border-radius: 36px;
    background-color: rgb(255, 255, 255);
    padding-top: 34px;
    padding-right: 40px;
    padding-bottom: 40px;
    padding-left: 40px;
    display: flex;
}

.memo-filter-calendar.is-error {
    border-color: rgb(236, 60, 85);
}

.page-overlay.is-admin-mode .memo-filter-calendar {
    border-color: var(--brand-pink);
}

.page-overlay.is-admin-mode .memo-filter-calendar.is-error {
    border-color: rgb(236, 60, 85);
}

.memo-filter-calendar-header {
    height: 64px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 28px;
}

.memo-filter-calendar-title {
    width: 280px;
    -unity-text-align: middle-center;
    font-size: 34px;
    color: rgb(28, 28, 28);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.memo-filter-calendar-nav,
.memo-filter-calendar-close {
    width: 64px;
    height: 64px;
    color: rgb(86, 86, 86);
    border-radius: 32px;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    transition-property: background-color, color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.memo-filter-calendar-nav:hover:enabled,
.memo-filter-calendar-close:hover:enabled {
    background-color: rgb(244, 244, 244);
    border-color: transparent;
}

.memo-filter-calendar-nav:active:enabled,
.memo-filter-calendar-close:active:enabled {
    background-color: rgb(230, 230, 230);
    border-color: transparent;
    color: rgb(36, 36, 36);
}

.memo-filter-calendar-close {
    position: absolute;
    top: 0;
    right: 0;
    width: 64px;
    height: 64px;
    color: rgb(170, 170, 170);
}

.memo-calendar-close-icon {
    width: 44px;
    height: 44px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/xbutton.png?fileID=2800000&guid=ec503318264761140bef84a89627b643&type=3#xbutton");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(170, 170, 170);
}

.memo-filter-calendar-close:active:enabled .memo-calendar-close-icon {
    -unity-background-image-tint-color: rgb(36, 36, 36);
}

.memo-calendar-chevron {
    width: 34px;
    height: 34px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/chevron_forward.png?fileID=2800000&guid=3ca432206e7cabb45abd1dfc722e509d&type=3#chevron_forward");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(86, 86, 86);
}

.memo-calendar-chevron.is-prev {
    rotate: 0;
}

.memo-calendar-chevron.is-next {
    rotate: 180deg;
}

.memo-filter-calendar-nav:active:enabled .memo-calendar-chevron {
    -unity-background-image-tint-color: rgb(36, 36, 36);
}

.memo-filter-calendar-cell {
    width: 14.2857%;
    height: 70px;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    color: rgb(48, 48, 48);
    transition-property: background-color, color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
    border-radius: 35px;
}

.memo-filter-calendar-cell:hover:enabled {
    background-color: rgb(245, 245, 245);
    border-color: transparent;
}

.memo-filter-calendar-cell:active:enabled {
    background-color: rgb(232, 232, 232);
    border-color: transparent;
}

.memo-filter-calendar-cell.is-weekday-header {
    color: rgb(140, 140, 140);
    font-size: 28px;
}

.memo-filter-calendar-cell.is-sunday {
    color: rgb(236, 60, 85);
}

.memo-filter-calendar-cell.is-saturday {
    color: rgb(86, 122, 210);
}

.memo-filter-calendar-cell.is-muted {
    color: rgb(194, 194, 194);
}

.memo-filter-calendar-cell.is-selected {
    color: rgb(255, 255, 255);
    background-color: rgb(83, 94, 131);
    border-radius: 35px;
}

.memo-filter-calendar-cell.is-selected:hover:enabled {
    background-color: rgb(76, 90, 133);
}

.memo-filter-calendar-cell.is-selected:active:enabled {
    background-color: rgb(66, 79, 119);
}

.page-overlay.is-admin-mode .memo-filter-calendar-cell.is-selected {
    background-color: var(--brand-pink);
}

.page-overlay.is-admin-mode .memo-filter-calendar-cell.is-selected:hover:enabled {
    background-color: var(--brand-pink-hover);
}

.page-overlay.is-admin-mode .memo-filter-calendar-cell.is-selected:active:enabled {
    background-color: var(--brand-pink-active);
}

.memo-filter-calendar.is-error .memo-filter-calendar-cell.is-selected {
    background-color: rgb(236, 60, 85);
}

.memo-filter-chip {
    width: 48%;
    height: 110px;
    margin-right: 2%;
    margin-bottom: 22px;
    border-width: 2px;
    border-color: rgb(221, 221, 221);
    border-radius: 55px;
    background-color: rgb(255, 255, 255);
    color: rgb(48, 48, 48);
    font-size: 34px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.memo-filter-chip:hover:enabled,
.memo-filter-urgency-chip:hover:enabled,
.memo-filter-select-button:hover:enabled {
    background-color: rgb(248, 248, 248);
    border-color: rgb(194, 194, 194);
}

.memo-filter-chip:active:enabled,
.memo-filter-urgency-chip:active:enabled,
.memo-filter-select-button:active:enabled {
    background-color: rgb(239, 239, 239);
    border-color: rgb(170, 170, 170);
}

.memo-filter-chip.is-selected,
.memo-filter-urgency-chip.is-selected {
    background-color: rgb(83, 94, 131);
    border-color: rgb(83, 94, 131);
    color: rgb(255, 255, 255);
}

.memo-filter-chip.is-selected:hover:enabled,
.memo-filter-urgency-chip.is-selected:hover:enabled {
    background-color: rgb(76, 90, 133);
    border-color: rgb(76, 90, 133);
    color: rgb(255, 255, 255);
}

.memo-filter-chip.is-selected:active:enabled,
.memo-filter-urgency-chip.is-selected:active:enabled {
    background-color: rgb(66, 79, 119);
    border-color: rgb(66, 79, 119);
    color: rgb(255, 255, 255);
}

.page-overlay.is-admin-mode .memo-filter-chip.is-selected,
.page-overlay.is-admin-mode .memo-filter-urgency-chip.is-selected {
    background-color: var(--brand-pink);
    border-color: var(--brand-pink);
}

.page-overlay.is-admin-mode .memo-filter-chip.is-selected:hover:enabled,
.page-overlay.is-admin-mode .memo-filter-urgency-chip.is-selected:hover:enabled {
    background-color: var(--brand-pink-hover);
    border-color: var(--brand-pink-hover);
}

.page-overlay.is-admin-mode .memo-filter-chip.is-selected:active:enabled,
.page-overlay.is-admin-mode .memo-filter-urgency-chip.is-selected:active:enabled {
    background-color: var(--brand-pink-active);
    border-color: var(--brand-pink-active);
}

.memo-filter-select-button {
    height: 110px;
    border-width: 2px;
    border-color: rgb(221, 221, 221);
    border-radius: 55px;
    background-color: rgb(255, 255, 255);
    padding-left: 46px;
    padding-right: 36px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    transition-property: background-color, border-color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.memo-filter-select-text {
    font-size: 34px;
    color: rgb(48, 48, 48);
}

.memo-filter-select-chevron {
    width: 38px;
    height: 38px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/chevron_forward.png?fileID=2800000&guid=3ca432206e7cabb45abd1dfc722e509d&type=3#chevron_forward");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(176, 176, 176);
    rotate: 180deg;
}

.memo-filter-map-list {
    margin-top: 34px;
    border-width: 1px;
    border-color: rgb(230, 230, 230);
    border-radius: 36px;
    background-color: rgb(255, 255, 255);
    padding-top: 34px;
    padding-bottom: 34px;
    display: flex;
}

.memo-filter-map-item {
    min-height: 78px;
    height: 78px;
    padding-left: 46px;
    justify-content: center;
}

.memo-filter-map-item.scan-address-list-item {
    min-height: 78px;
    height: 78px;
    margin-left: 28px;
    margin-right: 28px;
    padding-left: 46px;
    padding-right: 46px;
    border-radius: 18px;
    background-color: rgb(255, 255, 255);
}

.memo-filter-map-divider {
    height: 1px;
    margin-left: 34px;
    margin-right: 34px;
    background-color: rgb(238, 238, 238);
}

.memo-filter-map-item .scan-address-list-text {
    font-size: 34px;
    color: rgb(52, 52, 52);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
}

.memo-filter-map-item.is-selected {
    color: rgb(83, 94, 131);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.memo-filter-map-item.is-selected .scan-address-list-text {
    color: rgb(83, 94, 131);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.page-overlay.is-admin-mode .memo-filter-map-item.is-selected {
    color: var(--brand-pink);
}

.page-overlay.is-admin-mode .memo-filter-map-item.is-selected .scan-address-list-text {
    color: var(--brand-pink);
}

.memo-filter-urgency-chip {
    flex-grow: 1;
    flex-basis: 0;
    height: 100px;
    margin-right: 2%;
    border-width: 2px;
    border-color: rgb(221, 221, 221);
    border-radius: 50px;
    background-color: rgb(255, 255, 255);
    color: rgb(48, 48, 48);
    font-size: 34px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.nav-action-bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    height: auto;
    padding-top: 24px;
    padding-right: 24px;
    padding-bottom: 24px;
    padding-left: 24px;
    border-radius: var(--nav-bar-radius);
    background-color: var(--nav-bg);
    flex-direction: row;
    align-items: center;
}

.nav-action-button {
    flex-grow: 1;
    height: 152px;
    border-radius: 64px;
    color: rgb(255, 255, 255);
    font-size: 48px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
    transition-property: background-color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.nav-action-bar .nav-action-button {
    width: 0;
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

.nav-action-secondary {
    margin-right: 12px;
    background-color: rgb(124, 110, 114);
}

.nav-action-secondary:hover:enabled {
    background-color: rgb(113, 100, 104);
}

.nav-action-secondary:active:enabled {
    background-color: rgb(101, 89, 93);
}

.nav-action-primary {
    margin-left: 12px;
    background-color: rgb(184, 29, 62);
}

.nav-action-bar.is-single-action .nav-action-primary {
    margin-left: 0;
}

.nav-action-primary:hover:enabled {
    background-color: rgb(171, 25, 56);
}

.nav-action-primary:active:enabled {
    background-color: rgb(154, 22, 50);
}

.memo-search-page {
    background-color: rgb(255, 255, 255);
    padding-left: 60px;
    padding-right: 60px;
}

.memo-search-header {
    height: 110px;
    border-bottom-width: 0;
    justify-content: flex-start;
}

.memo-search-header .page-back-button {
    position: relative;
    left: 0;
    margin-right: 22px;
    flex-shrink: 0;
}

.memo-search-page .memo-search-input-box {
    flex-grow: 1;
    height: 110px;
    border-radius: 55px;
    background-color: rgb(246, 246, 246);
    margin-left: 0;
    padding-left: 38px;
    padding-right: 112px;
}

.memo-search-page-clear-button {
    position: absolute;
    right: 11px;
    top: 11px;
    width: 88px;
    height: 88px;
}

.memo-search-history-section {
    padding-top: 92px;
    padding-bottom: 0;
}

.memo-search-history-row {
    height: 86px;
    flex-direction: row;
    align-items: center;
}

.memo-search-history-content {
    flex-grow: 1;
    min-width: 0;
    height: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-left: 18px;
    padding-right: 18px;
    border-radius: 28px;
}

.memo-search-history-content:hover:enabled {
    background-color: rgb(248, 248, 248);
    border-color: transparent;
}

.memo-search-history-content:active:enabled {
    background-color: rgb(236, 236, 236);
    border-color: transparent;
}

.memo-search-history-icon {
    width: 38px;
    height: 38px;
    margin-right: 26px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/tabler_clock.png?fileID=2800000&guid=9f748a7700dd0f74da95ba8e51f28b73&type=3#tabler_clock");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(124, 124, 124);
}

.memo-search-history-query {
    flex-grow: 1;
    min-width: 0;
    font-size: 42px;
    color: rgb(28, 28, 28);
    -unity-text-align: middle-left;
    overflow: hidden;
    -unity-text-overflow-position: end;
}

.memo-search-history-date {
    width: 105px;
    font-size: 32px;
    color: rgb(178, 178, 178);
    -unity-text-align: middle-right;
}

.memo-search-history-remove {
    margin-left: 18px;
