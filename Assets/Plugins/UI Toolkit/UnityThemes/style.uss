.splash-root .splash-panel {
    display: flex;
    opacity: 1;
    visibility: visible;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.28s;
    transition-timing-function: ease-out;
}

.splash-root .splash-panel.is-hidden {
    display: flex;
    opacity: 0;
    visibility: hidden;
    translate: 0 28px;
}

.splash-root .splash-action-button {
    position: relative;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.splash-root .splash-login-icon {
    position: absolute;
    left: 44px;
    width: 48px;
    height: 48px;
    margin-right: 0;
