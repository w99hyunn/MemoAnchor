}

.map-reconstruction-memo-card.is-completion-requested .map-reconstruction-memo-card-open {
    background-color: rgb(232, 58, 81);
}

.map-reconstruction-memo-card.is-completion-requested .map-reconstruction-memo-card-open-icon {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.map-reconstruction-memo-card.is-concealed {
    visibility: hidden;
}

.map-reconstruction-memo-card-stem.is-concealed {
    visibility: hidden;
}

.map-reconstruction-memo-card-header {
    height: 54px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.map-reconstruction-memo-card-kind {
    width: 52px;
    height: 52px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.map-reconstruction-memo-card-open {
    width: 54px;
    height: 54px;
    border-radius: 27px;
    background-color: rgba(255, 255, 255, 0.88);
    align-items: center;
    justify-content: center;
}

.map-reconstruction-memo-card-open-icon {
    width: 30px;
    height: 30px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/right_arrow.png?fileID=2800000&guid=cadbdb304307a2f4488fb68a287323c0&type=3#right_arrow");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(30, 30, 34);
    rotate: -45deg;
}

.map-reconstruction-memo-card-title {
    flex-grow: 1;
    margin-top: 34px;
    color: rgb(255, 255, 255);
    font-size: 48px;
    white-space: normal;
    -unity-text-align: upper-left;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.map-reconstruction-memo-card-stem {
