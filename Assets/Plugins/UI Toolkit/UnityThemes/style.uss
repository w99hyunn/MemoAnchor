    visibility: hidden;
}

.map-participants-overlay.scan-address-dialog-overlay {
    justify-content: flex-end;
    background-color: rgba(0, 0, 0, 0.28);
}

.map-participants-sheet.scan-address-dialog-sheet {
    min-height: 780px;
    max-height: 1100px;
    padding-top: 34px;
    padding-right: 20px;
    padding-bottom: 42px;
    padding-left: 20px;
    overflow: hidden;
}

.map-participants-sheet .scan-address-dialog-handle {
    width: 82px;
    height: 5px;
    margin-top: 0;
    margin-bottom: 10px;
}

.map-participants-invite-header {
