.memo-filter-section {
    flex-grow: 0;
    padding-top: 70px;
    padding-bottom: 45px;
}

.memo-filter-section-title {
    font-size: 42px;
    color: rgb(68, 68, 68);
    margin-bottom: 42px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
}

.memo-filter-divider {
    height: 1px;
    background-color: rgb(228, 228, 228);
}

.memo-filter-date-row {
    height: 110px;
    flex-direction: row;
    align-items: center;
}

.memo-filter-date-button {
    flex-grow: 1;
    flex-basis: 0;
    height: 110px;
    border-width: 2px;
    border-color: rgb(219, 219, 219);
    border-radius: 55px;
    background-color: rgb(255, 255, 255);
    flex-direction: row;
    align-items: center;
    justify-content: center;
    transition-property: background-color, border-color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.memo-filter-date-button:hover:enabled {
    background-color: rgb(248, 248, 248);
    border-color: rgb(194, 194, 194);
}

.memo-filter-date-button:active:enabled {
    background-color: rgb(239, 239, 239);
    border-color: rgb(170, 170, 170);
}

.memo-filter-date-button.is-selected {
    border-color: rgb(86, 99, 142);
}

.memo-filter-date-button.is-selected:hover:enabled {
    background-color: rgb(246, 247, 252);
    border-color: rgb(76, 90, 133);
}

.memo-filter-date-button.is-selected:active:enabled {
    background-color: rgb(235, 238, 248);
    border-color: rgb(66, 79, 119);
}

.memo-filter-page.is-admin-mode .memo-filter-date-button.is-selected {
    border-color: var(--brand-pink);
}

.memo-filter-page.is-admin-mode .memo-filter-date-button.is-selected:hover:enabled {
    background-color: rgb(255, 246, 249);
    border-color: var(--brand-pink-hover);
}

.memo-filter-page.is-admin-mode .memo-filter-date-button.is-selected:active:enabled {
    background-color: rgb(255, 235, 241);
    border-color: var(--brand-pink-active);
}

.memo-filter-date-button.is-error {
    border-color: rgb(236, 60, 85);
}

.memo-filter-date-button.is-error:hover:enabled {
    background-color: rgb(255, 247, 249);
    border-color: rgb(236, 60, 85);
}

.memo-filter-date-button.is-error:active:enabled {
    background-color: rgb(255, 235, 239);
    border-color: rgb(210, 44, 70);
}

.memo-filter-date-text {
    font-size: 34px;
    color: rgb(88, 88, 88);
}

.memo-filter-date-button.is-selected .memo-filter-date-text {
    color: rgb(28, 28, 28);
}

.memo-filter-date-button.is-error .memo-filter-date-text {
    color: rgb(236, 60, 85);
}

.memo-filter-calendar-icon {
    width: 34px;
    height: 34px;
    margin-left: 18px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/calendar_month.png?fileID=2800000&guid=b1dcfd6da9be6544b8081fdc92d97423&type=3#calendar_month");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(84, 84, 84);
}

.memo-filter-date-button.is-selected .memo-filter-calendar-icon {
    -unity-background-image-tint-color: rgb(86, 99, 142);
}

.memo-filter-page.is-admin-mode .memo-filter-date-button.is-selected .memo-filter-calendar-icon {
    -unity-background-image-tint-color: var(--brand-pink);
}

.memo-filter-date-button.is-error .memo-filter-calendar-icon {
    -unity-background-image-tint-color: rgb(236, 60, 85);
}

.memo-filter-date-dash {
    width: 72px;
    height: 2px;
    margin-left: 22px;
    margin-right: 22px;
    background-color: rgb(190, 190, 190);
    -unity-text-align: middle-center;
    font-size: 0;
    color: rgba(0, 0, 0, 0);
}

.memo-filter-check-button {
    width: 64px;
    height: 64px;
    margin-left: 24px;
    border-radius: 10px;
    background-color: rgb(210, 210, 210);
    align-items: center;
    justify-content: center;
    transition-property: background-color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.memo-filter-check-button:hover:enabled {
    background-color: rgb(190, 190, 190);
}

.memo-filter-check-button:active:enabled {
    background-color: rgb(170, 170, 170);
}

.memo-filter-check-button.is-selected {
    background-color: rgb(90, 90, 90);
}

.memo-filter-check-button.is-selected:hover:enabled {
    background-color: rgb(76, 76, 76);
}

.memo-filter-check-button.is-selected:active:enabled {
    background-color: rgb(60, 60, 60);
}

.memo-filter-page.is-admin-mode .memo-filter-check-button.is-selected {
    background-color: var(--brand-pink);
}

.memo-filter-page.is-admin-mode .memo-filter-check-button.is-selected:hover:enabled {
    background-color: var(--brand-pink-hover);
}

.memo-filter-page.is-admin-mode .memo-filter-check-button.is-selected:active:enabled {
    background-color: var(--brand-pink-active);
}

.memo-filter-check-icon {
    width: 42px;
    height: 42px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/check.png?fileID=2800000&guid=cc44cf71ac7687d4c82692e2f8ff010c&type=3#check");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.memo-filter-calendar {
    margin-top: 34px;
    border-width: 2px;
    border-color: rgb(86, 99, 142);
    border-radius: 36px;
    background-color: rgb(255, 255, 255);
    padding-top: 34px;
    padding-right: 40px;
    padding-bottom: 40px;
    padding-left: 40px;
    display: flex;
}

.memo-filter-calendar.is-hidden {
    display: none;
}

.memo-filter-calendar.is-error {
    border-color: rgb(236, 60, 85);
}

.memo-filter-page.is-admin-mode .memo-filter-calendar {
    border-color: var(--brand-pink);
}

.memo-filter-page.is-admin-mode .memo-filter-calendar.is-error {
    border-color: rgb(236, 60, 85);
}

.memo-filter-calendar-header {
    height: 64px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 28px;
}

.memo-filter-calendar-title {
    width: 280px;
    -unity-text-align: middle-center;
    font-size: 34px;
    color: rgb(28, 28, 28);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.memo-filter-calendar-nav,
.memo-filter-calendar-close {
    width: 64px;
    height: 64px;
    color: rgb(86, 86, 86);
    border-radius: 32px;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    transition-property: background-color, color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.memo-filter-calendar-nav:hover:enabled,
.memo-filter-calendar-close:hover:enabled {
    background-color: rgb(244, 244, 244);
    border-color: transparent;
}

.memo-filter-calendar-nav:active:enabled,
.memo-filter-calendar-close:active:enabled {
    background-color: rgb(230, 230, 230);
    border-color: transparent;
    color: rgb(36, 36, 36);
}

.memo-filter-calendar-close {
    position: absolute;
    top: 0;
    right: 0;
    width: 64px;
    height: 64px;
    color: rgb(170, 170, 170);
}

.memo-calendar-header-button-label {
    width: 64px;
    height: 64px;
    font-size: 42px;
    color: inherit;
    -unity-text-align: middle-center;
    align-self: center;
}

.memo-calendar-close-icon {
    width: 44px;
    height: 44px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/xbutton.png?fileID=2800000&guid=ec503318264761140bef84a89627b643&type=3#xbutton");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(170, 170, 170);
}

.memo-filter-calendar-close:active:enabled .memo-calendar-close-icon {
    -unity-background-image-tint-color: rgb(36, 36, 36);
}

.memo-calendar-chevron {
    width: 34px;
    height: 34px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/chevron_forward.png?fileID=2800000&guid=3ca432206e7cabb45abd1dfc722e509d&type=3#chevron_forward");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(86, 86, 86);
}

.memo-calendar-chevron.is-prev {
    rotate: 0;
}

.memo-calendar-chevron.is-next {
    rotate: 180deg;
}

.memo-filter-calendar-nav:active:enabled .memo-calendar-chevron {
    -unity-background-image-tint-color: rgb(36, 36, 36);
}

.memo-filter-calendar-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.memo-filter-calendar-cell {
    width: 14.2857%;
    height: 70px;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    color: rgb(48, 48, 48);
    transition-property: background-color, color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
    border-radius: 35px;
}

.memo-filter-calendar-cell:hover:enabled {
    background-color: rgb(245, 245, 245);
    border-color: transparent;
}

.memo-filter-calendar-cell:active:enabled {
    background-color: rgb(232, 232, 232);
    border-color: transparent;
}

.memo-filter-calendar-cell.is-weekday-header {
    color: rgb(140, 140, 140);
    font-size: 28px;
}

.memo-filter-calendar-cell.is-sunday {
    color: rgb(236, 60, 85);
}

.memo-filter-calendar-cell.is-saturday {
    color: rgb(86, 122, 210);
}

.memo-filter-calendar-cell.is-muted {
    color: rgb(194, 194, 194);
}

.memo-filter-calendar-cell.is-selected {
    color: rgb(255, 255, 255);
    background-color: rgb(86, 99, 142);
    border-radius: 35px;
}

.memo-filter-calendar-cell.is-selected:hover:enabled {
    background-color: rgb(76, 90, 133);
}

.memo-filter-calendar-cell.is-selected:active:enabled {
    background-color: rgb(66, 79, 119);
}

.memo-filter-page.is-admin-mode .memo-filter-calendar-cell.is-selected {
    background-color: var(--brand-pink);
}

.memo-filter-page.is-admin-mode .memo-filter-calendar-cell.is-selected:hover:enabled {
    background-color: var(--brand-pink-hover);
}

.memo-filter-page.is-admin-mode .memo-filter-calendar-cell.is-selected:active:enabled {
    background-color: var(--brand-pink-active);
}

.memo-filter-calendar.is-error .memo-filter-calendar-cell.is-selected {
    background-color: rgb(236, 60, 85);
}

.memo-filter-chip-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.memo-filter-chip {
    width: 48%;
    height: 110px;
    margin-right: 2%;
    margin-bottom: 22px;
    border-width: 2px;
    border-color: rgb(221, 221, 221);
    border-radius: 55px;
    background-color: rgb(255, 255, 255);
    color: rgb(48, 48, 48);
    font-size: 34px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.memo-filter-chip:hover:enabled,
.memo-filter-urgency-chip:hover:enabled,
.memo-filter-select-button:hover:enabled {
    background-color: rgb(248, 248, 248);
    border-color: rgb(194, 194, 194);
}

.memo-filter-chip:active:enabled,
.memo-filter-urgency-chip:active:enabled,
.memo-filter-select-button:active:enabled {
    background-color: rgb(239, 239, 239);
    border-color: rgb(170, 170, 170);
}

.memo-filter-chip.is-selected,
.memo-filter-urgency-chip.is-selected {
    background-color: rgb(86, 99, 142);
    border-color: rgb(86, 99, 142);
    color: rgb(255, 255, 255);
}

.memo-filter-chip.is-selected:hover:enabled,
.memo-filter-urgency-chip.is-selected:hover:enabled {
    background-color: rgb(76, 90, 133);
    border-color: rgb(76, 90, 133);
    color: rgb(255, 255, 255);
}

.memo-filter-chip.is-selected:active:enabled,
.memo-filter-urgency-chip.is-selected:active:enabled {
    background-color: rgb(66, 79, 119);
    border-color: rgb(66, 79, 119);
    color: rgb(255, 255, 255);
}

.memo-filter-page.is-admin-mode .memo-filter-chip.is-selected,
.memo-filter-page.is-admin-mode .memo-filter-urgency-chip.is-selected {
    background-color: var(--brand-pink);
    border-color: var(--brand-pink);
}

.memo-filter-page.is-admin-mode .memo-filter-chip.is-selected:hover:enabled,
.memo-filter-page.is-admin-mode .memo-filter-urgency-chip.is-selected:hover:enabled {
    background-color: var(--brand-pink-hover);
    border-color: var(--brand-pink-hover);
}

.memo-filter-page.is-admin-mode .memo-filter-chip.is-selected:active:enabled,
.memo-filter-page.is-admin-mode .memo-filter-urgency-chip.is-selected:active:enabled {
    background-color: var(--brand-pink-active);
    border-color: var(--brand-pink-active);
}

.memo-filter-select-button {
    height: 110px;
    border-width: 2px;
    border-color: rgb(221, 221, 221);
    border-radius: 55px;
    background-color: rgb(255, 255, 255);
    padding-left: 46px;
    padding-right: 36px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    transition-property: background-color, border-color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.memo-filter-select-text {
    font-size: 34px;
    color: rgb(48, 48, 48);
}

.memo-filter-select-chevron {
    width: 38px;
    height: 38px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/chevron_forward.png?fileID=2800000&guid=3ca432206e7cabb45abd1dfc722e509d&type=3#chevron_forward");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(176, 176, 176);
    rotate: 180deg;
}

.memo-filter-map-list {
    margin-top: 34px;
    border-width: 1px;
    border-color: rgb(230, 230, 230);
    border-radius: 36px;
    background-color: rgb(255, 255, 255);
    padding-top: 34px;
    padding-bottom: 34px;
    display: flex;
}

.memo-filter-map-list.is-hidden {
    display: none;
}

.memo-filter-map-item {
    min-height: 78px;
    height: 78px;
    padding-left: 46px;
    justify-content: center;
}

.memo-filter-map-item.scan-address-list-item {
    min-height: 78px;
    height: 78px;
    margin-left: 28px;
    margin-right: 28px;
    padding-left: 46px;
    padding-right: 46px;
    border-radius: 18px;
    background-color: rgb(255, 255, 255);
}

.memo-filter-map-divider {
    height: 1px;
    margin-left: 34px;
    margin-right: 34px;
    background-color: rgb(238, 238, 238);
}

.memo-filter-map-item .scan-address-list-text {
    font-size: 34px;
    color: rgb(52, 52, 52);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
}

.memo-filter-map-item.is-selected {
    color: rgb(86, 99, 142);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.memo-filter-map-item.is-selected .scan-address-list-text {
    color: rgb(86, 99, 142);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.memo-filter-page.is-admin-mode .memo-filter-map-item.is-selected {
    color: var(--brand-pink);
}

.memo-filter-page.is-admin-mode .memo-filter-map-item.is-selected .scan-address-list-text {
    color: var(--brand-pink);
}

.memo-filter-urgency-row {
    flex-direction: row;
    align-items: center;
}

.memo-filter-urgency-chip {
    flex-grow: 1;
    flex-basis: 0;
    height: 100px;
    margin-right: 2%;
    border-width: 2px;
    border-color: rgb(221, 221, 221);
    border-radius: 50px;
    background-color: rgb(255, 255, 255);
    color: rgb(48, 48, 48);
    font-size: 34px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.nav-action-bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    height: auto;
    padding-top: 24px;
    padding-right: 24px;
    padding-bottom: 24px;
    padding-left: 24px;
    border-radius: var(--nav-bar-radius);
    background-color: var(--nav-bg);
    flex-direction: row;
    align-items: center;
}

.nav-action-bar.is-hidden {
    display: none;
}

.nav-action-button {
    flex-grow: 1;
    height: 152px;
    border-radius: 64px;
    color: rgb(255, 255, 255);
    font-size: 42px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
    transition-property: background-color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.memo-trash-bottom-bar .nav-action-button {
    width: 0;
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

.nav-action-secondary {
    margin-right: 12px;
    background-color: rgb(124, 110, 114);
}

.nav-action-secondary:hover:enabled {
    background-color: rgb(113, 100, 104);
}

.nav-action-secondary:active:enabled {
    background-color: rgb(101, 89, 93);
}

.nav-action-primary {
    margin-left: 12px;
    background-color: rgb(184, 29, 62);
}

.nav-action-primary:hover:enabled {
    background-color: rgb(171, 25, 56);
}

.nav-action-primary:active:enabled {
    background-color: rgb(154, 22, 50);
}

.memo-search-page {
    background-color: rgb(255, 255, 255);
    padding-left: 60px;
    padding-right: 60px;
}

.memo-search-header {
    height: 110px;
    border-bottom-width: 0;
    justify-content: flex-start;
}

.memo-search-header .memo-filter-back-button {
    position: relative;
    left: 0;
    margin-right: 22px;
    flex-shrink: 0;
}

.memo-search-page .memo-search-input-box {
    flex-grow: 1;
    height: 110px;
    border-radius: 55px;
    background-color: rgb(246, 246, 246);
    margin-left: 0;
    padding-left: 38px;
    padding-right: 112px;
}

.memo-search-page-clear-button {
    position: absolute;
    right: 11px;
    top: 11px;
    width: 88px;
    height: 88px;
}

.memo-search-page-clear-button.is-hidden {
    display: none;
}

.memo-search-history-section {
    padding-top: 92px;
    padding-bottom: 0;
}

.memo-search-history-section.is-hidden {
    display: none;
}

.memo-search-history-row {
    height: 86px;
    flex-direction: row;
    align-items: center;
}

.memo-search-history-content {
    flex-grow: 1;
    min-width: 0;
    height: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-left: 18px;
    padding-right: 18px;
    border-radius: 28px;
}

.memo-search-history-content:hover:enabled {
    background-color: rgb(248, 248, 248);
    border-color: transparent;
}

.memo-search-history-content:active:enabled {
    background-color: rgb(236, 236, 236);
    border-color: transparent;
}

.memo-search-history-icon {
    width: 38px;
    height: 38px;
    margin-right: 26px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/tabler_clock.png?fileID=2800000&guid=9f748a7700dd0f74da95ba8e51f28b73&type=3#tabler_clock");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(124, 124, 124);
}

.memo-search-history-query {
    flex-grow: 1;
    min-width: 0;
    font-size: 42px;
    color: rgb(28, 28, 28);
    -unity-text-align: middle-left;
    overflow: hidden;
    -unity-text-overflow-position: end;
}

.memo-search-history-date {
    width: 105px;
    font-size: 32px;
    color: rgb(178, 178, 178);
    -unity-text-align: middle-right;
}

.memo-search-history-remove {
    margin-left: 18px;
}

.memo-search-history-remove-icon {
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/xbutton.png?fileID=2800000&guid=ec503318264761140bef84a89627b643&type=3#xbutton");
}

.memo-search-empty-label {
    margin-top: 4px;
    font-size: 34px;
    color: rgb(168, 168, 168);
}

.memo-search-empty-label.is-hidden {
    display: none;
}

.memo-search-no-result-label {
    height: 96px;
    margin-top: 92px;
    margin-left: 60px;
    margin-right: 60px;
    -unity-text-align: middle-center;
}

.memo-search-result-section {
    flex-grow: 1;
    margin-top: 42px;
    margin-left: -60px;
    margin-right: -60px;
}

.memo-search-result-section.is-hidden {
    display: none;
}

.memo-search-result-list {
    flex-grow: 0;
}

.memo-search-result-row {
    height: 350px;
    position: relative;
    overflow: hidden;
    background-color: rgb(255, 255, 255);
}

.memo-search-result-item {
    translate: 0 0;
}

.memo-search-result-title-row {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    margin-bottom: 50px;
}

.memo-search-result-title-wrap {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    min-width: 0;
}

.memo-create-scroll {
    flex-grow: 1;
    min-height: 0;
    padding-left: 50px;
    padding-right: 50px;
    padding-bottom: 218px;
}

.memo-create-section {
    padding-top: 34px;
    padding-bottom: 34px;
}

.memo-create-repairer-card {
    margin-top: 18px;
    margin-bottom: 0;
}

.memo-create-repairer-card .profile-row-title {
    flex-grow: 1;
    -unity-text-align: middle-left;
}

.memo-create-repairer-card .profile-friend-name {
    -unity-text-align: middle-left;
}

.memo-create-repairer-card .profile-friend-list {
    border-top-width: 0;
}

.memo-create-repairer-card .profile-friend-row.is-first {
    border-top-width: 0;
}

.memo-create-title-box {
    margin-top: 18px;
}

.memo-create-title-box.is-hidden,
.memo-create-body-box.is-hidden {
    display: none;
}

.memo-create-checklist-content {
    margin-top: 22px;
}

.memo-create-checklist-content.is-hidden {
    display: none;
}

.memo-create-checklist-list {
    flex-grow: 0;
}

.memo-create-checklist-row {
    height: 110px;
    margin-bottom: 22px;
    flex-direction: row;
    align-items: center;
}

.memo-create-checklist-input-box {
    flex-grow: 1;
    height: 110px;
}

.memo-create-checklist-row .memo-filter-calendar-close {
    position: absolute;
    right: 22px;
    top: 23px;
}

.memo-create-checklist-add-button {
    height: 110px;
    border-width: 2px;
    border-color: rgb(219, 219, 219);
    border-radius: 55px;
    background-color: rgb(255, 255, 255);
    flex-direction: row;
    align-items: center;
    justify-content: center;
    transition-property: background-color, border-color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.memo-create-checklist-add-button:hover:enabled {
    background-color: rgb(248, 248, 248);
    border-color: rgb(194, 194, 194);
}

.memo-create-checklist-add-button:active:enabled {
    background-color: rgb(239, 239, 239);
    border-color: rgb(170, 170, 170);
}

.memo-create-checklist-add-label {
    font-size: 34px;
    color: rgb(28, 28, 28);
    -unity-text-align: middle-center;
}

.memo-create-checklist-add-button .scan-address-add-icon {
    position: absolute;
    right: 42px;
    margin-right: 0;
    color: rgb(184, 184, 184);
}

.memo-create-calendar {
    margin-top: 20px;
}

.memo-create-time-picker {
    height: 360px;
    margin-top: 20px;
    overflow: hidden;
}

.memo-create-time-picker.is-hidden {
    display: none;
}

.memo-create-loading-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    opacity: 0;
    align-items: center;
    justify-content: center;
    transition-property: opacity;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.memo-create-loading-overlay.is-hidden {
    display: none;
}

.memo-create-loading-overlay.is-open {
    opacity: 1;
}

.memo-create-loading-spinner {
    width: 96px;
    height: 96px;
    background-color: rgba(0, 0, 0, 0);
}

.memo-create-time-header-spacer {
    visibility: hidden;
}

.memo-create-time-selected-band {
    position: absolute;
    left: 40px;
    right: 40px;
    top: 142px;
    height: 70px;
    background-color: rgb(240, 240, 240);
}

.memo-create-time-columns {
    height: 292px;
    flex-direction: row;
}

.memo-create-time-column {
    flex-grow: 1;
    flex-basis: 0;
    height: 292px;
}

.memo-create-time-column .unity-scroll-view__content-container {
    padding-top: 36px;
    padding-bottom: 186px;
}

.memo-create-time-option {
    height: 70px;
    font-size: 36px;
    color: rgb(178, 178, 178);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
}

.memo-create-time-option:hover:enabled {
    background-color: rgba(0, 0, 0, 0);
    border-color: transparent;
    color: rgb(80, 80, 80);
}

.memo-create-time-option:active:enabled {
    background-color: rgba(0, 0, 0, 0);
    border-color: transparent;
    color: rgb(20, 20, 20);
}

.memo-create-time-option.is-selected {
    color: rgb(20, 20, 20);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.memo-create-urgency-grid {
    margin-top: 22px;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: space-between;
}

.memo-create-urgency-grid .memo-filter-chip {
    width: 30%;
    margin-right: 0;
}

.memo-create-time-icon {
    width: 34px;
    height: 34px;
    margin-left: 16px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/tabler_clock.png?fileID=2800000&guid=9f748a7700dd0f74da95ba8e51f28b73&type=3#tabler_clock");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(35, 35, 35);
}

.profile-tab-page {
    background-color: rgb(246, 246, 246);
}

.profile-main-content.is-hidden,
.profile-account-settings-page.is-hidden {
    display: none;
}

.profile-page-title {
    font-size: 58px;
    color: rgb(28, 28, 28);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.profile-content {
    flex-grow: 0;
}

.profile-card {
    flex-grow: 0;
    background-color: rgb(255, 255, 255);
    border-radius: 42px;
    margin-bottom: 38px;
    padding-left: 62px;
    padding-right: 62px;
}

.profile-summary-card {
    height: 260px;
    justify-content: center;
}

.profile-summary-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 34px;
}

.profile-name-label {
    flex-grow: 1;
    min-width: 0;
    margin-right: 28px;
    font-size: 46px;
    color: rgb(22, 22, 22);
    overflow: hidden;
    -unity-text-overflow-position: end;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.profile-settings-button {
    flex-shrink: 0;
}

.profile-meta-row {
    flex-direction: row;
    align-items: center;
}

.profile-company-label {
    font-size: 36px;
    color: rgb(178, 178, 178);
}

.profile-meta-divider {
    width: 3px;
    height: 48px;
    margin-left: 28px;
    margin-right: 28px;
    background-color: rgb(190, 190, 190);
}

.profile-role-chip {
    height: 54px;
    min-width: 116px;
    margin-right: 16px;
    padding-left: 24px;
    padding-right: 24px;
    border-radius: 27px;
    background-color: rgb(86, 99, 142);
    color: rgb(255, 255, 255);
    font-size: 30px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.profile-toggle-row {
    height: 158px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.profile-friend-list-card {
    padding-top: 0;
    padding-bottom: 0;
    overflow: hidden;
}

.profile-friend-list-card.is-selected {
    padding-bottom: 20px;
}

.profile-menu-row {
    height: 158px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.profile-menu-row:hover:enabled {
    background-color: rgb(252, 252, 252);
    border-color: transparent;
}

.profile-menu-row:active:enabled {
    background-color: rgb(242, 242, 242);
    border-color: transparent;
}

.profile-friend-list-button {
    margin-left: -62px;
    margin-right: -62px;
    padding-left: 62px;
    padding-right: 62px;
}

.profile-friend-list-actions {
    flex-direction: row;
    align-items: center;
}

.profile-friend-add-button {
    margin-right: 24px;
}

.profile-row-title {
    font-size: 38px;
    color: rgb(20, 20, 20);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.profile-row-chevron {
    width: 36px;
    height: 36px;
    rotate: -90deg;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(110, 110, 110);
    transition-property: rotate;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

.profile-row-chevron.is-selected {
    rotate: 90deg;
}

.profile-friend-list {
    flex-grow: 0;
    border-top-width: 1px;
    border-top-color: rgb(232, 232, 232);
}

.profile-friend-list.is-hidden {
    display: none;
}

.profile-friend-items-list {
    flex-grow: 0;
}

.profile-friend-row {
    height: 112px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgb(232, 232, 232);
}

.profile-friend-name {
    flex-grow: 1;
    min-width: 0;
    font-size: 36px;
    color: rgb(32, 32, 32);
}

.profile-friend-company {
    flex-grow: 1;
    min-width: 0;
    font-size: 28px;
    color: rgb(174, 174, 174);
}

.profile-friend-delete-button {
    width: 78px;
    height: 78px;
    border-radius: 39px;
    background-color: rgb(86, 99, 142);
    align-items: center;
    justify-content: center;
}

.profile-friend-delete-button:hover:enabled {
    background-color: rgb(76, 90, 133);
    border-color: transparent;
}

.profile-friend-delete-button:active:enabled {
    background-color: rgb(66, 79, 119);
    border-color: transparent;
}

.profile-friend-delete-icon {
    width: 46px;
    height: 46px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/trash.png?fileID=2800000&guid=c2fd465122bc15242b8cf6da00d7bbb1&type=3#trash");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.profile-switch {
    width: 150px;
    height: 68px;
    margin: 0;
    padding: 6px;
    border-width: 0;
    border-radius: 34px;
    background-color: rgb(218, 218, 218);
    align-items: flex-start;
    justify-content: center;
}

.profile-switch:hover:enabled {
    background-color: rgb(210, 210, 210);
    border-color: transparent;
}

.profile-switch:active:enabled {
    background-color: rgb(200, 200, 200);
    border-color: transparent;
}

.profile-switch-thumb {
    width: 56px;
    height: 56px;
    margin: 0;
    border-radius: 28px;
    background-color: rgb(184, 184, 184);
    align-self: flex-start;
    translate: 0 0;
    transition-property: translate, background-color;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.profile-switch.is-selected {
    background-color: rgb(218, 218, 218);
}

.profile-switch.is-selected .profile-switch-thumb {
    translate: 82px 0;
    background-color: rgb(86, 99, 142);
}

.profile-account-settings-page {
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.profile-account-settings-list {
    background-color: rgba(0, 0, 0, 0);
}

.profile-account-settings-row {
    background-color: rgb(255, 255, 255);
    padding-left: 46px;
    padding-right: 50px;
}

.profile-account-settings-logout-row {
    margin-top: 16px;
}

.profile-account-settings-row:hover:enabled {
    background-color: rgb(252, 252, 252);
}

.profile-account-settings-row:active:enabled {
    background-color: rgb(242, 242, 242);
}

.profile-account-settings-row:disabled {
    background-color: rgb(255, 255, 255);
}

.profile-account-settings-row:disabled .profile-account-settings-row-text {
    color: rgb(42, 42, 42);
}

.profile-account-settings-row-chevron {
    rotate: 180deg;
    -unity-background-image-tint-color: rgb(188, 188, 188);
}

.profile-account-settings-row:disabled .profile-account-settings-row-chevron {
    -unity-background-image-tint-color: rgb(205, 205, 205);
}

.profile-account-settings-logout-text {
    color: rgb(255, 53, 87);
}

.common-confirm-popup-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding-left: 50px;
    padding-right: 50px;
    background-color: rgba(0, 0, 0, 0.48);
}

.common-confirm-popup-sheet {
    width: 88%;
    min-height: 420px;
    border-top-left-radius: 90px;
    border-top-right-radius: 90px;
    border-bottom-right-radius: 90px;
    border-bottom-left-radius: 90px;
    background-color: rgb(255, 255, 255);
    padding-top: 68px;
    padding-right: 58px;
    padding-bottom: 58px;
    padding-left: 58px;
}

.common-confirm-popup-title {
    font-size: 60px;
    color: rgb(49, 57, 73);
    margin-bottom: 34px;
    padding-left: 18px;
    padding-right: 18px;
    -unity-text-align: upper-left;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.common-confirm-popup-message {
    color: rgb(72, 82, 99);
    -unity-text-align: upper-left;
    white-space: normal;
    margin-bottom: 54px;
    padding-left: 18px;
    padding-right: 18px;
    font-size: 50px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Light.ttf?fileID=12800000&guid=8c634880071f83d4da7be3c9ff6f0be8&type=3#Pretendard-Light");
}

.common-confirm-input-section {
    padding-left: 0;
    padding-right: 0;
    margin-top: 18px;
    margin-bottom: 30px;
}

.common-confirm-input-section .memo-search-input-box {
    margin-left: 0;
    margin-right: 0;
}

.common-confirm-status-label {
    min-height: 38px;
    margin-left: 25px;
    margin-right: 25px;
    margin-bottom: 24px;
    font-size: 32px;
    color: rgb(236, 60, 85);
}

.common-confirm-status-label.is-hidden {
    display: none;
}

.common-confirm-popup-actions {
    width: 100%;
    flex-direction: row;
    margin-top: auto;
    margin-bottom: 0;
}

.common-confirm-popup-button {
    flex-grow: 1;
    height: 136px;
    margin-bottom: 0;
    justify-content: center;
    border-width: 0;
    border-radius: 40px;
    transition-property: background-color;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.common-confirm-cancel-button {
    margin-right: 10px;
    background-color: rgb(244, 246, 249);
}

.common-confirm-cancel-button:hover:enabled {
    background-color: rgb(237, 240, 245);
}

.common-confirm-cancel-button:active:enabled {
    background-color: rgb(228, 233, 241);
}

.common-confirm-submit-button {
    margin-left: 10px;
    background-color: var(--brand-pink);
}

.common-confirm-popup-actions.is-single-action .common-confirm-submit-button {
    margin-left: 0;
}

.common-confirm-submit-button:hover:enabled {
    background-color: var(--brand-pink-hover);
}

.common-confirm-submit-button:active:enabled {
    background-color: var(--brand-pink-active);
}

.common-confirm-popup-button-label {
    font-size: 44px;
    color: rgb(53, 61, 77);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.common-confirm-submit-label {
    color: rgb(255, 255, 255);
}

.splash-action-button {
    width: 100%;
    flex-grow: 0;
    margin-left: 0;
    margin-right: 0;
}

.splash-action-button.splash-login-button-kakao {
    background-color: rgb(254, 229, 0);
    color: rgb(25, 22, 0);
}

.scan-step-title {
    margin-top: 50px;
    font-size: 60px;
    color: rgb(68, 68, 68);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
}

.scan-field-group {
    margin-top: 60px;
}

.scan-field-label {
    margin-bottom: 12px;
    font-size: 45px;
    color: rgb(78, 78, 78);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
}

.scan-input-box {
    height: 120px;
    border-radius: 28px;
    background-color: rgb(255, 255, 255);
    justify-content: center;
    padding-left: 30px;
    padding-right: 30px;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    transition-property: border-left-color, border-right-color, border-top-color, border-bottom-color, background-color, translate;
    transition-duration: 0.08s;
    transition-timing-function: ease-out;
}

.scan-input-field {
    flex-grow: 1;
    height: 100%;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(84, 84, 84);
}

.scan-input-field .unity-base-field__input,
.scan-input-field .unity-base-text-field__input {
    height: 100%;
    margin: 0;
    padding: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(84, 84, 84);
    font-size: 42px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
}

.scan-input-field .unity-base-text-field__input--placeholder {
    color: rgb(186, 186, 186);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
}

.memo-create-body-box.scan-input-box {
    height: 380px;
    margin-top: 22px;
    align-items: stretch;
    justify-content: flex-start;
    padding-top: 28px;
    padding-bottom: 28px;
}

.memo-create-body-input.scan-input-field {
    flex-grow: 1;
    height: 100%;
    min-height: 324px;
    white-space: normal;
}

.memo-create-body-input.scan-input-field .unity-base-field__input,
.memo-create-body-input.scan-input-field .unity-base-text-field__input {
    height: 100%;
    min-height: 324px;
    white-space: normal;
    -unity-text-align: upper-left;
}

.memo-create-body-input.scan-input-field .unity-text-element {
    white-space: normal;
    -unity-text-align: upper-left;
}

.scan-select-button {
    flex-grow: 1;
    height: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 0;
    padding-right: 0;
}

.scan-select-button-text-field {
    flex-grow: 1;
    margin: 0;
    padding: 0;
}

.scan-select-button-text-field > .unity-text-field__input {
    padding-right: 16px;
}

.scan-select-button-arrow {
    margin-left: 24px;
    font-size: 68px;
    color: rgb(160, 160, 160);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
}

#scan-address-input-box,
#scan-space-name-input-box {
    position: relative;
}

#scan-address-input-box.is-error,
#scan-space-name-input-box.is-error {
    background-color: rgb(255, 247, 249);
}

#scan-address-input-box .signup-input-border,
#scan-space-name-input-box .signup-input-border {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-top-left-radius: 28px;
    border-top-right-radius: 28px;
    border-bottom-right-radius: 28px;
    border-bottom-left-radius: 28px;
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

#scan-address-input-box.is-error .signup-input-border,
#scan-space-name-input-box.is-error .signup-input-border {
    border-left-color: rgb(248, 128, 148);
    border-right-color: rgb(248, 128, 148);
    border-top-color: rgb(248, 128, 148);
    border-bottom-color: rgb(248, 128, 148);
}

.scan-action-dialog-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: flex-end;
    background-color: rgba(0, 0, 0, 0.6);
    padding-left: 40px;
    padding-right: 40px;
    padding-bottom: 40px;
    visibility: visible;
    padding-top: 40px;
    opacity: 1;
}

.scan-action-dialog-overlay.is-anim-ready {
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.24s;
    transition-timing-function: ease-out;
}

.scan-action-dialog-overlay.is-anim-ready.is-open {
    opacity: 1;
}

.scan-action-dialog-sheet {
    width: 100%;
    min-height: 760px;
    border-radius: 44px;
    background-color: rgb(255, 255, 255);
    padding-top: 30px;
    padding-right: 50px;
    padding-bottom: 50px;
    padding-left: 50px;
    translate: 0 0;
    border-top-left-radius: 90px;
    border-top-right-radius: 90px;
    border-bottom-right-radius: 90px;
    border-bottom-left-radius: 90px;
    opacity: 1;
}

.scan-action-dialog-overlay.is-anim-ready .scan-action-dialog-sheet {
    opacity: 0;
    translate: 0 48px;
    transition-property: opacity, translate;
    transition-duration: 0.24s;
    transition-timing-function: ease-out;
}

.scan-action-dialog-overlay.is-anim-ready.is-open .scan-action-dialog-sheet {
    opacity: 1;
    translate: 0 0;
}

.scan-action-dialog-handle {
    width: 96px;
    height: 8px;
    border-radius: 4px;
    background-color: rgb(224, 226, 230);
    align-self: center;
    margin-top: 10px;
    margin-bottom: 75px;
}

.scan-action-dialog-title {
    font-size: 52px;
    color: rgb(53, 61, 77);
    margin-bottom: 50px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
    padding-right: 25px;
    padding-left: 25px;
}

.scan-action-list {
    width: 100%;
    margin-bottom: 18px;
    border-radius: 0;
}

.scan-action-list-item {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    margin: 0;
    border-width: 0;
    min-height: 118px;
    padding-top: 50px;
    padding-bottom: 50px;
    padding-left: 25px;
    padding-right: 25px;
    border-radius: 50px;
    transition-property: background-color;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
    margin-bottom: 20px;
    background-color: rgba(255, 255, 255, 0);
}

.scan-action-list-item:active:enabled {
    background-color: rgb(228, 233, 241);
}

.scan-action-list-item:hover:enabled {
    background-color: rgb(237, 240, 245);
}

.scan-action-option-icon-slot {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background-color: rgb(255, 230, 234);
    margin-right: 50px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.scan-action-option-icon-placeholder {
    width: 26px;
    height: 26px;
    border-radius: 13px;
    background-color: rgb(255, 53, 87);
}

.scan-action-option-texts {
    flex-grow: 1;
    min-width: 0;
}

.scan-action-option-title {
    font-size: 50px;
    color: rgb(49, 57, 73);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
    -unity-text-align: upper-left;
}

.scan-action-option-description {
    margin-top: 10px;
    min-height: 30px;
    font-size: 35px;
    color: rgb(145, 151, 163);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
    -unity-text-align: upper-left;
}

.scan-action-list-chevron {
    margin-left: 12px;
    font-size: 80px;
    color: rgb(198, 202, 209);
}

.scan-action-footer {
    flex-direction: row;
    margin-top: 12px;
    width: 100%;
}

.scan-action-footer-button {
    flex-grow: 1;
    height: 102px;
    border-radius: 22px;
    border-width: 0;
    font-size: 34px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.scan-action-footer-button-muted {
    margin-right: 14px;
    background-color: rgb(235, 235, 239);
    color: rgb(108, 114, 127);
}

.scan-action-footer-button-primary {
    background-color: rgb(59, 130, 232);
    color: rgb(255, 255, 255);
}

.scan-address-dialog-overlay.is-hidden {
