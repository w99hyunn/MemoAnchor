:root {
    --nav-bg: rgb(30, 30, 34);
    --nav-icon-inactive: rgb(243, 243, 244);
    --nav-icon-active: rgb(255, 53, 87);
}

.unity-label {
    padding: 0;
    margin: 0;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
    color: rgb(28, 28, 28);
}

.unity-button {
    background-color: transparent;
    border-color: transparent;
    border-width: 0;
    padding: 0;
    margin: 0;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
}

.unity-button:hover:enabled {
    background-color: transparent;
    border-color: transparent;
}

.unity-button:active:enabled {
    background-color: transparent;
    border-color: transparent;
}

.splash-root {
    flex-grow: 1;
    justify-content: center;
}

.splash-panel {
    position: absolute;
    left: 72px;
    right: 72px;
    bottom: 86px;
    display: flex;
}

.splash-signup-panel {
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(246, 246, 246);
}

.splash-signup-panel .home-header {
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
}

.splash-signup-description {
    margin-top: 12px;
    font-size: 34px;
    color: rgb(135, 135, 135);
}

.splash-signup-bottom-bar {
    position: absolute;
    left: 60px;
    right: 60px;
    bottom: 60px;
    height: 200px;
    flex-direction: row;
    align-items: center;
}

.splash-login-button-kakao:hover:enabled {
    background-color: rgb(246, 220, 0);
}

.splash-signup-status {
    min-height: 42px;
    margin-top: 44px;
    color: rgb(87, 87, 87);
    font-size: 34px;
}

.main-root {
    flex-grow: 1;
    position: relative;
    background-color: rgb(246, 246, 246);
}

.tab-viewport {
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
}

.tab-strip {
    flex-direction: row;
    position: relative;
    left: 0;
    height: 100%;
    transition-property: left;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
    width: 500%;
}

.tab-page {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
    flex-grow: 0;
    min-height: 0;
    display: flex;
}

.tab-page-layout {
    height: 100%;
    flex-direction: column;
    min-height: 0;
    padding-right: 50px;
    padding-left: 50px;
    padding-top: 175px;
    padding-bottom: 0;
}

.tab-fixed-header {
    flex-grow: 0;
    flex-shrink: 0;
}

.tab-content-scroll {
    flex-grow: 1;
    min-height: 0;
}

.tab-content-scroll .unity-scroll-view__content-container {
    align-items: stretch;
}

.tab-content-inner {
    flex-grow: 0;
    padding-bottom: 300px;
}

#home-content-scroll {
    margin-left: -50px;
    margin-right: -50px;
}

#home-content-scroll .unity-scroll-view__content-container {
    padding-left: 0;
    padding-right: 0;
}

#home-content-scroll .memo-section {
    margin-left: 0;
    margin-right: 0;
}

#memo-content-scroll {
    margin-left: -50px;
    margin-right: -50px;
}

#memo-content-scroll .unity-scroll-view__content-container {
    padding-left: 0;
    padding-right: 0;
}

#memo-content-scroll .memo-section {
    margin-left: 0;
    margin-right: 0;
}

.memo-tab-mode-page {
    background-color: rgb(86, 99, 142);
}

.memo-tab-mode-page.is-admin-mode {
    background-color: rgb(177, 28, 68);
}

.memo-tab-mode-page .home-right-icon-button {
    -unity-background-image-tint-color: rgb(245, 245, 245);
}

.memo-mode-title-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    min-width: 0;
}

.memo-mode-title {
    color: rgb(255, 255, 255);
    margin-right: 28px;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    -unity-text-overflow-position: end;
    picking-mode: ignore;
}

.memo-header-actions {
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}

.home-header {
    flex-grow: 0;
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 70px;
}

.home-greeting {
    font-size: 60px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.home-right-icon-button {
    width: 65px;
    height: 65px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/alert.png?fileID=2800000&guid=a8ce16252c0ae1d46840a9dfaf22b609&type=3#alert");
    -unity-background-image-tint-color: rgb(28, 28, 28);
    -unity-background-scale-mode: scale-to-fit;
    margin-left: 50px;
}

.memo-filter-round-icon-button {
    width: 106px;
    height: 106px;
    border-radius: 53px;
    align-items: center;
    justify-content: center;
    background-image: none;
    picking-mode: position;
    transition-property: background-color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.memo-filter-round-icon-button:hover:enabled {
    background-color: rgba(255, 255, 255, 0.16);
    border-color: transparent;
}

.memo-filter-round-icon-button:active:enabled {
    background-color: rgba(255, 255, 255, 0.28);
    border-color: transparent;
}

.memo-filter-icon-button {
    margin-left: 24px;
}

.memo-filter-round-icon {
    width: 65px;
    height: 65px;
    -unity-background-scale-mode: scale-to-fit;
    picking-mode: ignore;
}

.memo-filter-icon {
    -unity-background-image-tint-color: rgb(245, 245, 245);
}

.memo-filter-back-icon {
    -unity-background-image-tint-color: rgb(42, 42, 42);
}

.memo-section {
    flex-grow: 1;
    width: auto;
    min-width: 0;
    align-self: stretch;
    position: relative;
    margin-left: -50px;
    margin-right: -50px;
    background-color: var(--nav-bg);
    padding-top: 100px;
    padding-bottom: 100px;
}

#mode-back {
    background-color: rgb(86, 99, 142);
}

#mode-back.is-admin-mode {
    background-color: rgb(177, 28, 68);
}

.memo-section-content {
    flex-grow: 1;
}

.memo-section-header {
    flex-grow: 0;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
    padding-right: 50px;
    padding-left: 50px;
}

.home-mode-title-row {
    flex-direction: row;
    align-items: center;
}

.home-mode-title {
    color: rgb(255, 255, 255);
    margin-right: 28px;
}

.home-mode-toggle {
    width: 160px;
    height: 76px;
    border-radius: 38px;
    background-color: rgb(234, 236, 239);
    padding-top: 6px;
    padding-right: 6px;
    padding-bottom: 6px;
    padding-left: 6px;
    justify-content: center;
    border-width: 0;
    flex-shrink: 0;
}

.home-mode-toggle:hover:enabled,
.home-mode-toggle:active:enabled {
    background-color: rgb(234, 236, 239);
}

.home-mode-toggle-thumb {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    background-color: rgb(177, 28, 68);
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/admin.png?fileID=2800000&guid=5b0fcf6366924744cb2f0df276925867&type=3#admin");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    align-self: flex-start;
    transition-property: translate, background-color;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
    background-size: 60% 60%;
}

.home-mode-toggle.is-work-mode .home-mode-toggle-thumb {
    translate: 84px 0;
    background-color: rgb(86, 99, 142);
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/user.png?fileID=2800000&guid=3a95cf702d6e3e64ca7c035145fdacfd&type=3#user");
}

.memo-section-title {
    font-size: 50px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
}

.memo-section-more {
    font-size: 35px;
    color: rgb(233, 233, 233);
}

.memo-scroll {
    flex-grow: 1;
    height: 700px;
}

.memo-scroll-content {
    flex-direction: row;
    padding-left: 50px;
    padding-right: 40px;
}

.memo-card {
    width: 900px;
    min-width: 760px;
    height: 700px;
    background-color: rgb(255, 255, 255);
    border-top-left-radius: 80px;
    border-top-right-radius: 80px;
    border-bottom-left-radius: 80px;
    border-bottom-right-radius: 80px;
    padding: 28px;
    margin-right: 40px;
    padding-top: 60px;
    padding-right: 60px;
    padding-bottom: 60px;
    padding-left: 60px;
}

.memo-title {
    font-size: 45px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
    margin-bottom: 25px;
}

.memo-divider {
    height: 2px;
    background-color: rgb(207, 207, 207);
    margin-bottom: 30px;
}

.memo-check-row {
    height: 120px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgb(239, 239, 239);
    border-top-left-radius: 45px;
    border-top-right-radius: 45px;
    border-bottom-left-radius: 45px;
    border-bottom-right-radius: 45px;
    padding-left: 40px;
    padding-right: 40px;
    margin-bottom: 12px;
}

.memo-check-text {
    font-size: 40px;
    color: rgb(44, 44, 44);
}

.memo-check-toggle {
    margin: 0;
    padding: 0;
}

.memo-check-toggle .unity-toggle__label {
    display: none;
}

.memo-check-toggle .unity-toggle__input {
    width: 64px;
    height: 64px;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: 0;
    border-radius: 10px;
    background-color: rgb(210, 210, 210);
    background-image: none;
    transition-property: background-color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.memo-check-toggle .unity-toggle__input:hover {
    background-color: rgb(190, 190, 190);
}

.memo-check-toggle .unity-toggle__input:active {
    background-color: rgb(170, 170, 170);
}

.memo-check-toggle:checked .unity-toggle__input {
    background-color: rgb(90, 90, 90);
    background-image: none;
}

.memo-check-toggle:checked .unity-toggle__input:hover {
    background-color: rgb(76, 76, 76);
}

.memo-check-toggle:checked .unity-toggle__input:active {
    background-color: rgb(60, 60, 60);
}

.memo-check-toggle .unity-toggle__checkmark {
    width: 42px;
    height: 42px;
    margin: 0;
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    opacity: 0;
}

.memo-check-toggle:checked .unity-toggle__checkmark {
    opacity: 1;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/check.png?fileID=2800000&guid=cc44cf71ac7687d4c82692e2f8ff010c&type=3#check");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.memo-footer {
    flex-grow: 1;
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
}

.memo-footer-text {
    font-size: 35px;
    color: rgb(135, 135, 135);
}

.memo-footer-date {
    margin-left: auto;
}

.scan-map-scroll-content {
    flex-direction: row;
    padding-left: 50px;
    padding-right: 40px;
}

.scan-map-card {
    width: 760px;
    min-width: 760px;
    height: 900px;
    margin-right: 32px;
    border-radius: 28px;
    background-color: rgb(132, 132, 132);
    overflow: hidden;
    border-top-left-radius: 80px;
    border-top-right-radius: 80px;
    border-bottom-right-radius: 80px;
    border-bottom-left-radius: 80px;
}

.scan-map-thumbnail {
    flex-grow: 1;
}

.scan-map-info {
    flex-grow: 0;
    padding-top: 60px;
    padding-right: 60px;
    padding-bottom: 60px;
    padding-left: 60px;
}

.scan-map-title {
    font-size: 42px;
    color: rgb(245, 245, 245);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
}

.scan-map-subtitle {
    margin-top: 8px;
    font-size: 30px;
    color: rgba(245, 245, 245, 0.88);
}

.bottom-nav-wrapper {
    position: absolute;
    left: 60px;
    right: 60px;
    bottom: 60px;
    height: 200px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    transition-duration: 0.26s;
    transition-timing-function: ease-out;
    transition-property: justify-content;
}

.bottom-nav {
    width: 100%;
    height: 100%;
    flex-direction: row;
    position: absolute;
    left: 0;
    right: 0;
    overflow: hidden;
    align-items: center;
    justify-content: space-around;
    background-color: var(--nav-bg);
    border-radius: 100px;
    padding-left: 18px;
    padding-right: 18px;
    transition-duration: 0.28s;
    transition-timing-function: ease-out;
    transition-property: left, right, width, height, border-radius, padding-left, padding-right;
}

.nav-item {
    width: 130px;
    height: 130px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-radius: 28px;
    background-color: rgba(0, 0, 0, 0);
    position: relative;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    -unity-font-style: normal;
    padding-top: 0;
    padding-bottom: 0;
    transition-duration: 0.26s;
    transition-timing-function: ease-out;
    transition-property: opacity, translate;
}

.scan-start-bg {
    position: absolute;
    left: auto;
    right: 14px;
    top: 0;
    width: 0;
    height: 200px;
    border-radius: 100px;
    background-color: rgb(30, 30, 34);
    opacity: 0;
    overflow: hidden;
    translate: 24px 0;
    transition-duration: 0.28s;
    transition-timing-function: ease-out;
    transition-property: width, height, border-radius, opacity, translate;
    transition-delay: 0s;
    visibility: hidden;
}

.scan-nav-start {
    position: absolute;
    left: 20px;
    right: 20px;
    top: 20px;
    bottom: 20px;
    width: auto;
    height: auto;
    border-radius: 70px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-color: rgb(194, 150, 163);
    opacity: 0;
    justify-content: center;
    align-items: center;
    translate: 16px 0;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
    transition-property: opacity, translate;
    transition-delay: 0.06s;
    visibility: hidden;
    border-top-left-radius: 60px;
    border-top-right-radius: 60px;
    border-bottom-right-radius: 60px;
    border-bottom-left-radius: 60px;
    color: rgb(255, 244, 248);
    font-size: 40px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
}

.bottom-nav.is-scan-mode #nav-home,
.bottom-nav.is-scan-mode #nav-menu,
.bottom-nav.is-scan-mode #nav-map,
.bottom-nav.is-scan-mode #nav-profile {
    opacity: 0;
    translate: 0 22px;
    position: absolute;
    visibility: hidden;
}

.bottom-nav-wrapper.is-scan-mode {
    justify-content: flex-start;
}

.bottom-nav-wrapper.is-scan-mode .bottom-nav {
    left: 0;
    right: auto;
    width: 164px;
    top: 0;
    height: 164px;
    border-radius: 82px;
    justify-content: center;
    padding-left: 0;
    padding-right: 0;
}

#nav-scan {
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
    transition-property: width, height, border-radius, background-color, margin-left;
}

.bottom-nav.is-scan-mode #nav-scan {
    width: 132px;
    height: 132px;
    border-radius: 66px;
    background-color: rgb(24, 24, 28);
    margin-left: 0;
    margin-right: 0;
    justify-content: center;
    align-items: center;
    padding-top: 0;
    padding-bottom: 0;
}

.bottom-nav.is-scan-mode #nav-scan .nav-icon {
    -unity-background-image-tint-color: rgb(255, 53, 87);
}

.bottom-nav-wrapper.is-scan-mode .scan-start-bg {
    left: 188px;
    right: 14px;
    top: 0;
    height: 164px;
    border-radius: 82px;
    width: auto;
    opacity: 1;
    translate: 0 0;
    visibility: visible;
}

.bottom-nav-wrapper.is-scan-mode .scan-start-bg .scan-nav-start {
    opacity: 1;
    translate: 0 0;
    visibility: visible;
}

.nav-press-bg {
    position: absolute;
    left: -10px;
    right: -10px;
    top: -10px;
    bottom: -10px;
    border-radius: 24px;
    background-color: rgba(42, 42, 47, 0);
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
    border-top-left-radius: 50px;
    border-top-right-radius: 50px;
    border-bottom-right-radius: 50px;
    border-bottom-left-radius: 50px;
}

.nav-item:hover {
    background-color: rgba(0, 0, 0, 0);
    transition-duration: 0.16s;
}

.nav-item:active {
    background-color: rgba(0, 0, 0, 0);
    transition-duration: 0.12s;
}

.nav-item:hover .nav-press-bg {
    background-color: rgba(44, 44, 50, 0.68);
}

.nav-item:active .nav-press-bg {
    background-color: rgba(54, 54, 60, 0.82);
}

.nav-item.is-tapping-down {
    background-color: rgba(0, 0, 0, 0);
}

.nav-item.is-tapping-down .nav-press-bg {
    top: 16px;
    bottom: 4px;
    left: 12px;
    right: 12px;
    border-radius: 36px;
    background-color: rgba(50, 50, 56, 0.95);
}

.nav-item > .nav-icon {
    position: relative;
    top: 0;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

.nav-item.is-tapping-down > .nav-icon {
    top: 2px;
}

.nav-icon {
    width: 52px;
    height: 52px;
    background-position: center;
    background-repeat: no-repeat;
    background-size: contain;
    -unity-background-image-tint-color: var(--nav-icon-inactive);
}

.nav-label {
    display: none;
    font-size: 30px;
    color: var(--nav-icon-inactive);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
    margin-top: 20px;
}

.nav-item.is-active .nav-icon {
    -unity-background-image-tint-color: var(--nav-icon-active);
    transition-duration: 0.18s;
}

.fade-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
}

.memo-search-input {
    font-size: 50px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
    background-color: rgba(255, 255, 255, 0);
    height: 110px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    color: rgb(255, 255, 255);
}

.memo-search-input .unity-base-text-field__input {
    background-color: transparent;
    border-radius: 55px;
    padding-left: 120px;
    border-color: rgb(178, 178, 178);
    height: 110px;
    border-width: 2px;
}

.memo-search-input .unity-base-text-field__input--placeholder {
    color: rgb(222, 222, 226);
}

.unity-base-text-field__input {
    color: rgb(27, 27, 27);
}

.unity-base-text-field__input--placeholder {
    color: rgb(88, 88, 88);
}

.memo-list-container {
    margin-top: 0;
    padding-top: 0;
    padding-right: 0;
    padding-left: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-bottom: 0;
}

.memo-list-swipe-row {
    height: 350px;
    position: relative;
    overflow: hidden;
    background-color: rgb(236, 60, 85);
}

.memo-list-delete-button {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 180px;
    border-width: 0;
    border-radius: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    background-color: rgb(236, 60, 85);
    justify-content: center;
    align-items: center;
}

.memo-list-delete-icon {
    width: 62px;
    height: 62px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/trash.png?fileID=2800000&guid=c2fd465122bc15242b8cf6da00d7bbb1&type=3#trash");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.memo-list-item {
    height: 350px;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 75px;
    padding-right: 75px;
    background-color: rgb(255, 255, 255);
    padding-top: 75px;
    padding-bottom: 75px;
    transition-property: translate;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

.memo-list-swipe-row.is-delete-open .memo-list-item {
    translate: -180px 0;
}

.memo-list-item-icon {
    width: 50px;
    height: 50px;
    margin-right: 20px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/memo-list/gallery.png?fileID=2800000&guid=805e5b39866ef38418d58c22145056e8&type=3#gallery");
    -unity-background-scale-mode: scale-to-fit;
}

.memo-list-item-body {
    flex-grow: 1;
    min-width: 0;
    height: 100%;
}

.memo-list-item-title {
    font-size: 50px;
    color: rgb(22, 22, 22);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.memo-list-item-meta-row {
    flex-direction: row;
    margin-top: 10px;
    margin-left: 70px;
}

.memo-list-item-meta {
    margin-right: 22px;
    font-size: 40px;
    color: rgb(156, 156, 156);
}

.memo-list-item-dot {
    width: 22px;
    height: 22px;
    margin-left: 12px;
    border-radius: 11px;
    background-color: rgb(236, 60, 85);
}

.memo-filter-page-host {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-grow: 0;
    display: flex;
}

.memo-filter-page-host.is-hidden {
    display: none;
}

.memo-filter-page {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(250, 250, 250);
    padding-top: 120px;
    display: flex;
}

.memo-filter-page.is-hidden {
    display: none;
}

.memo-filter-header {
    height: 145px;
    flex-grow: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-bottom-width: 1px;
    border-bottom-color: rgb(224, 224, 224);
}

.memo-filter-back-button {
    position: absolute;
    left: 50px;
}

.memo-filter-back-button:hover:enabled {
    background-color: rgb(238, 238, 238);
    border-color: transparent;
}

.memo-filter-back-button:active:enabled {
    background-color: rgb(224, 224, 224);
    border-color: transparent;
}

.memo-filter-back-button:active:enabled .memo-filter-back-icon {
    -unity-background-image-tint-color: rgb(20, 20, 20);
}

.memo-filter-scroll {
    flex-grow: 1;
    min-height: 0;
    padding-left: 50px;
    padding-right: 50px;
    margin-bottom: 260px;
}

.memo-filter-section {
    flex-grow: 0;
    padding-top: 70px;
    padding-bottom: 45px;
}

.memo-filter-section-title {
    font-size: 42px;
    color: rgb(68, 68, 68);
    margin-bottom: 42px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
}

.memo-filter-divider {
    height: 1px;
    background-color: rgb(228, 228, 228);
}

.memo-filter-date-row {
    height: 110px;
    flex-direction: row;
    align-items: center;
}

.memo-filter-date-button {
    flex-grow: 1;
    flex-basis: 0;
    height: 110px;
    border-width: 2px;
    border-color: rgb(219, 219, 219);
    border-radius: 55px;
    background-color: rgb(255, 255, 255);
    flex-direction: row;
    align-items: center;
    justify-content: center;
    transition-property: background-color, border-color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.memo-filter-date-button:hover:enabled {
    background-color: rgb(248, 248, 248);
    border-color: rgb(194, 194, 194);
}

.memo-filter-date-button:active:enabled {
    background-color: rgb(239, 239, 239);
    border-color: rgb(170, 170, 170);
}

.memo-filter-date-button.is-selected {
    border-color: rgb(86, 99, 142);
}

.memo-filter-date-button.is-selected:hover:enabled {
    background-color: rgb(246, 247, 252);
    border-color: rgb(76, 90, 133);
}

.memo-filter-date-button.is-selected:active:enabled {
    background-color: rgb(235, 238, 248);
    border-color: rgb(66, 79, 119);
}

.memo-filter-page.is-admin-mode .memo-filter-date-button.is-selected {
    border-color: rgb(177, 28, 68);
}

.memo-filter-page.is-admin-mode .memo-filter-date-button.is-selected:hover:enabled {
    background-color: rgb(255, 246, 249);
    border-color: rgb(158, 24, 61);
}

.memo-filter-page.is-admin-mode .memo-filter-date-button.is-selected:active:enabled {
    background-color: rgb(255, 235, 241);
    border-color: rgb(136, 20, 52);
}

.memo-filter-date-button.is-error {
    border-color: rgb(236, 60, 85);
}

.memo-filter-date-button.is-error:hover:enabled {
    background-color: rgb(255, 247, 249);
    border-color: rgb(236, 60, 85);
}

.memo-filter-date-button.is-error:active:enabled {
    background-color: rgb(255, 235, 239);
    border-color: rgb(210, 44, 70);
}

.memo-filter-date-text {
    font-size: 34px;
    color: rgb(88, 88, 88);
}

.memo-filter-date-button.is-selected .memo-filter-date-text {
    color: rgb(28, 28, 28);
}

.memo-filter-date-button.is-error .memo-filter-date-text {
    color: rgb(236, 60, 85);
}

.memo-filter-calendar-icon {
    width: 34px;
    height: 34px;
    margin-left: 18px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/calendar_month.png?fileID=2800000&guid=b1dcfd6da9be6544b8081fdc92d97423&type=3#calendar_month");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(84, 84, 84);
}

.memo-filter-date-button.is-selected .memo-filter-calendar-icon {
    -unity-background-image-tint-color: rgb(86, 99, 142);
}

.memo-filter-page.is-admin-mode .memo-filter-date-button.is-selected .memo-filter-calendar-icon {
    -unity-background-image-tint-color: rgb(177, 28, 68);
}

.memo-filter-date-button.is-error .memo-filter-calendar-icon {
    -unity-background-image-tint-color: rgb(236, 60, 85);
}

.memo-filter-date-dash {
    width: 85px;
    -unity-text-align: middle-center;
    font-size: 38px;
    color: rgb(190, 190, 190);
}

.memo-filter-check-button {
    width: 64px;
    height: 64px;
    margin-left: 24px;
    border-radius: 10px;
    background-color: rgb(210, 210, 210);
    align-items: center;
    justify-content: center;
    transition-property: background-color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.memo-filter-check-button:hover:enabled {
    background-color: rgb(190, 190, 190);
}

.memo-filter-check-button:active:enabled {
    background-color: rgb(170, 170, 170);
}

.memo-filter-check-button.is-selected {
    background-color: rgb(90, 90, 90);
}

.memo-filter-check-button.is-selected:hover:enabled {
    background-color: rgb(76, 76, 76);
}

.memo-filter-check-button.is-selected:active:enabled {
    background-color: rgb(60, 60, 60);
}

.memo-filter-page.is-admin-mode .memo-filter-check-button.is-selected {
    background-color: rgb(177, 28, 68);
}

.memo-filter-page.is-admin-mode .memo-filter-check-button.is-selected:hover:enabled {
    background-color: rgb(158, 24, 61);
}

.memo-filter-page.is-admin-mode .memo-filter-check-button.is-selected:active:enabled {
    background-color: rgb(136, 20, 52);
}

.memo-filter-check-icon {
    width: 42px;
    height: 42px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/check.png?fileID=2800000&guid=cc44cf71ac7687d4c82692e2f8ff010c&type=3#check");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.memo-filter-calendar {
    margin-top: 34px;
    border-width: 2px;
    border-color: rgb(86, 99, 142);
    border-radius: 36px;
    background-color: rgb(255, 255, 255);
    padding-top: 34px;
    padding-right: 40px;
    padding-bottom: 40px;
    padding-left: 40px;
    display: flex;
}

.memo-filter-calendar.is-hidden {
    display: none;
}

.memo-filter-calendar.is-error {
    border-color: rgb(236, 60, 85);
}

.memo-filter-page.is-admin-mode .memo-filter-calendar {
    border-color: rgb(177, 28, 68);
}

.memo-filter-page.is-admin-mode .memo-filter-calendar.is-error {
    border-color: rgb(236, 60, 85);
}

.memo-filter-calendar-header {
    height: 64px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 28px;
}

.memo-filter-calendar-title {
    width: 280px;
    -unity-text-align: middle-center;
    font-size: 34px;
    color: rgb(28, 28, 28);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.memo-filter-calendar-nav,
.memo-filter-calendar-close {
    width: 64px;
    height: 64px;
    font-size: 42px;
    color: rgb(86, 86, 86);
    border-radius: 32px;
    transition-property: background-color, color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.memo-filter-calendar-nav:hover:enabled,
.memo-filter-calendar-close:hover:enabled {
    background-color: rgb(244, 244, 244);
    border-color: transparent;
}

.memo-filter-calendar-nav:active:enabled,
.memo-filter-calendar-close:active:enabled {
    background-color: rgb(230, 230, 230);
    border-color: transparent;
    color: rgb(36, 36, 36);
}

.memo-filter-calendar-close {
    position: absolute;
    right: 0;
    width: 96px;
    font-size: 30px;
    color: rgb(170, 170, 170);
}

.memo-filter-calendar-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.memo-filter-calendar-cell {
    width: 14.2857%;
    height: 70px;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    color: rgb(48, 48, 48);
    transition-property: background-color, color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
    border-radius: 35px;
}

.memo-filter-calendar-cell:hover:enabled {
    background-color: rgb(245, 245, 245);
    border-color: transparent;
}

.memo-filter-calendar-cell:active:enabled {
    background-color: rgb(232, 232, 232);
    border-color: transparent;
}

.memo-filter-calendar-cell.is-weekday-header {
    color: rgb(140, 140, 140);
    font-size: 28px;
}

.memo-filter-calendar-cell.is-sunday {
    color: rgb(236, 60, 85);
}

.memo-filter-calendar-cell.is-saturday {
    color: rgb(86, 122, 210);
}

.memo-filter-calendar-cell.is-muted {
    color: rgb(194, 194, 194);
}

.memo-filter-calendar-cell.is-selected {
    color: rgb(255, 255, 255);
    background-color: rgb(86, 99, 142);
    border-radius: 35px;
}

.memo-filter-calendar-cell.is-selected:hover:enabled {
    background-color: rgb(76, 90, 133);
}

.memo-filter-calendar-cell.is-selected:active:enabled {
    background-color: rgb(66, 79, 119);
}

.memo-filter-page.is-admin-mode .memo-filter-calendar-cell.is-selected {
    background-color: rgb(177, 28, 68);
}

.memo-filter-page.is-admin-mode .memo-filter-calendar-cell.is-selected:hover:enabled {
    background-color: rgb(158, 24, 61);
}

.memo-filter-page.is-admin-mode .memo-filter-calendar-cell.is-selected:active:enabled {
    background-color: rgb(136, 20, 52);
}

.memo-filter-calendar.is-error .memo-filter-calendar-cell.is-selected {
    background-color: rgb(236, 60, 85);
}

.memo-filter-chip-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.memo-filter-chip {
    width: 48%;
    height: 110px;
    margin-right: 2%;
    margin-bottom: 22px;
    border-width: 2px;
    border-color: rgb(221, 221, 221);
    border-radius: 55px;
    background-color: rgb(255, 255, 255);
    color: rgb(48, 48, 48);
    font-size: 34px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.memo-filter-chip:hover:enabled,
.memo-filter-urgency-chip:hover:enabled,
.memo-filter-select-button:hover:enabled {
    background-color: rgb(248, 248, 248);
    border-color: rgb(194, 194, 194);
}

.memo-filter-chip:active:enabled,
.memo-filter-urgency-chip:active:enabled,
.memo-filter-select-button:active:enabled {
    background-color: rgb(239, 239, 239);
    border-color: rgb(170, 170, 170);
}

.memo-filter-chip.is-selected,
.memo-filter-urgency-chip.is-selected {
    background-color: rgb(86, 99, 142);
    border-color: rgb(86, 99, 142);
    color: rgb(255, 255, 255);
}

.memo-filter-chip.is-selected:hover:enabled,
.memo-filter-urgency-chip.is-selected:hover:enabled {
    background-color: rgb(76, 90, 133);
    border-color: rgb(76, 90, 133);
    color: rgb(255, 255, 255);
}

.memo-filter-chip.is-selected:active:enabled,
.memo-filter-urgency-chip.is-selected:active:enabled {
    background-color: rgb(66, 79, 119);
    border-color: rgb(66, 79, 119);
    color: rgb(255, 255, 255);
}

.memo-filter-page.is-admin-mode .memo-filter-chip.is-selected,
.memo-filter-page.is-admin-mode .memo-filter-urgency-chip.is-selected {
    background-color: rgb(177, 28, 68);
    border-color: rgb(177, 28, 68);
}

.memo-filter-page.is-admin-mode .memo-filter-chip.is-selected:hover:enabled,
.memo-filter-page.is-admin-mode .memo-filter-urgency-chip.is-selected:hover:enabled {
    background-color: rgb(158, 24, 61);
    border-color: rgb(158, 24, 61);
}

.memo-filter-page.is-admin-mode .memo-filter-chip.is-selected:active:enabled,
.memo-filter-page.is-admin-mode .memo-filter-urgency-chip.is-selected:active:enabled {
    background-color: rgb(136, 20, 52);
    border-color: rgb(136, 20, 52);
}

.memo-filter-select-button {
    height: 110px;
    border-width: 2px;
    border-color: rgb(221, 221, 221);
    border-radius: 55px;
    background-color: rgb(255, 255, 255);
    padding-left: 46px;
    padding-right: 36px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    transition-property: background-color, border-color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.memo-filter-select-text {
    font-size: 34px;
    color: rgb(48, 48, 48);
}

.memo-filter-select-chevron {
    font-size: 52px;
    color: rgb(170, 170, 170);
}

.memo-filter-map-list {
    margin-top: 34px;
    border-width: 1px;
    border-color: rgb(230, 230, 230);
    border-radius: 36px;
    background-color: rgb(255, 255, 255);
    padding-top: 24px;
    padding-bottom: 24px;
    display: flex;
}

.memo-filter-map-list.is-hidden {
    display: none;
}

.memo-filter-map-item {
    height: 86px;
    padding-left: 46px;
    justify-content: center;
    -unity-text-align: middle-left;
    color: rgb(52, 52, 52);
    font-size: 34px;
    transition-property: background-color, color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.memo-filter-map-item:hover:enabled {
    background-color: rgb(248, 248, 248);
    border-color: transparent;
}

.memo-filter-map-item:active:enabled {
    background-color: rgb(239, 239, 239);
    border-color: transparent;
}

.memo-filter-map-item.is-selected {
    color: rgb(86, 99, 142);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.memo-filter-page.is-admin-mode .memo-filter-map-item.is-selected {
    color: rgb(177, 28, 68);
}

.memo-filter-urgency-row {
    flex-direction: row;
    align-items: center;
}

.memo-filter-urgency-chip {
    flex-grow: 1;
    flex-basis: 0;
    height: 100px;
    margin-right: 2%;
    border-width: 2px;
    border-color: rgb(221, 221, 221);
    border-radius: 50px;
    background-color: rgb(255, 255, 255);
    color: rgb(48, 48, 48);
    font-size: 34px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.memo-filter-bottom-bar {
    position: absolute;
    left: 60px;
    right: 60px;
    bottom: 60px;
    height: 200px;
    padding-top: 18px;
    padding-right: 18px;
    padding-bottom: 18px;
    padding-left: 18px;
    border-radius: 100px;
    background-color: var(--nav-bg);
    flex-direction: row;
}

.memo-filter-bottom-button {
    flex-grow: 1;
    height: 164px;
    border-radius: 82px;
    color: rgb(255, 255, 255);
    font-size: 44px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
    transition-property: background-color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.memo-filter-reset-button {
    background-color: rgb(82, 82, 82);
    margin-right: 10px;
}

.memo-filter-reset-button:hover:enabled {
    background-color: rgb(74, 74, 74);
}

.memo-filter-reset-button:active:enabled {
    background-color: rgb(62, 62, 62);
}

.memo-filter-apply-button {
    background-color: rgb(86, 99, 142);
    margin-left: 10px;
}

.memo-filter-apply-button:hover:enabled {
    background-color: rgb(76, 90, 133);
}

.memo-filter-apply-button:active:enabled {
    background-color: rgb(66, 79, 119);
}

.memo-filter-page.is-admin-mode .memo-filter-apply-button {
    background-color: rgb(177, 28, 68);
}

.memo-filter-page.is-admin-mode .memo-filter-apply-button:hover:enabled {
    background-color: rgb(158, 24, 61);
}

.memo-filter-page.is-admin-mode .memo-filter-apply-button:active:enabled {
    background-color: rgb(136, 20, 52);
