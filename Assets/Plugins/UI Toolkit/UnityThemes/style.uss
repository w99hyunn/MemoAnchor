}

#signup-company-input-box.is-error,
#signup-name-input-box.is-error,
#signup-email-input-box.is-error {
    background-color: rgb(255, 247, 249);
}

.splash-root .splash-signup-panel .scan-input-box {
    position: relative;
}

.splash-root .splash-signup-panel .scan-input-box .signup-input-border {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-top-left-radius: 28px;
    border-top-right-radius: 28px;
    border-bottom-right-radius: 28px;
    border-bottom-left-radius: 28px;
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.splash-root .splash-signup-panel .scan-input-box.is-error .signup-input-border {
    border-left-color: rgb(248, 128, 148);
    border-right-color: rgb(248, 128, 148);
    border-top-color: rgb(248, 128, 148);
    border-bottom-color: rgb(248, 128, 148);
}

.splash-root .splash-panel {
    display: flex;
    opacity: 1;
    visibility: visible;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.28s;
    transition-timing-function: ease-out;
}

.splash-root .splash-panel.is-hidden {
    opacity: 0;
    visibility: hidden;
    translate: 0 28px;
}

.splash-root .splash-action-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.splash-root .splash-login-icon {
    width: 48px;
    height: 48px;
    margin-right: 22px;
    -unity-background-scale-mode: scale-to-fit;
}

.splash-root .splash-login-label {
    color: rgb(255, 255, 255);
    font-size: 44px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.splash-root .splash-login-button-kakao .splash-login-label {
    color: rgb(25, 22, 0);
}

#google-login-button {
    background-color: rgb(255, 255, 255);
}

#google-login-button:hover:enabled {
    background-color: rgb(245, 245, 245);
}

#google-login-button:active:enabled {
    background-color: rgb(232, 232, 232);
}

#google-login-button .splash-login-label {
    color: rgb(43, 43, 43);
}

.splash-root .splash-login-icon-kakao {
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/kakao.png?fileID=2800000&guid=ced5c007636d4164e8a3ccfbc2205ad8&type=3#kakao");
}

.splash-root .splash-login-icon-google {
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/google.png?fileID=2800000&guid=34f0e8d1f61950e41abd1b3637218c23&type=3#google");
}

.splash-root .splash-primary-button {
    background-color: var(--brand-pink);
    color: rgb(255, 255, 255);
    font-size: 44px;
}

.splash-root .splash-primary-button:hover:enabled {
    background-color: var(--brand-pink-hover);
}

.splash-root .splash-primary-button:active:enabled {
    background-color: var(--brand-pink-active);
}
