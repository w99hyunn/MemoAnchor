.bottom-nav-wrapper {
    position: absolute;
    left: 60px;
    right: 60px;
    bottom: 60px;
    height: 200px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    transition-duration: 0.26s;
    transition-timing-function: ease-out;
    transition-property: justify-content, filter;
}

.bottom-nav {
    width: 100%;
    height: 100%;
    flex-direction: row;
    position: absolute;
    left: 0;
    right: 0;
    overflow: hidden;
    align-items: center;
    justify-content: space-around;
    background-color: var(--nav-bg);
    border-radius: var(--nav-bar-radius);
    padding-left: 18px;
    padding-right: 18px;
    transition-duration: 0.28s;
    transition-timing-function: ease-out;
    transition-property: left, right, width, height, border-radius, padding-left, padding-right;
}

.nav-item {
    width: 130px;
    height: 130px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-radius: 28px;
    background-color: rgba(0, 0, 0, 0);
    position: relative;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    -unity-font-style: normal;
    padding-top: 0;
    padding-bottom: 0;
    transition-duration: 0.26s;
    transition-timing-function: ease-out;
    transition-property: opacity, translate;
}

.scan-start-bg {
    position: absolute;
    left: auto;
    right: 14px;
    top: 0;
    width: 0;
    height: 200px;
    border-radius: var(--nav-bar-radius);
    background-color: var(--nav-bg);
    opacity: 0;
    overflow: hidden;
    translate: 24px 0;
    transition-duration: 0.28s;
    transition-timing-function: ease-out;
    transition-property: width, height, border-radius, opacity, translate;
    transition-delay: 0s;
    visibility: hidden;
}

.scan-nav-start {
    position: absolute;
    left: 20px;
    right: 20px;
    top: 20px;
    bottom: 20px;
    width: auto;
    height: auto;
    border-radius: 56px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-color: var(--brand-pink);
    opacity: 0;
    justify-content: center;
    align-items: center;
    translate: 16px 0;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
    transition-property: background-color, opacity, translate;
    transition-delay: 0.06s;
    visibility: hidden;
    color: rgb(255, 255, 255);
    font-size: 44px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.scan-nav-start:hover:enabled {
    background-color: var(--brand-pink-hover);
}

.scan-nav-start:active:enabled {
    background-color: var(--brand-pink-active);
}

.scan-nav-start.is-disabled {
    background-color: rgb(170, 130, 140);
    color: rgb(255, 255, 255);
}

.scan-nav-start.is-disabled:hover:enabled,
.scan-nav-start.is-disabled:active:enabled {
    background-color: rgb(170, 130, 140);
}

.bottom-nav.is-scan-mode #nav-home,
.bottom-nav.is-scan-mode #nav-menu,
.bottom-nav.is-scan-mode #nav-map,
.bottom-nav.is-scan-mode #nav-profile,
.bottom-nav.is-map-mode #nav-home,
.bottom-nav.is-map-mode #nav-menu,
.bottom-nav.is-map-mode #nav-scan,
.bottom-nav.is-map-mode #nav-profile {
    opacity: 0;
    translate: 0 22px;
    position: absolute;
    visibility: hidden;
}

.bottom-nav-wrapper.is-scan-mode,
.bottom-nav-wrapper.is-map-mode {
    justify-content: flex-start;
}

.bottom-nav-wrapper.is-scan-mode .bottom-nav,
.bottom-nav-wrapper.is-map-mode .bottom-nav {
    left: 0;
    right: auto;
    width: 164px;
    top: 0;
    height: 164px;
    border-radius: 65px;
    justify-content: center;
    padding-left: 0;
    padding-right: 0;
}

#nav-scan,
#nav-map {
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
    transition-property: width, height, border-radius, margin-left;
}

.bottom-nav.is-scan-mode #nav-scan,
.bottom-nav.is-map-mode #nav-map {
    width: 132px;
    height: 132px;
    border-radius: 59px;
    margin-left: 0;
    margin-right: 0;
    justify-content: center;
    align-items: center;
    padding-top: 0;
    padding-bottom: 0;
}

.bottom-nav.is-scan-mode #nav-scan .nav-icon {
    -unity-background-image-tint-color: rgb(255, 53, 87);
}

.bottom-nav.is-map-mode #nav-map .nav-icon {
    -unity-background-image-tint-color: rgb(255, 53, 87);
}

.bottom-nav-wrapper.is-scan-mode .scan-nav-action-bg,
.bottom-nav-wrapper.is-map-mode .map-nav-action-bg {
    left: 188px;
    right: 14px;
    top: 0;
    height: 164px;
    border-radius: 71px;
    width: auto;
    opacity: 1;
    translate: 0 0;
    visibility: visible;
}

.bottom-nav-wrapper.is-scan-mode .scan-nav-action-bg .scan-nav-start,
.bottom-nav-wrapper.is-map-mode .map-nav-action-bg .scan-nav-start {
    opacity: 1;
    translate: 0 0;
    visibility: visible;
}

.bottom-nav-wrapper.is-memo-filter-mode .bottom-nav,
.bottom-nav-wrapper.is-memo-detail-mode .bottom-nav,
.bottom-nav-wrapper.is-memo-create-mode .bottom-nav,
.bottom-nav-wrapper.is-memo-trash-mode .bottom-nav {
    display: none;
}

.nav-press-bg {
    position: absolute;
    left: -10px;
    right: -10px;
    top: -10px;
    bottom: -10px;
    border-radius: 24px;
    background-color: rgba(42, 42, 47, 0);
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
    border-top-left-radius: 50px;
    border-top-right-radius: 50px;
    border-bottom-right-radius: 50px;
    border-bottom-left-radius: 50px;
}

.nav-item:hover {
    background-color: rgba(0, 0, 0, 0);
    transition-duration: 0.16s;
}

.nav-item:active {
    background-color: rgba(0, 0, 0, 0);
    transition-duration: 0.12s;
}

.nav-item:hover .nav-press-bg {
    background-color: rgba(44, 44, 50, 0.68);
}

.nav-item:active .nav-press-bg {
    background-color: rgba(54, 54, 60, 0.82);
}

.nav-item.is-tapping-down {
    background-color: rgba(0, 0, 0, 0);
}

.nav-item.is-tapping-down .nav-press-bg {
    top: 16px;
    bottom: 4px;
    left: 12px;
    right: 12px;
    border-radius: 36px;
    background-color: rgba(50, 50, 56, 0.95);
}

.nav-item > .nav-icon {
    position: relative;
    top: 0;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

.nav-item.is-tapping-down > .nav-icon {
    top: 2px;
}

.nav-icon {
    width: 52px;
    height: 52px;
    background-position: center;
    background-repeat: no-repeat;
    background-size: contain;
    -unity-background-image-tint-color: var(--nav-icon-inactive);
}

.nav-item.is-active .nav-icon {
    -unity-background-image-tint-color: var(--nav-icon-active);
    transition-duration: 0.18s;
}

.fade-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
}

.memo-search-input {
    font-size: 44px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
    background-color: rgba(255, 255, 255, 0);
    height: 110px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    color: rgb(255, 255, 255);
}

.memo-search-input .unity-base-text-field__input {
    background-color: transparent;
    border-radius: 55px;
    padding-left: 120px;
    padding-right: 112px;
    border-color: rgb(178, 178, 178);
    height: 110px;
    border-width: 2px;
}

.memo-search-input .unity-base-text-field__input--placeholder {
    color: rgb(222, 222, 226);
}

#memo-search-input .unity-base-text-field__input {
    border-color: rgb(149, 171, 249);
}

#memo-search-input .unity-base-text-field__input--placeholder {
    color: rgb(149, 171, 249);
}

.memo-tab-mode-page.is-admin-mode #memo-search-input .unity-base-text-field__input {
    border-color: rgb(255, 182, 200);
}

.memo-tab-mode-page.is-admin-mode #memo-search-input .unity-base-text-field__input--placeholder {
    color: rgb(255, 182, 200);
}

.memo-search-clear-button {
    position: absolute;
    right: 66px;
    top: 11px;
    width: 88px;
    height: 88px;
}

.memo-search-clear-icon {
    width: 48px;
    height: 48px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/xbutton.png?fileID=2800000&guid=ec503318264761140bef84a89627b643&type=3#xbutton");
}

.unity-base-text-field__input {
