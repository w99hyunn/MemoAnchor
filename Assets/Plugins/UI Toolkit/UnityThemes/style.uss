    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.memo-list-item {
    height: 300px;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 75px;
    padding-right: 75px;
    background-color: rgb(255, 255, 255);
    padding-top: 50px;
    padding-bottom: 50px;
    transition-property: translate, background-color;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

.list-select-button {
    display: none;
    width: 58px;
    height: 58px;
    padding: 0;
    margin: 0 28px 0 0;
    border-width: 4px;
    border-color: rgb(178, 178, 178);
    border-radius: 29px;
    background-color: rgb(255, 255, 255);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.list-select-button:hover:enabled,
.list-select-button:active:enabled {
    border-width: 4px;
    border-color: rgb(178, 178, 178);
    background-color: rgb(255, 255, 255);
}

.page-overlay.is-trash-selecting .list-select-button {
