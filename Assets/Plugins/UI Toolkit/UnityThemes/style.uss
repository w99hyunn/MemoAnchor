:root {
    --nav-bg: rgb(30, 30, 34);
    --nav-icon-inactive: rgb(243, 243, 244);
    --nav-icon-active: rgb(255, 53, 87);
}

.unity-label {
    padding: 0;
    margin: 0;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
    color: rgb(28, 28, 28);
}

.unity-button {
    background-color: transparent;
    border-color: transparent;
    border-width: 0;
    padding: 0;
    margin: 0;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
}

.unity-button:hover:enabled {
    background-color: transparent;
    border-color: transparent;
}

.unity-button:active:enabled {
    background-color: transparent;
    border-color: transparent;
}

.main-root {
    flex-grow: 1;
    position: relative;
    background-color: rgb(246, 246, 246);
}

.tab-viewport {
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
}

.tab-strip {
    flex-direction: row;
    position: relative;
    left: 0;
    height: 100%;
    transition-property: left;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
    width: 500%;
}

.tab-page {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
    flex-grow: 0;
    min-height: 0;
    display: flex;
}

.tab-page-layout {
    height: 100%;
    flex-direction: column;
    min-height: 0;
    padding-right: 50px;
    padding-left: 50px;
    padding-top: 175px;
    padding-bottom: 0;
}

.tab-fixed-header {
    flex-grow: 0;
    flex-shrink: 0;
}

.tab-content-scroll {
    flex-grow: 1;
    height: 100%;
    min-height: 0;
}

.tab-content-scroll .unity-scroll-view__content-container {
    align-items: stretch;
}

.tab-content-inner {
    flex-grow: 0;
    padding-bottom: 300px;
}

#home-content-scroll {
    margin-left: -50px;
    margin-right: -50px;
}

#home-content-scroll .unity-scroll-view__content-container {
    padding-left: 0;
    padding-right: 0;
}

#home-content-scroll .memo-section {
    margin-left: 0;
    margin-right: 0;
}

#memo-content-scroll {
    margin-left: -50px;
    margin-right: -50px;
}

#memo-content-scroll .unity-scroll-view__content-container {
    padding-left: 0;
    padding-right: 0;
}

#memo-content-scroll .memo-section {
    margin-left: 0;
    margin-right: 0;
}

.home-header {
    flex-grow: 0;
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 70px;
}

.home-greeting {
    font-size: 60px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.home-right-icon-button {
    width: 65px;
    height: 65px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/alert.png?fileID=2800000&guid=a8ce16252c0ae1d46840a9dfaf22b609&type=3#alert");
    -unity-background-image-tint-color: rgb(28, 28, 28);
    -unity-background-scale-mode: scale-to-fit;
    margin-left: 50px;
}

.memo-section {
    flex-grow: 1;
    width: auto;
    min-width: 0;
    align-self: stretch;
    position: relative;
    margin-left: -50px;
    margin-right: -50px;
    background-color: var(--nav-bg);
    padding-top: 100px;
    padding-bottom: 100px;
}

.memo-section-content {
    flex-grow: 1;
}

.memo-section-header {
    flex-grow: 0;
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 30px;
    padding-right: 50px;
    padding-left: 50px;
}

.memo-section-title {
    font-size: 50px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
}

.memo-section-more {
    font-size: 35px;
    color: rgb(233, 233, 233);
}

.memo-scroll {
    flex-grow: 1;
    height: 700px;
}

.memo-scroll-content {
    flex-direction: row;
    padding-left: 50px;
    padding-right: 40px;
}

.memo-card {
    width: 900px;
    min-width: 760px;
    height: 700px;
    background-color: rgb(255, 255, 255);
    border-top-left-radius: 80px;
    border-top-right-radius: 80px;
    border-bottom-left-radius: 80px;
    border-bottom-right-radius: 80px;
    padding: 28px;
    margin-right: 40px;
    padding-top: 60px;
    padding-right: 60px;
    padding-bottom: 60px;
    padding-left: 60px;
}

.memo-title {
    font-size: 45px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
    margin-bottom: 25px;
}

.memo-divider {
    height: 2px;
    background-color: rgb(207, 207, 207);
    margin-bottom: 30px;
}

.memo-check-row {
    height: 120px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgb(239, 239, 239);
    border-top-left-radius: 45px;
    border-top-right-radius: 45px;
    border-bottom-left-radius: 45px;
    border-bottom-right-radius: 45px;
    padding-left: 40px;
    padding-right: 40px;
    margin-bottom: 12px;
}

.memo-check-text {
    font-size: 40px;
    color: rgb(44, 44, 44);
}

.memo-check-toggle {
    margin: 0;
    padding: 0;
}

.memo-check-toggle .unity-toggle__label {
    display: none;
}

.memo-check-toggle .unity-toggle__input {
    width: 70px;
    height: 70px;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-color: rgb(160, 160, 160);
    border-right-color: rgb(160, 160, 160);
    border-bottom-color: rgb(160, 160, 160);
    border-left-color: rgb(160, 160, 160);
    border-radius: 20px;
    background-color: rgb(255, 255, 255);
    background-image: none;
}

.memo-check-toggle:checked .unity-toggle__input {
    background-color: rgb(217, 217, 217);
    background-image: none;
}

.memo-check-toggle .unity-toggle__checkmark {
    width: 40px;
    height: 40px;
    margin: 0;
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    opacity: 0;
}

.memo-check-toggle:checked .unity-toggle__checkmark {
    opacity: 1;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/check.png?fileID=2800000&guid=cc44cf71ac7687d4c82692e2f8ff010c&type=3#check");
    -unity-background-scale-mode: scale-to-fit;
}

.memo-footer {
    flex-grow: 1;
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
}

.memo-footer-text {
    font-size: 35px;
    color: rgb(135, 135, 135);
}

.memo-footer-date {
    margin-left: auto;
}

.scan-map-scroll-content {
    flex-direction: row;
    padding-left: 50px;
    padding-right: 40px;
}

.scan-map-card {
    width: 760px;
    min-width: 760px;
    height: 900px;
    margin-right: 32px;
    border-radius: 28px;
    background-color: rgb(132, 132, 132);
    overflow: hidden;
    border-top-left-radius: 80px;
    border-top-right-radius: 80px;
    border-bottom-right-radius: 80px;
    border-bottom-left-radius: 80px;
}

.scan-map-thumbnail {
    flex-grow: 1;
}

.scan-map-info {
    flex-grow: 0;
    padding-top: 60px;
    padding-right: 60px;
    padding-bottom: 60px;
    padding-left: 60px;
}

.scan-map-title {
    font-size: 42px;
    color: rgb(245, 245, 245);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
}

.scan-map-subtitle {
    margin-top: 8px;
    font-size: 30px;
    color: rgba(245, 245, 245, 0.88);
}

.bottom-nav-wrapper {
    position: absolute;
    left: 60px;
    right: 60px;
    bottom: 60px;
    height: 200px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    transition-duration: 0.26s;
    transition-timing-function: ease-out;
    transition-property: justify-content;
}

.bottom-nav {
    width: 100%;
    height: 100%;
    flex-direction: row;
    position: absolute;
    left: 0;
    right: 0;
    overflow: hidden;
    align-items: center;
    justify-content: space-around;
    background-color: var(--nav-bg);
    border-radius: 100px;
    padding-left: 18px;
    padding-right: 18px;
    transition-duration: 0.28s;
    transition-timing-function: ease-out;
    transition-property: left, right, width, height, border-radius, padding-left, padding-right;
}

.nav-item {
    width: 130px;
    height: 130px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-radius: 28px;
    background-color: rgba(0, 0, 0, 0);
    position: relative;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    -unity-font-style: normal;
    padding-top: 10px;
    padding-bottom: 10px;
    transition-duration: 0.26s;
    transition-timing-function: ease-out;
    transition-property: opacity, translate;
}

.scan-start-bg {
    position: absolute;
    left: auto;
    right: 14px;
    top: 0;
    width: 0;
    height: 200px;
    border-radius: 100px;
    background-color: rgb(30, 30, 34);
    opacity: 0;
    overflow: hidden;
    translate: 24px 0;
    transition-duration: 0.28s;
    transition-timing-function: ease-out;
    transition-property: width, height, border-radius, opacity, translate;
    transition-delay: 0s;
    visibility: hidden;
}

.scan-nav-start {
    position: absolute;
    left: 20px;
    right: 20px;
    top: 20px;
    bottom: 20px;
    width: auto;
    height: auto;
    border-radius: 70px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-color: rgb(194, 150, 163);
    opacity: 0;
    justify-content: center;
    align-items: center;
    translate: 16px 0;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
    transition-property: opacity, translate;
    transition-delay: 0.06s;
    visibility: hidden;
    border-top-left-radius: 60px;
    border-top-right-radius: 60px;
    border-bottom-right-radius: 60px;
    border-bottom-left-radius: 60px;
    color: rgb(255, 244, 248);
    font-size: 40px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
}

.bottom-nav.is-scan-mode #nav-home,
.bottom-nav.is-scan-mode #nav-menu,
.bottom-nav.is-scan-mode #nav-map,
.bottom-nav.is-scan-mode #nav-profile {
    opacity: 0;
    translate: 0 22px;
    position: absolute;
    visibility: hidden;
}

.bottom-nav-wrapper.is-scan-mode {
    justify-content: flex-start;
}

.bottom-nav-wrapper.is-scan-mode .bottom-nav {
    left: 0;
    right: auto;
    width: 164px;
    top: 0;
    height: 164px;
    border-radius: 82px;
    justify-content: center;
    padding-left: 0;
    padding-right: 0;
}

#nav-scan {
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
    transition-property: width, height, border-radius, background-color, margin-left;
}

#nav-scan .nav-label {
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
    transition-property: opacity, margin-top;
}

.bottom-nav.is-scan-mode #nav-scan {
    width: 132px;
    height: 132px;
    border-radius: 66px;
    background-color: rgb(24, 24, 28);
    margin-left: 0;
    margin-right: 0;
    justify-content: center;
    align-items: center;
    padding-top: 0;
    padding-bottom: 0;
}

.bottom-nav.is-scan-mode #nav-scan .nav-label {
    display: none;
}

.bottom-nav.is-scan-mode #nav-scan .nav-icon {
    -unity-background-image-tint-color: rgb(255, 53, 87);
}

.bottom-nav-wrapper.is-scan-mode .scan-start-bg {
    left: 188px;
    right: 14px;
    top: 0;
    height: 164px;
    border-radius: 82px;
    width: auto;
    opacity: 1;
    translate: 0 0;
    visibility: visible;
}

.bottom-nav-wrapper.is-scan-mode .scan-start-bg .scan-nav-start {
    opacity: 1;
    translate: 0 0;
    visibility: visible;
}

.nav-press-bg {
    position: absolute;
    left: -10px;
    right: -10px;
    top: -10px;
    bottom: -20px;
    border-radius: 24px;
    background-color: rgba(42, 42, 47, 0);
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
    border-top-left-radius: 50px;
    border-top-right-radius: 50px;
    border-bottom-right-radius: 50px;
    border-bottom-left-radius: 50px;
}

.nav-item:hover {
    background-color: rgba(0, 0, 0, 0);
    transition-duration: 0.16s;
}

.nav-item:active {
    background-color: rgba(0, 0, 0, 0);
    transition-duration: 0.12s;
}

.nav-item:hover .nav-press-bg {
    background-color: rgba(44, 44, 50, 0.68);
}

.nav-item:active .nav-press-bg {
    background-color: rgba(54, 54, 60, 0.82);
}

.nav-item.is-tapping-down {
    background-color: rgba(0, 0, 0, 0);
}

.nav-item.is-tapping-down .nav-press-bg {
    top: 16px;
    bottom: 4px;
    left: 12px;
    right: 12px;
    border-radius: 36px;
    background-color: rgba(50, 50, 56, 0.95);
}

.nav-item > .nav-icon,
.nav-item > .nav-label {
    position: relative;
    top: 0;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

.nav-item.is-tapping-down > .nav-icon,
.nav-item.is-tapping-down > .nav-label {
    top: 2px;
}

.nav-icon {
    width: 52px;
    height: 52px;
    background-position: center;
    background-repeat: no-repeat;
    background-size: contain;
    -unity-background-image-tint-color: var(--nav-icon-inactive);
}

.nav-label {
    font-size: 30px;
    color: var(--nav-icon-inactive);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
    margin-top: 20px;
}

.nav-item.is-active .nav-icon {
    -unity-background-image-tint-color: var(--nav-icon-active);
    transition-duration: 0.18s;
}

.nav-item.is-active .nav-label {
    color: var(--nav-icon-active);
    transition-duration: 0.18s;
}

.fade-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
}

.memo-search-input {
    font-size: 50px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
    background-color: rgba(255, 255, 255, 0);
    height: 110px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    color: rgb(255, 255, 255);
}

.memo-search-input .unity-base-text-field__input {
    background-color: rgb(255, 255, 255);
    border-radius: 45px;
    padding-left: 120px;
    border-color: rgb(178, 178, 178);
    height: 110px;
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-right-radius: 30px;
    border-bottom-left-radius: 30px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.unity-base-text-field__input {
    color: rgb(27, 27, 27);
}

.unity-base-text-field__input--placeholder {
    color: rgb(88, 88, 88);
}

.memo-list-container {
    margin-top: 0;
    padding-top: 0;
    padding-right: 0;
    padding-left: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-bottom: 0;
}

.memo-list-item {
    height: 350px;
    flex-direction: row;
    align-items: center;
    padding-left: 75px;
    padding-right: 75px;
    background-color: rgb(255, 255, 255);
    padding-top: 75px;
    padding-bottom: 75px;
}

.memo-list-item-icon {
    width: 50px;
    height: 50px;
    margin-right: 20px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/memo-list/gallery.png?fileID=2800000&guid=805e5b39866ef38418d58c22145056e8&type=3#gallery");
    -unity-background-scale-mode: scale-to-fit;
}

.memo-list-item-body {
    flex-grow: 1;
    min-width: 0;
    height: 100%;
}

.memo-list-item-title {
    font-size: 50px;
    color: rgb(22, 22, 22);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.memo-list-item-meta-row {
    flex-direction: row;
    margin-top: 10px;
    margin-left: 70px;
}

.memo-list-item-meta {
    margin-right: 22px;
    font-size: 40px;
    color: rgb(156, 156, 156);
}

.memo-list-item-dot {
    width: 22px;
    height: 22px;
    margin-left: 12px;
    border-radius: 11px;
    background-color: rgb(236, 60, 85);
}

.scan-step-title {
    margin-top: 50px;
    font-size: 60px;
    color: rgb(68, 68, 68);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
}

.scan-field-group {
    margin-top: 60px;
}

.scan-field-label {
    margin-bottom: 12px;
    font-size: 45px;
    color: rgb(78, 78, 78);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
}

.scan-input-box {
    height: 120px;
    border-radius: 28px;
    background-color: rgb(255, 255, 255);
    justify-content: center;
    padding-left: 30px;
    padding-right: 30px;
}

.scan-input-field {
    flex-grow: 1;
    height: 100%;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(84, 84, 84);
}

.scan-input-field .unity-base-text-field__input {
    height: 100%;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(84, 84, 84);
    font-size: 42px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
}

.scan-input-field .unity-base-text-field__input--placeholder {
    color: rgb(186, 186, 186);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
}

.scan-select-button {
    flex-grow: 1;
    height: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 0;
    padding-right: 0;
}

.scan-select-button-text-field {
    flex-grow: 1;
    margin: 0;
    padding: 0;
}

.scan-select-button-text-field > .unity-text-field__input {
    padding-right: 16px;
}

.scan-select-button-arrow {
    margin-left: 24px;
    font-size: 68px;
    color: rgb(160, 160, 160);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
}

.scan-action-dialog-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: flex-end;
    background-color: rgba(0, 0, 0, 0.6);
    padding-left: 40px;
    padding-right: 40px;
    padding-bottom: 40px;
    visibility: visible;
    padding-top: 40px;
    opacity: 1;
}

.scan-action-dialog-overlay.is-anim-ready {
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.24s;
    transition-timing-function: ease-out;
}

.scan-action-dialog-overlay.is-anim-ready.is-open {
    opacity: 1;
}

.scan-action-dialog-sheet {
    width: 100%;
    min-height: 760px;
    border-radius: 44px;
    background-color: rgb(255, 255, 255);
    padding-top: 30px;
    padding-right: 50px;
    padding-bottom: 50px;
    padding-left: 50px;
    translate: 0 0;
    border-top-left-radius: 90px;
    border-top-right-radius: 90px;
    border-bottom-right-radius: 90px;
    border-bottom-left-radius: 90px;
    opacity: 1;
}

.scan-action-dialog-overlay.is-anim-ready .scan-action-dialog-sheet {
    opacity: 0;
    translate: 0 48px;
    transition-property: opacity, translate;
    transition-duration: 0.24s;
    transition-timing-function: ease-out;
}

.scan-action-dialog-overlay.is-anim-ready.is-open .scan-action-dialog-sheet {
    opacity: 1;
    translate: 0 0;
}

.scan-action-dialog-handle {
    width: 96px;
    height: 8px;
    border-radius: 4px;
    background-color: rgb(224, 226, 230);
    align-self: center;
    margin-top: 10px;
    margin-bottom: 75px;
}

.scan-action-dialog-title {
    font-size: 52px;
    color: rgb(53, 61, 77);
    margin-bottom: 50px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
    padding-right: 25px;
    padding-left: 25px;
}

.scan-action-list {
    width: 100%;
    margin-bottom: 18px;
    border-radius: 0;
}

.scan-action-list-item {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    margin: 0;
    border-width: 0;
    min-height: 118px;
    padding-top: 50px;
    padding-bottom: 50px;
    padding-left: 25px;
    padding-right: 25px;
    border-radius: 50px;
    transition-property: background-color;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
    margin-bottom: 20px;
    background-color: rgba(255, 255, 255, 0);
}

.scan-action-list-item:active:enabled {
    background-color: rgb(228, 233, 241);
}

.scan-action-list-item:hover:enabled {
    background-color: rgb(237, 240, 245);
}

.scan-action-option-icon-slot {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background-color: rgb(255, 230, 234);
    margin-right: 50px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.scan-action-option-icon-placeholder {
    width: 26px;
    height: 26px;
    border-radius: 13px;
    background-color: rgb(255, 53, 87);
}

.scan-action-option-texts {
    flex-grow: 1;
    min-width: 0;
}

.scan-action-option-title {
    font-size: 50px;
    color: rgb(49, 57, 73);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
    -unity-text-align: upper-left;
}

.scan-action-option-description {
    margin-top: 10px;
    min-height: 30px;
    font-size: 35px;
    color: rgb(145, 151, 163);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
    -unity-text-align: upper-left;
}

.scan-action-list-chevron {
    margin-left: 12px;
    font-size: 80px;
    color: rgb(198, 202, 209);
}

.scan-action-footer {
    flex-direction: row;
    margin-top: 12px;
    width: 100%;
}

.scan-action-footer-button {
    flex-grow: 1;
    height: 102px;
    border-radius: 22px;
    border-width: 0;
    font-size: 34px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.scan-action-footer-button-muted {
    margin-right: 14px;
    background-color: rgb(235, 235, 239);
    color: rgb(108, 114, 127);
}

.scan-action-footer-button-primary {
    background-color: rgb(59, 130, 232);
    color: rgb(255, 255, 255);
}

.alert-dialog-page {
    flex-grow: 1;
    background-color: rgb(246, 246, 246);
    padding-top: 175px;
}

.alert-dialog-header {
    height: 170px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 36px;
    padding-right: 36px;
    background-color: rgb(246, 246, 246);
}

.alert-back-button {
    width: 92px;
    height: 92px;
    color: rgb(44, 44, 44);
    font-size: 86px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
}

.alert-dialog-title {
    font-size: 50px;
    color: rgb(24, 24, 24);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.alert-header-spacer {
    width: 92px;
    height: 92px;
}

.alert-scroll {
    flex-grow: 1;
    background-color: rgb(246, 246, 246);
}

.alert-section {
    background-color: rgb(255, 255, 255);
}

.alert-request-item {
    min-height: 220px;
    padding-top: 34px;
    padding-right: 36px;
    padding-bottom: 32px;
    padding-left: 36px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(235, 235, 235);
}

.alert-map-item {
    min-height: 220px;
    padding-top: 34px;
    padding-right: 36px;
    padding-bottom: 32px;
    padding-left: 36px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(235, 235, 235);
}

.alert-request-main {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
}

.alert-text-column {
    flex-grow: 1;
    min-width: 0;
}

.alert-primary-text {
    font-size: 38px;
    color: rgb(16, 16, 16);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
    white-space: normal;
}

.alert-secondary-text {
    margin-top: 14px;
    font-size: 34px;
    color: rgb(97, 97, 97);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
}

.alert-time-text {
    flex-shrink: 0;
    margin-left: 24px;
    font-size: 34px;
    color: rgb(154, 154, 154);
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
}

.alert-action-row {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 24px;
}

.alert-action-button {
    min-width: 220px;
    height: 76px;
    border-radius: 38px;
    border-width: 2px;
    font-size: 34px;
    margin-left: 18px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}

.alert-action-secondary {
    color: rgb(30, 30, 30);
    background-color: rgb(255, 255, 255);
    border-color: rgb(78, 78, 78);
}

.alert-action-primary {
    color: rgb(255, 255, 255);
    background-color: rgb(75, 88, 132);
    border-color: rgb(75, 88, 132);
}

.alert-gap {
    height: 200px;
    background-color: rgb(246, 246, 246);
}

.alert-close-button {
    width: 70px;
    height: 70px;
    color: rgb(65, 171, 219);
    font-size: 42px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-SemiBold.ttf?fileID=12800000&guid=7136488b0fb8f924b91754e33f3b5abc&type=3#Pretendard-SemiBold");
}
