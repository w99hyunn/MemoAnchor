    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

.map-participants-invite-code-button {
    min-width: 250px;
    height: 62px;
    margin: 0 26px 0 0;
    padding-left: 20px;
    padding-right: 14px;
    border-width: 0;
    border-radius: 31px;
    background-color: rgb(243, 243, 243);
    flex-direction: row;
    align-items: center;
    justify-content: center;
    transition-property: background-color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.map-participants-invite-code-button:hover:enabled {
    border-color: transparent;
    background-color: rgb(232, 232, 232);
}

.map-participants-invite-code-button:active:enabled {
    border-color: transparent;
    background-color: rgb(216, 216, 216);
}

.map-participants-invite-issue-label,
.map-participants-invite-timer,
.map-participants-invite-code {
    color: rgb(169, 169, 169);
    font-size: 28px;
}

.map-participants-invite-code-button:hover:enabled .map-participants-invite-issue-label,
.map-participants-invite-code-button:hover:enabled .map-participants-invite-timer,
.map-participants-invite-code-button:hover:enabled .map-participants-invite-code {
    color: rgb(130, 130, 130);
}

.map-participants-invite-code-button:active:enabled .map-participants-invite-issue-label,
.map-participants-invite-code-button:active:enabled .map-participants-invite-timer,
.map-participants-invite-code-button:active:enabled .map-participants-invite-code {
