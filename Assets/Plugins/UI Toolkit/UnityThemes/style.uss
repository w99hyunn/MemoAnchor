}

.memo-list-container {
    margin-top: 0;
    padding-top: 0;
    padding-right: 0;
    padding-left: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-bottom: 0;
}

.memo-list-container.is-empty {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.memo-list-empty-state {
    align-items: center;
    justify-content: center;
}

.memo-list-swipe-row {
    height: 300px;
    position: relative;
    overflow: hidden;
    background-color: rgb(236, 60, 85);
}

.memo-list-delete-button {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 180px;
    border-width: 0;
    border-radius: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    background-color: rgb(236, 60, 85);
    justify-content: center;
    align-items: center;
}

.memo-list-delete-icon {
    width: 62px;
