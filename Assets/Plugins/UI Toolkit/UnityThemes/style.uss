:root {
    --nav-bg: rgb(30, 30, 34);
    --nav-icon-inactive: rgb(243, 243, 244);
    --nav-icon-active: rgb(255, 53, 87);
}

.unity-label {
    padding: 0;
    margin: 0;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
}

.unity-button {
    background-color: transparent;
    border-color: transparent;
    border-width: 0;
    padding: 0;
    margin: 0;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Regular.ttf?fileID=12800000&guid=c19593ccf51a3b643a58d19da7851c10&type=3#Pretendard-Regular");
}

.main-root {
    flex-grow: 1;
    position: relative;
    background-color: rgb(16, 16, 18);
}

.content-host {
    flex-grow: 1;
    padding-right: 50px;
    padding-left: 50px;
    padding-top: 150px;
}

.tab-page {
    flex-grow: 1;
    display: none;
}

.tab-page.is-visible {
    display: flex;
}

.home-header {
    flex-grow: 0;
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 70px;
}

.home-greeting {
    font-size: 70px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
}

.home-alert-button {
    width: 65px;
    height: 65px;
    background-image: url("project://database/Assets/00_MemoAnchor/03_Media/Icon/alert.png?fileID=2800000&guid=a8ce16252c0ae1d46840a9dfaf22b609&type=3#alert");
    -unity-background-image-tint-color: rgb(0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

.memo-section {
    flex-grow: 1;
    width: auto;
    min-width: 0;
    align-self: stretch;
    position: relative;
    margin-left: -50px;
    margin-right: -50px;
    background-color: rgb(231, 231, 231);
    padding-top: 50px;
}

.memo-section-bg {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(246, 246, 246);
}

.memo-section-content {
    flex-grow: 1;
}

.memo-section-header {
    flex-grow: 0;
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 30px;
    padding-right: 50px;
    padding-left: 50px;
}

.memo-section-title {
    font-size: 55px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
}

.memo-section-more {
    font-size: 30px;
    color: rgb(126, 126, 126);
}

.memo-scroll {
    flex-grow: 1;
    height: 560px;
}

.memo-scroll-content {
    flex-direction: row;
    padding-left: 50px;
    padding-right: 40px;
}

.memo-card {
    width: 760px;
    min-width: 760px;
    height: 500px;
    background-color: rgb(255, 255, 255);
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-left-radius: 30px;
    border-bottom-right-radius: 30px;
    padding: 28px;
    margin-right: 40px;
    padding-top: 40px;
    padding-right: 40px;
    padding-bottom: 40px;
    padding-left: 40px;
}

.memo-title {
    font-size: 42px;
    -unity-font-definition: url("project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Medium.ttf?fileID=12800000&guid=45ed9c45b09f5f2498d91e1982ab7527&type=3#Pretendard-Medium");
    margin-bottom: 14px;
}

.memo-divider {
    height: 2px;
    background-color: rgb(207, 207, 207);
    margin-bottom: 18px;
}

.memo-check-row {
    height: 66px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgb(239, 239, 239);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    padding-left: 18px;
    padding-right: 18px;
    margin-bottom: 12px;
}

.memo-check-text {
    font-size: 31px;
    color: rgb(44, 44, 44);
}

.memo-checkbox {
    width: 34px;
    height: 34px;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-color: rgb(160, 160, 160);
    border-right-color: rgb(160, 160, 160);
    border-bottom-color: rgb(160, 160, 160);
    border-left-color: rgb(160, 160, 160);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.memo-checkbox-checked {
    background-color: rgb(217, 217, 217);
}

.memo-footer {
    flex-grow: 1;
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
}

.memo-footer-text {
    font-size: 27px;
    color: rgb(135, 135, 135);
}

.memo-footer-date {
    margin-left: auto;
}

.bottom-nav-wrapper {
    position: absolute;
    left: 60px;
    right: 60px;
    bottom: 60px;
    height: 200px;
    align-items: center;
    justify-content: center;
}

.bottom-nav {
    width: 100%;
    height: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    background-color: var(--nav-bg);
    border-radius: 76px;
    padding-left: 16px;
    padding-right: 16px;
    border-top-left-radius: 110px;
    border-top-right-radius: 110px;
    border-bottom-right-radius: 110px;
    border-bottom-left-radius: 110px;
}

.nav-item {
    width: 104px;
    height: 104px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-radius: 52px;
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: center;
    -unity-font-style: normal;
    color: rgba(0, 0, 0, 0);
    transition-duration: 0.3s;
}

.nav-item:hover {
    background-color: rgba(255, 255, 255, 0.08);
    transition-duration: 0.3s;
}

.nav-item:active {
    background-color: rgba(255, 255, 255, 0.14);
    transition-duration: 0.3s;
}

.nav-icon {
    width: 55px;
    height: 55px;
    background-position: center;
    background-repeat: no-repeat;
    background-size: contain;
    -unity-background-image-tint-color: var(--nav-icon-inactive);
}

.nav-item.is-active .nav-icon {
    -unity-background-image-tint-color: var(--nav-icon-active);
    transition-duration: 0.3s;
}

.fade-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 1;
}
