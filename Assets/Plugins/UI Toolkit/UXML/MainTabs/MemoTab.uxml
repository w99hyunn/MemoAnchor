<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="MemoListItem" src="project://database/Assets/Plugins/UI%20Toolkit/UXML/DynamicItems/MemoListItem.uxml?fileID=9197481963319205126&amp;guid=fd34d1f1c1b6ecd4287e00e18419777e&amp;type=3#MemoListItem"/>
    <Style src="project://database/Assets/Plugins/UI%20Toolkit/UnityThemes/style.uss?fileID=7433441132597879392&amp;guid=c3edbd9c191f92b49aa6a3ce9ffd69d5&amp;type=3#style"/>
    <ui:VisualElement name="tab-menu" class="tab-page tab-page-layout memo-tab-mode-page">
        <ui:VisualElement class="home-header tab-fixed-header memo-header" style="align-items: center;">
            <ui:VisualElement class="memo-mode-title-row">
                <ui:Label text="메모 모음 목록" class="home-greeting memo-mode-title"/>
                <ui:Button text="" name="memo-mode-toggle" class="home-mode-toggle is-work-mode">
                    <ui:VisualElement class="home-mode-toggle-thumb"/>
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="memo-header-actions" class="memo-header-actions">
                <ui:Button text="" class="home-right-icon-button" style="background-image: url(&quot;project://database/Assets/00_MemoAnchor/03_Media/Icon/trash.png?fileID=2800000&amp;guid=c2fd465122bc15242b8cf6da00d7bbb1&amp;type=3#trash&quot;);"/>
                <ui:Button text="" name="memo-filter-button" class="home-right-icon-button memo-filter-round-icon-button memo-filter-icon-button">
                    <ui:VisualElement class="memo-filter-round-icon memo-filter-icon" style="background-image: url(&quot;project://database/Assets/00_MemoAnchor/03_Media/Icon/filter.png?fileID=2800000&amp;guid=e72bd049f96e09a46a5f4816cd8c55cc&amp;type=3#filter&quot;);"/>
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="memo-section" style="flex-grow: 0; padding-top: 25px; padding-bottom: 25px; background-color: rgba(30, 30, 34, 0); margin-bottom: 30px;">
            <ui:VisualElement class="memo-section-content" style="flex-grow: 0; padding-right: 50px; padding-left: 50px;">
                <ui:TextField name="memo-search-input" label="" placeholder-text="메모 검색..." class="memo-search-input" style="align-items: center; -unity-font-definition: url(&quot;project://database/Assets/Plugins/UI%20Toolkit/Fonts/Pretendard-Light.ttf?fileID=12800000&amp;guid=8c634880071f83d4da7be3c9ff6f0be8&amp;type=3#Pretendard-Light&quot;);">
                    <ui:VisualElement style="flex-grow: 1; position: absolute; width: 50px; height: 50px; background-image: url(&quot;project://database/Assets/00_MemoAnchor/03_Media/Icon/search.png?fileID=2800000&amp;guid=273a16649170cad4087f1c15c86ae7ea&amp;type=3#search&quot;); margin-left: 50px; -unity-background-image-tint-color: rgb(28, 28, 28);"/>
                </ui:TextField>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:ScrollView name="memo-content-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" touch-scroll-type="Elastic" class="tab-content-scroll" style="background-color: rgb(255, 255, 255); border-top-left-radius: 100px; border-top-right-radius: 100px; overflow: hidden;">
            <ui:VisualElement class="tab-content-inner">
                <ui:VisualElement class="memo-list-container">
                    <ui:Instance template="MemoListItem"/>
                    <ui:Instance template="MemoListItem"/>
                    <ui:Instance template="MemoListItem"/>
                    <ui:Instance template="MemoListItem"/>
                    <ui:Instance template="MemoListItem"/>
                    <ui:Instance template="MemoListItem"/>
                    <ui:Instance template="MemoListItem"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
        <ui:VisualElement name="memo-filter-page" class="memo-filter-page is-hidden">
                <ui:VisualElement class="memo-filter-header">
                    <ui:Button name="memo-filter-back-button" text="" class="memo-filter-round-icon-button memo-filter-back-button">
                        <ui:VisualElement class="memo-filter-round-icon memo-filter-back-icon" style="background-image: url(&quot;project://database/Assets/00_MemoAnchor/03_Media/Icon/chevron_forward.png?fileID=2800000&amp;guid=3ca432206e7cabb45abd1dfc722e509d&amp;type=3#chevron_forward&quot;);"/>
                    </ui:Button>
                    <ui:Label text="메모 필터" class="page-header-title"/>
                </ui:VisualElement>
                <ui:ScrollView name="memo-filter-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" touch-scroll-type="Elastic" class="memo-filter-scroll">
                    <ui:VisualElement class="memo-filter-section">
                        <ui:Label text="기간" class="memo-filter-section-title"/>
                        <ui:VisualElement class="memo-filter-date-row">
                            <ui:Button name="memo-filter-start-date-button" class="memo-filter-date-button">
                                <ui:Label name="memo-filter-start-date-label" text="" class="memo-filter-date-text"/>
                                <ui:VisualElement class="memo-filter-calendar-icon"/>
                            </ui:Button>
                            <ui:Label text="-" class="memo-filter-date-dash"/>
                            <ui:Button name="memo-filter-end-date-button" class="memo-filter-date-button">
                                <ui:Label name="memo-filter-end-date-label" text="" class="memo-filter-date-text"/>
                                <ui:VisualElement class="memo-filter-calendar-icon"/>
                            </ui:Button>
                            <ui:Button name="memo-filter-date-toggle" class="memo-filter-check-button">
                                <ui:VisualElement class="memo-filter-check-icon"/>
                            </ui:Button>
                        </ui:VisualElement>
                        <ui:VisualElement name="memo-filter-calendar" class="memo-filter-calendar">
                            <ui:VisualElement class="memo-filter-calendar-header">
                                <ui:Button name="memo-filter-calendar-prev" text="&lt;" class="memo-filter-calendar-nav"/>
                                <ui:Label name="memo-filter-calendar-title" text="" class="memo-filter-calendar-title"/>
                                <ui:Button name="memo-filter-calendar-next" text="&gt;" class="memo-filter-calendar-nav"/>
                                <ui:Button name="memo-filter-calendar-close" text="닫기" class="memo-filter-calendar-close"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="memo-filter-calendar-grid" class="memo-filter-calendar-grid"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="memo-filter-divider"/>
                    <ui:VisualElement class="memo-filter-section">
                        <ui:Label text="정렬" class="memo-filter-section-title"/>
                        <ui:VisualElement class="memo-filter-chip-grid">
                            <ui:Button name="memo-filter-sort-latest" text="최신순" class="memo-filter-chip is-selected"/>
                            <ui:Button name="memo-filter-sort-deadline" text="미처리 우선순" class="memo-filter-chip"/>
                            <ui:Button name="memo-filter-sort-address" text="건물 주소순" class="memo-filter-chip"/>
                            <ui:Button name="memo-filter-sort-deadline-date" text="마감 임박순" class="memo-filter-chip"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="memo-filter-divider"/>
                    <ui:VisualElement class="memo-filter-section">
                        <ui:Label text="맵 필터" class="memo-filter-section-title"/>
                        <ui:Button name="memo-filter-map-button" class="memo-filter-select-button">
                            <ui:Label name="memo-filter-map-label" text="건물 선택하기" class="memo-filter-select-text"/>
                            <ui:Label text="›" class="memo-filter-select-chevron"/>
                        </ui:Button>
                        <ui:VisualElement name="memo-filter-map-list" class="memo-filter-map-list">
                            <ui:Button name="memo-filter-map-1" text="" class="memo-filter-map-item"/>
                            <ui:Button name="memo-filter-map-2" text="" class="memo-filter-map-item"/>
                            <ui:Button name="memo-filter-map-3" text="" class="memo-filter-map-item"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="memo-filter-divider"/>
                    <ui:VisualElement class="memo-filter-section">
                        <ui:Label text="긴급 여부" class="memo-filter-section-title"/>
                        <ui:VisualElement class="memo-filter-urgency-row">
                            <ui:Button name="memo-filter-urgency-high" text="상" class="memo-filter-urgency-chip"/>
                            <ui:Button name="memo-filter-urgency-medium" text="중" class="memo-filter-urgency-chip is-selected"/>
                            <ui:Button name="memo-filter-urgency-low" text="하" class="memo-filter-urgency-chip"/>
                            <ui:Button name="memo-filter-urgency-toggle" class="memo-filter-check-button is-selected">
                                <ui:VisualElement class="memo-filter-check-icon"/>
                            </ui:Button>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="memo-search-page" class="memo-filter-page memo-search-page is-hidden">
                <ui:VisualElement class="memo-filter-header memo-search-header">
                    <ui:Button name="memo-search-back-button" text="" class="memo-filter-round-icon-button memo-filter-back-button">
                        <ui:VisualElement class="memo-filter-round-icon memo-filter-back-icon" style="background-image: url(&quot;project://database/Assets/00_MemoAnchor/03_Media/Icon/chevron_forward.png?fileID=2800000&amp;guid=3ca432206e7cabb45abd1dfc722e509d&amp;type=3#chevron_forward&quot;);"/>
                    </ui:Button>
                    <ui:VisualElement class="scan-input-box memo-search-input-box">
                        <ui:TextField name="memo-search-page-input" label="" placeholder-text="메모 검색" class="scan-input-field"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="memo-search-history-section" class="memo-filter-section memo-search-history-section">
                    <ui:Label text="최근 검색" class="memo-filter-section-title"/>
                    <ui:VisualElement name="memo-search-history-list" class="memo-search-history-list"/>
                    <ui:Label name="memo-search-empty-label" text="최근 검색 결과가 없습니다." class="memo-search-empty-label is-hidden"/>
                </ui:VisualElement>
                <ui:ScrollView name="memo-search-result-section" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" touch-scroll-type="Elastic" class="memo-search-result-section is-hidden">
                    <ui:VisualElement name="memo-search-result-list" class="memo-search-result-list"/>
                    <ui:Label name="memo-search-no-result-label" text="검색 결과가 없습니다." class="memo-search-empty-label memo-search-no-result-label is-hidden"/>
                </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
