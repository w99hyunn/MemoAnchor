<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:ma="MemoAnchor.UI" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="MemoPlacementHud" src="project://database/Assets/Plugins/UI%20Toolkit/UXML/MemoPlacementHud.uxml?fileID=9197481963319205126&amp;guid=9c94f1d3a0b04c2eab9a88d6657c8b12&amp;type=3#MemoPlacementHud"/>
    <Style src="project://database/Assets/Plugins/UI%20Toolkit/UnityThemes/style.uss?fileID=7433441132597879392&amp;guid=c3edbd9c191f92b49aa6a3ce9ffd69d5&amp;type=3#style"/>
    <ui:VisualElement name="scan-hud-root" picking-mode="Ignore" class="scan-hud-root">
        <ui:VisualElement name="scan-viewfinder-layer" picking-mode="Ignore" class="scan-viewfinder-layer">
            <ma:ScanOutsideBlurElement name="scan-outside-blur" target-element-name="scan-frame" blur-opacity="0.98" blur-brightness="0.52" inner-corner-radius="28" corner-segments="16" picking-mode="Ignore" class="scan-outside-blur"/>
            <ui:VisualElement name="scan-frame-glow" picking-mode="Ignore" class="scan-frame-glow is-hidden"/>
            <ui:VisualElement name="scan-frame" picking-mode="Ignore" class="scan-frame"/>
        </ui:VisualElement>
        <ma:ScreenSpaceBlurElement name="scan-processing-blur" blur-opacity="0.99" blur-brightness="0.46" corner-segments="1" picking-mode="Ignore" class="scan-completion-background-blur is-hidden"/>
        <ui:Instance template="MemoPlacementHud" picking-mode="Ignore" class="memo-placement-template"/>
        <ui:VisualElement picking-mode="Ignore" class="page-overlay scan-hud-chrome">
            <ui:VisualElement picking-mode="Ignore" class="page-header">
                <ui:Button name="scan-back-button" class="page-back-button common-icon-button">
                    <ui:VisualElement picking-mode="Ignore" class="common-icon-button-icon scan-hud-back-icon" style="background-image: url(&quot;project://database/Assets/00_MemoAnchor/03_Media/Icon/chevron_white.png?fileID=2800000&amp;guid=b06b86c95997e714c93897fe87667c33&amp;type=3#chevron_white&quot;);"/>
                </ui:Button>
                <ui:VisualElement name="scan-progress-pill" picking-mode="Ignore" class="scan-progress-pill">
                    <ma:ScreenSpaceBlurElement blur-opacity="0.94" blur-brightness="0.92" corner-segments="12" picking-mode="Ignore" class="scan-progress-blur"/>
                    <ui:Label name="scan-progress-label" text="0% / 완료 가능 78%" picking-mode="Ignore" class="scan-progress-label"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button name="scan-start-button" class="scan-hud-action-button scan-hud-start-button">
            <ma:ScreenSpaceBlurElement blur-opacity="0.96" blur-brightness="0.58" corner-segments="16" picking-mode="Ignore" class="scan-button-blur-ring"/>
            <ui:VisualElement picking-mode="Ignore" class="scan-start-button-inner"/>
            <ui:VisualElement picking-mode="Ignore" class="common-icon-button-icon scan-action-icon scan-start-icon" style="background-image: url(&quot;project://database/Assets/00_MemoAnchor/03_Media/Icon/scan.png?fileID=2800000&amp;guid=ea32a5cc2c56260458012ba9f4ed5518&amp;type=3#scan&quot;);"/>
        </ui:Button>
        <ui:Button name="scan-stop-button" class="scan-hud-action-button scan-hud-stop-button is-hidden">
            <ma:ScreenSpaceBlurElement blur-opacity="0.96" blur-brightness="0.58" corner-segments="16" picking-mode="Ignore" class="scan-button-blur-ring"/>
            <ui:VisualElement picking-mode="Ignore" class="common-icon-button-icon scan-action-icon scan-stop-icon" style="background-image: url(&quot;project://database/Assets/00_MemoAnchor/03_Media/Icon/scan_stop.png?fileID=2800000&amp;guid=9cf00edf34765844d9a6e5654dbc86ec&amp;type=3#scan_stop&quot;);"/>
        </ui:Button>
        <ui:Label name="scan-processing-title-label" text="맵을 생성중입니다. 잠시만 기다려주세요." picking-mode="Ignore" class="scan-field-label scan-hud-status scan-processing-title is-hidden"/>
        <ui:Label name="scan-status-label" text="스캔을 시작하려면 버튼을 누르십시오." picking-mode="Ignore" class="scan-field-label scan-hud-status is-ready"/>
        <ui:VisualElement name="scan-completion-layer" picking-mode="Ignore" class="scan-completion-layer is-hidden">
            <ma:ScreenSpaceBlurElement blur-opacity="0.99" blur-brightness="0.46" corner-segments="1" picking-mode="Ignore" class="scan-completion-background-blur"/>
            <ui:Image name="scan-completion-map-image" picking-mode="Ignore" scale-mode="StretchToFill" class="scan-completion-map-image"/>
            <ui:VisualElement name="scan-completion-nav-wrapper" class="bottom-nav-wrapper is-scan-mode scan-completion-nav-wrapper">
                <ui:VisualElement class="bottom-nav is-scan-mode">
                    <ui:Button name="nav-scan" class="nav-item">
                        <ui:VisualElement picking-mode="Ignore" class="nav-press-bg"/>
                        <ui:VisualElement picking-mode="Ignore" class="nav-icon scan-completion-regenerate-icon" style="background-image: url(&quot;project://database/Assets/00_MemoAnchor/03_Media/Icon/re.png?fileID=2800000&amp;guid=1dc1282e661cdc343885fcf301f17b53&amp;type=3#re&quot;);"/>
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement class="scan-start-bg">
                    <ui:Button name="scan-save-button" text="저장하기" class="scan-nav-start"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
